package nativeselect

import "github.com/yash91989201/bachtel-email-automation/internal/web/ui/utils"

type Size string

const (
	SizeSm      Size = "sm"
	SizeDefault Size = "default"
)

// Props configure a native select. Bachtel keeps the browser control without
// an icon wrapper, preserving existing label nesting and form layout.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Size       Size
	Name       string
	Disabled   bool
	Required   bool
}

type OptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
	Selected   bool
}

type OptGroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Label      string
	Disabled   bool
}

templ NativeSelect(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	<select
		data-slot="native-select"
		data-size={ string(p.Size) }
		class={ utils.CN("cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed", p.Class) }
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		disabled?={ p.Disabled }
		required?={ p.Required }
		{ p.Attributes... }
	>
		{ children... }
	</select>
}

templ Option(props ...OptionProps) {
	{{ var p OptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<option
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="native-select-option"
		class={ p.Class }
		value={ p.Value }
		disabled?={ p.Disabled }
		selected?={ p.Selected }
		{ p.Attributes... }
	>
		{ children... }
	</option>
}

templ OptGroup(props ...OptGroupProps) {
	{{ var p OptGroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<optgroup
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="native-select-optgroup"
		class={ p.Class }
		if p.Label != "" {
			label={ p.Label }
		}
		disabled?={ p.Disabled }
		{ p.Attributes... }
	>
		{ children... }
	</optgroup>
}
