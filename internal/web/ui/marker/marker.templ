package marker

import "github.com/yash91989201/bachtel-email-automation/internal/web/ui/utils"

type Variant string

const (
	VariantDefault   Variant = "default"
	VariantSeparator Variant = "separator"
	VariantBorder    Variant = "border"
)

// Props are shadcn's Marker props; Href renders the marker as a link (the
// render prop with an a element).
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Href       string
}

type IconProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func variantClasses(v Variant) string {
	switch v {
	case VariantSeparator:
		return "before:h-px before:min-w-0 before:flex-1 before:bg-border after:h-px after:min-w-0 after:flex-1 after:bg-border before:mr-1 after:ml-1"
	case VariantBorder:
		return "border-b border-border pb-2"
	default:
		return ""
	}
}

// Variants is shadcn's markerVariants, for a marker rendered through an
// element of its own (the render prop with a button).
func Variants(p Props) string {
	return utils.CN("gap-2 text-sm text-muted-foreground [a]:hover:text-foreground [a]:underline-offset-3 [a]:underline [&_svg:not([class*='size-'])]:size-4 min-h-4 text-left group/marker relative flex w-full items-center", variantClasses(p.Variant), p.Class)
}

// Marker renders useRender's state as data-slot and data-variant.
templ Marker(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Href != "" {
		<a
			href={ templ.SafeURL(p.Href) }
			if p.ID != "" {
				id={ p.ID }
			}
			class={ Variants(p) }
			data-slot="marker"
			data-variant={ string(p.Variant) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ Variants(p) }
			data-slot="marker"
			data-variant={ string(p.Variant) }
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Icon(props ...IconProps) {
	{{ var p IconProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="marker-icon"
		aria-hidden="true"
		class={ utils.CN("size-4 [&_svg:not([class*='size-'])]:size-4 shrink-0", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="marker-content"
		class={ utils.CN("group-data-[variant=separator]/marker:flex-none group-data-[variant=separator]/marker:text-center *:[a]:hover:text-foreground *:[a]:underline *:[a]:underline-offset-3 min-w-0 wrap-break-word", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
