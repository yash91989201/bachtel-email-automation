package spinner

import (
	"maps"

	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/icon"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ Spinner(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{
			"data-slot":  "spinner",
			"role":       "status",
			"aria-label": "Loading",
		}
		if p.ID != "" {
			attrs["id"] = p.ID
		}
		maps.Copy(attrs, p.Attributes)
	}}
	@icon.LoaderCircle(icon.Props{
		Class:      utils.CN("size-4 animate-spin", p.Class),
		Attributes: attrs,
	})
}
