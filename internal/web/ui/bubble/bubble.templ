package bubble

import "github.com/yash91989201/bachtel-email-automation/internal/web/ui/utils"

type Variant string

const (
	VariantDefault     Variant = "default"
	VariantSecondary   Variant = "secondary"
	VariantMuted       Variant = "muted"
	VariantTinted      Variant = "tinted"
	VariantOutline     Variant = "outline"
	VariantGhost       Variant = "ghost"
	VariantDestructive Variant = "destructive"
)

type Align string

const (
	AlignStart Align = "start"
	AlignEnd   Align = "end"
)

type Side string

const (
	SideTop    Side = "top"
	SideBottom Side = "bottom"
)

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Align      Align
}

// ContentProps are shadcn's BubbleContent props; Href renders the content as
// a link (the render prop with an a element).
type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Href       string
}

type ReactionsProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Side       Side
	Align      Align
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-group"
		class={ utils.CN("gap-2 flex min-w-0 flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

func variantClasses(v Variant) string {
	switch v {
	case VariantSecondary:
		return "*:data-[slot=bubble-content]:bg-secondary *:data-[slot=bubble-content]:text-secondary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)]"
	case VariantMuted:
		return "*:data-[slot=bubble-content]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--muted),var(--foreground)_5%)]"
	case VariantTinted:
		return "*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.93_calc(c*0.4)_h)] dark:*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.3_calc(c*0.4)_h)] *:data-[slot=bubble-content]:text-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.88_calc(c*0.5)_h)] dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.35_calc(c*0.5)_h)]"
	case VariantOutline:
		return "*:data-[slot=bubble-content]:bg-background *:data-[slot=bubble-content]:border-border [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-input/30"
	case VariantGhost:
		return "*:data-[slot=bubble-content]:rounded-none *:data-[slot=bubble-content]:bg-transparent *:data-[slot=bubble-content]:p-0 [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted/50 border-none"
	case VariantDestructive:
		return "*:data-[slot=bubble-content]:bg-destructive/10 dark:*:data-[slot=bubble-content]:bg-destructive/20 *:data-[slot=bubble-content]:text-destructive [&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/20 dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/30"
	default:
		return "*:data-[slot=bubble-content]:bg-primary *:data-[slot=bubble-content]:text-primary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-primary/80"
	}
}

templ Bubble(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Align == "" {
		{{ p.Align = AlignStart }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble"
		data-variant={ string(p.Variant) }
		data-align={ string(p.Align) }
		class={ utils.CN("gap-1 data-[align=end]:self-end max-w-[80%] data-[variant=ghost]:max-w-full group-data-[align=end]/message:self-end group/bubble relative flex w-fit min-w-0 flex-col", variantClasses(p.Variant), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// ContentClass is BubbleContent's class, for content rendered through an
// element of its own (the render prop with a button).
func ContentClass(p ContentProps) string {
	return utils.CN("rounded-3xl border border-transparent px-3.5 py-2.5 text-sm leading-relaxed [button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 [button,a]:focus-visible:ring-ring/30 group-data-[align=end]/bubble:self-end w-fit max-w-full min-w-0 overflow-hidden wrap-break-word [button]:text-left [button,a]:transition-colors", p.Class)
}

// Content renders useRender's state as data-slot.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Href != "" {
		<a
			href={ templ.SafeURL(p.Href) }
			if p.ID != "" {
				id={ p.ID }
			}
			class={ ContentClass(p) }
			data-slot="bubble-content"
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ ContentClass(p) }
			data-slot="bubble-content"
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Reactions(props ...ReactionsProps) {
	{{ var p ReactionsProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Side == "" {
		{{ p.Side = SideBottom }}
	}
	if p.Align == "" {
		{{ p.Align = AlignEnd }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="bubble-reactions"
		data-align={ string(p.Align) }
		data-side={ string(p.Side) }
		class={ utils.CN(
			"rounded-full ring-3 ring-card bg-muted shrink-0 gap-1 px-1.5 py-0.5 has-[button]:p-0 text-sm absolute z-10 flex w-fit items-center justify-center",
			utils.IfElse(p.Side == SideTop, "top-0 -translate-y-3/4", "bottom-0 translate-y-3/4"),
			utils.IfElse(p.Align == AlignStart, "left-3", "right-3"),
			p.Class,
		) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
