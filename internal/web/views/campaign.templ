package views

import (
	"strconv"

	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/badge"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/input"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/label"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/table"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/textarea"
)

// CampaignListData is the safe view model for the campaign list. The
// converter message is a fixed operator-facing instruction, never a path.
type CampaignListData struct {
	Campaigns      []CampaignListRow
	ConverterError string
}

// CampaignListRow summarizes one campaign for the list page.
type CampaignListRow struct {
	ID            string
	Name          string
	SourceHeaders string
	Revision      int
	HasRevision   bool
	Approved      bool
}

templ CampaignList(data CampaignListData) {
	@Layout("Campaigns", true, "campaigns") {
		<div class="page-header">
			<div>
				<p class="eyebrow">Campaigns</p>
				<h1 class="text-4xl font-bold tracking-tight">Email campaigns</h1>
				<p class="page-description">Manage templates, recipient workbooks and submission history for each campaign.</p>
			</div><a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault}) } href="/campaigns/new">New campaign <span aria-hidden="true">+</span></a>
		</div>
		if data.ConverterError != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
				<div>
					<p class="font-semibold">Body document conversion is unavailable</p>
					<p>{ data.ConverterError }</p>
				</div>
			}
		}
		if len(data.Campaigns) == 0 {
			<section class="cn-card border border-border bg-card shadow-sm">
				@card.Content(card.ContentProps{}) {
					<h2 class="cn-card-title">No campaigns yet</h2>
					<p>Create a campaign to define its source headers, subject, body document and result labels.</p>
				}
			</section>
		} else {
			<div class="table-scroll">
				@table.Table(table.Props{Attributes: templ.Attributes{"aria-label": "Campaigns"}}) {
					<thead>
						<tr>
							<th class="min-w-64"><span class="sr-only">Name</span></th>
							<th>Source headers</th>
							<th class="min-w-36">Current revision</th>
							<th class="min-w-32">Approval</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range data.Campaigns {
							<tr>
								<td class="font-semibold"><a class="app-link text-primary" href={ "/campaigns/" + row.ID }>{ row.Name } <span aria-hidden="true">↗</span></a></td>
								<td><code>{ row.SourceHeaders }</code></td>
								<td>
									if row.HasRevision {
										Revision { row.Revision }
									} else {
										No revision yet
									}
								</td>
								<td>
									@revisionState(row.HasRevision, row.Approved)
								</td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
	}
}

// CampaignFormData is the view model for the campaign creation form. The
// error is a fixed validation message, never a raw storage failure.
type CampaignFormData struct {
	Error         string
	Name          string
	SourceHeaders string
	ResultLabels  string
}

templ CampaignForm(data CampaignFormData) {
	@Layout("New campaign", true, "campaigns") {
		<div class="page-header">
			<div>
				<p class="eyebrow">Campaigns</p>
				<h1 class="text-4xl font-bold tracking-tight">New campaign</h1>
				<p class="page-description">Start with a name and your Excel column headers. You’ll add the email template next.</p>
			</div>
		</div>
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
		}
		<form method="post" action="/campaigns" class="cn-card form-card">
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h2 class="cn-card-title">Campaign details</h2>
				<div class="space-y-2">
					@label.Label(label.Props{For: "campaign-name"}) {
						Campaign name
					}
					@input.Input(input.Props{ID: "campaign-name", Name: "name", Type: "text", Value: data.Name, Required: true, Attributes: templ.Attributes{"maxlength": "200"}})
				</div>
				<div class="space-y-2">
					@label.Label(label.Props{For: "campaign-headers"}) {
						Source headers for mapping draft
					}
					@input.Input(input.Props{ID: "campaign-headers", Name: "source_headers", Type: "text", Value: data.SourceHeaders, Required: true})
					<p class="text-sm text-muted-foreground">Example: <code>Candidate Name, Candidate Email, Department</code>. Use comma-separated source worksheet headers, including the candidate email column. These generate the draft mapping table; mark one row as recipient when creating a revision.</p>
				</div>
				<div class="space-y-2">
					@label.Label(label.Props{For: "campaign-labels"}) {
						Result column labels
					}
					@input.Input(input.Props{ID: "campaign-labels", Name: "result_labels", Type: "text", Value: data.ResultLabels})
					<p class="text-sm text-muted-foreground">Comma-separated labels for the downloadable result columns. The defaults are pre-filled; changing them later never invalidates content approval.</p>
				</div>
				<div class="app-card-actions">
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
						Create campaign
					}
					<a class={ button.Variants(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault}) } href="/campaigns">Cancel</a>
				</div>
			}
		</form>
	}
}

// CampaignPageData is the safe view model for one campaign page. It never
// carries uploaded documents or storage diagnostics.
type CampaignPageData struct {
	ID            string
	Name          string
	SourceHeaders string
	ResultLabels  string
	// MappingDraft pre-fills the revision form while the campaign has no
	// content revision. Once a revision exists the form starts empty.
	MappingDraft string
	// ExampleVariable and ExampleHeader are the mapping help's worked example:
	// the first name the draft derives from this campaign's source headers, so
	// the help never teaches a variable name the draft does not use.
	ExampleVariable string
	ExampleHeader   string

	HasRevision bool
	Revision    int
	Subject     string
	Converter   string
	ContentHash string
	Approved    bool
	Warnings    []string

	Variables []PreviewVariable

	RevisionError string
	LabelsError   string
	DeleteError   string

	History []RevisionRow

	// Generated download state: empty, generating, ready or failed.
	ReportState  string
	ReportError  string
	ReportAsOf   string
	ReportReady  bool
	PackageState string
	PackageError string
	PackageAsOf  string
	PackageReady bool

	Attempts []AttemptRow
}

// PreviewVariable is one sample input in the campaign preview form. Required
// inputs gate the render button until every one has a value; the server still
// rejects empty required values with an inline message.
type PreviewVariable struct {
	Name     string
	Required bool
}

// AttemptRow is one recorded attempt in the campaign history list. Test
// attempts are marked so they are never mistaken for candidate sends.
type AttemptRow struct {
	ID         string
	Kind       string
	Recipient  string
	Subject    string
	State      string
	Reason     string
	FinishedAt string
	Test       bool
}

// RevisionRow is one immutable revision-history entry.
type RevisionRow struct {
	Revision    int
	ContentHash string
	Approved    bool
}

templ CampaignPage(data CampaignPageData) {
	@Layout(data.Name, true, "campaigns") {
		<div class="page-header">
			<div><a class="app-link text-sm text-muted-foreground" href="/campaigns">← All campaigns</a><p class="eyebrow mt-4">Campaign workspace</p><h1>{ data.Name }</h1><p class="page-description">Prepare your email content, then open email tasks to upload recipients, test and send.</p></div>
		</div>
		if data.RevisionError != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.RevisionError }
			}
		}
		if data.LabelsError != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.LabelsError }
			}
		}
		if data.DeleteError != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.DeleteError }
			}
		}
		if len(data.Warnings) > 0 {
			@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
				<div>
					<p class="font-semibold">The last conversion dropped unsupported content:</p>
					<ul class="list-inside list-disc">
						for _, warning := range data.Warnings {
							<li>{ warning }</li>
						}
					</ul>
				</div>
			}
		}
		<div class="campaign-workspace" x-data={ "{ tab: '" + campaignInitialTab(data) + "' }" } data-has-error={ strconv.FormatBool(data.RevisionError != "" || data.LabelsError != "" || data.DeleteError != "") } data-has-preview={ strconv.FormatBool(data.HasRevision) } x-init="if ($el.dataset.hasError !== 'true') { const selected = location.hash.slice(1); if (['template', 'preview', 'history', 'settings'].includes(selected) && (selected !== 'preview' || $el.dataset.hasPreview === 'true')) tab = selected; }">
			<aside class="workspace-sidebar" aria-label="Campaign navigation">
				<a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault, Class: "workspace-task-link"}) } href={ "/campaigns/" + data.ID + "/tasks" }>Email tasks <span aria-hidden="true">→</span></a>
				<p class="workspace-nav-heading">Content & preparation</p>
				<div role="tablist" aria-label="Campaign sections" aria-orientation="vertical" x-on:keydown="if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes($event.key)) { $event.preventDefault(); const items = Array.from($el.querySelectorAll('[role=tab]')); const index = items.indexOf($event.target); const next = $event.key === 'Home' ? 0 : $event.key === 'End' ? items.length - 1 : (index + (['ArrowDown', 'ArrowRight'].includes($event.key) ? 1 : -1) + items.length) % items.length; items[next].focus(); items[next].click(); }">
					@workspaceSidebarTab("campaign", "template", "Template", "Subject, document & mappings", campaignInitialTab(data))
					if data.HasRevision {
						@workspaceSidebarTab("campaign", "preview", "Sample preview", "Check personalized content", campaignInitialTab(data))
					}
					<p class="workspace-nav-heading">Records & management</p>
					@workspaceSidebarTab("campaign", "history", "History & downloads", "Reports & recorded emails", campaignInitialTab(data))
					@workspaceSidebarTab("campaign", "settings", "Settings", "Result labels & deletion", campaignInitialTab(data))
				</div>
			</aside>
			<div class="workspace-content">
				@workspaceTabPanel("campaign", "template", campaignInitialTab(data)) {
					<details class="cn-card card-disclosure border border-border bg-card shadow-sm">
						<summary>
							<h2 id="revision-heading" class="cn-card-title">Current revision</h2>
						</summary>
						@card.Content(card.ContentProps{Class: "gap-4"}) {
							if data.HasRevision {
								<dl class="space-y-1 text-sm">
									<div class="flex gap-2">
										<dt class="font-semibold">Revision:</dt>
										<dd>{ data.Revision }</dd>
									</div>
									<div class="flex gap-2">
										<dt class="font-semibold">Subject:</dt>
										<dd>{ data.Subject }</dd>
									</div>
									<div class="flex gap-2">
										<dt class="font-semibold">Approval:</dt>
										<dd>
											@revisionState(true, data.Approved)
										</dd>
									</div>
								</dl>
								<details class="text-sm">
									<summary class="cursor-pointer text-muted-foreground">Conversion details</summary>
									<dl class="mt-3 space-y-2">
										<div class="flex gap-2">
											<dt class="font-semibold">Converter:</dt>
											<dd>{ data.Converter }</dd>
										</div>
										<div class="flex gap-2">
											<dt class="font-semibold">Content hash:</dt>
											<dd><code class="break-all">{ data.ContentHash }</code></dd>
										</div>
									</dl>
								</details>
							} else {
								<p class="text-muted-foreground">No content revision yet. Upload a body document below to create the first one.</p>
							}
						}
					</details>
					<details class="cn-card card-disclosure border border-border bg-card shadow-sm">
						<summary>
							<h2 id="mapping-reference-heading" class="cn-card-title">Mapping reference</h2>
						</summary>
						@card.Content(card.ContentProps{Class: "gap-4 text-sm"}) {
							<p class="text-muted-foreground">Revisions are immutable: a valid upload becomes the current revision, and the history is never edited.</p>
							<div class="rounded-card border border-border bg-muted/50 p-4">
								<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Source headers for mapping draft</p>
								<code class="wrap-break-words">{ data.SourceHeaders }</code>
							</div>
							<div class="overflow-x-auto rounded-card border border-border">
								@table.Table(table.Props{Class: "cn-table-compact"}) {
									<caption class="p-3 text-left font-medium">Column order <span class="font-normal text-muted-foreground">— separate each column with <code>|</code></span></caption>
									<thead class="bg-muted/50"><tr><th>Column</th><th>What to enter</th></tr></thead>
									<tbody>
										<tr><td>1 · Variable</td><td><code>{ data.ExampleVariable }</code></td></tr>
										<tr><td>2 · Source header</td><td><code>{ data.ExampleHeader }</code></td></tr>
										<tr><td>3 · Role</td><td><code>required</code>, <code>optional</code> or <code>recipient</code></td></tr>
										<tr><td>4 · Format</td><td><code>text</code>, <code>name</code>, <code>designation</code> or <code>email</code></td></tr>
										<tr><td>5 · Fallback</td><td>Optional rows only; leave blank otherwise.</td></tr>
									</tbody>
								}
							</div>
							<div class="flex flex-wrap items-center gap-2 text-muted-foreground">
								<span>Formats:</span>
								<code class="cn-badge cn-badge-variant-ghost">text</code>
								<code class="cn-badge cn-badge-variant-ghost">name</code>
								<code class="cn-badge cn-badge-variant-ghost">designation</code>
								<code class="cn-badge cn-badge-variant-ghost">email</code>
								<span class="text-xs">Defaults to text, or email for recipient rows. Fallback is only for optional rows.</span>
							</div>
							<div class="rounded-card border border-primary/20 bg-primary/5 p-4">
								<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary">Example line</p>
								<code class="wrap-break-words">{ data.ExampleVariable + " | " + data.ExampleHeader + " | required | text" }</code>
							</div>
						}
					</details>
					<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="upload-heading">
						@card.Content(card.ContentProps{Class: "gap-4"}) {
							<h2 id="upload-heading" class="cn-card-title">Create a new content revision</h2>
							<p class="text-sm text-muted-foreground">Upload the body document, its subject and the recipient mapping. A valid upload becomes the current revision.</p>
							<form method="post" action={ "/campaigns/" + data.ID + "/revisions" } enctype="multipart/form-data" class="space-y-4">
								<div class="space-y-2">
									<p class="eyebrow">Step 1 · Email content</p>
									<div class="space-y-2">
										<div class="space-y-2">
											<div class="field-hint-row">
												@label.Label(label.Props{For: "revision-subject"}) {
													Subject
												}
												@hintTrigger("revision-subject-help", "Subject help") {
													The subject line of the email. It may use the same placeholders as the document, for example <code>{ "{{" + data.ExampleVariable + "}}" }</code>.
												}
											</div>
											@input.Input(input.Props{ID: "revision-subject", Name: "subject", Type: "text", Required: true, Attributes: templ.Attributes{"maxlength": "998", "aria-describedby": "revision-subject-help"}})
										</div>
										<div class="space-y-2">
											<div class="field-hint-row">
												@label.Label(label.Props{For: "revision-document"}) {
													Body document (DOCX)
												}
												@hintTrigger("revision-document-help", "Body document help") {
													The Word document that becomes the email body. Put placeholders in it wherever a value should appear, for example <code>{ "{{" + data.ExampleVariable + "}}" }</code>, and use the same names in your mapping.
												}
											</div>
											@input.Input(input.Props{ID: "revision-document", Name: "document", Type: "file", Accept: ".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document", Required: true, Attributes: templ.Attributes{"aria-describedby": "revision-document-help"}})
										</div>
									</div>
								</div>
								<div class="space-y-2">
									<p class="eyebrow">Step 2 · Recipient mapping</p>
									<p class="text-sm text-muted-foreground">Place <code>{ "{{" + data.ExampleVariable + "}}" }</code> in the subject or Word document wherever its value should appear. Use the same variable name in your mapping below.</p>
									<div class="space-y-2">
										<div class="field-hint-row">
											@label.Label(label.Props{For: "revision-mappings"}) {
												Mapping table
											}
											@hintTrigger("revision-mappings-help", "Mapping table help") {
												Enter your mappings one per line: <code>variable | source header | role | format | fallback</code>.
												<br/>
												Mark exactly one row as <code>recipient</code> to select the sending address, for example <code>candidate_email | Candidate Email | recipient | email</code>.
												<br/>
												The recipient needs no placeholder. Every other row must match the placeholders in the subject or body.
											}
										</div>
										@textarea.Textarea(textarea.Props{ID: "revision-mappings", Name: "mappings", Rows: 8, Class: "min-h-64 font-mono", Attributes: templ.Attributes{"aria-describedby": "revision-mappings-hint revision-mappings-help"}, Value: data.MappingDraft})
										<p id="revision-mappings-hint" class="text-sm text-muted-foreground">One row per line. Mark exactly one row as <code>recipient</code> to select the sending address.</p>
									</div>
								</div>
								<div class="app-card-actions">
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
										Create revision
									}
								</div>
							</form>
						}
					</section>
				}
				if data.HasRevision {
					@workspaceTabPanel("campaign", "preview", campaignInitialTab(data)) {
						if data.HasRevision {
							<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="preview-heading">
								@card.Content(card.ContentProps{Class: "gap-4"}) {
									<h2 id="preview-heading" class="cn-card-title">Sample preview</h2>
									<p>Fill one sample value per variable to render the email exactly as a candidate row would. Nothing is sent and nothing is stored.</p>
									{{ hasRequired := previewHasRequired(data.Variables) }}
									<form
										method="post"
										action={ "/campaigns/" + data.ID + "/preview" }
										hx-post={ "/campaigns/" + data.ID + "/preview" }
										hx-target="#preview-result"
										hx-swap="innerHTML"
										hx-disabled-elt="this"
										class="space-y-4"
										x-data={ previewReadyState }
										x-init="sync()"
										x-on:input="sync()"
									>
										<div class="field-grid">
											for _, variable := range data.Variables {
												<div class="space-y-2">
													{{ sampleLabel := "Sample value for " + variable.Name }}
													if variable.Required {
														{{ sampleLabel += " (required)" }}
													}
													@label.Label(label.Props{For: "sample-" + variable.Name}) {
														{ sampleLabel }
													}
													@input.Input(input.Props{ID: "sample-" + variable.Name, Name: variable.Name, Type: "text", Required: variable.Required})
												</div>
											}
										</div>
										<div class="app-card-actions">
											if hasRequired {
												<p class="text-muted-foreground" x-show="!ready">Fill every required sample value to render the preview.</p>
											}
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault, Disabled: hasRequired, Attributes: templ.Attributes{"x-bind:disabled": "!ready"}}) {
												Render preview
											}
										</div>
									</form>
								}
							</section>
							<div id="preview-result" role="status" aria-live="polite"></div>
						}
					}
				}
				@workspaceTabPanel("campaign", "history", campaignInitialTab(data)) {
					<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="exports-heading">
						@card.Content(card.ContentProps{Class: "gap-4"}) {
							<h2 id="exports-heading" class="cn-card-title">History and downloads</h2>
							<p>Download a candidate summary and complete attempt history. Each export records its as-of time. Generating downloads never sends or retries email, and tests stay separate from candidate totals.</p>
							<form method="post" action={ "/campaigns/" + data.ID + "/exports#history" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
									Generate or refresh downloads
								}
							</form>
							<div class="grid gap-4 md:grid-cols-2">
								<div class="rounded-card border border-border p-4">
									<h3 class="font-semibold">Campaign report (XLSX)</h3>
									<p class="text-sm text-muted-foreground">Candidate summary and a separate history of every attempt.</p>
									if data.ReportReady {
										<p class="text-sm text-muted-foreground">As of { data.ReportAsOf }</p>
										<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ "/campaigns/" + data.ID + "/exports/report.xlsx" }>Download report</a>
									} else if data.ReportState == "generating" {
										<p>Generating now. Reload this page shortly.</p>
									} else if data.ReportState == "failed" {
										if data.ReportError != "" {
											<p class="text-destructive">{ data.ReportError }</p>
										}
									} else {
										<p>Not generated yet.</p>
									}
								</div>
								<div class="rounded-card border border-border p-4">
									<h3 class="font-semibold">Campaign package (ZIP)</h3>
									<p class="text-sm text-muted-foreground">The report, recorded HTML emails and a CSV index.</p>
									if data.PackageReady {
										<p class="text-sm text-muted-foreground">As of { data.PackageAsOf }</p>
										<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ "/campaigns/" + data.ID + "/exports/package.zip" }>Download package</a>
									} else if data.PackageState == "generating" {
										<p>Generating now. Reload this page shortly.</p>
									} else if data.PackageState == "failed" {
										if data.PackageError != "" {
											<p class="text-destructive">{ data.PackageError }</p>
										}
									} else {
										<p>Not generated yet.</p>
									}
								</div>
							</div>
							<form method="post" action={ "/campaigns/" + data.ID + "/exports/delete#history" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
									Remove generated downloads
								}
							</form>
							<p class="text-sm text-muted-foreground">Removing generated downloads deletes only those files. Campaign records, uploads, candidate eligibility and attempt history stay unchanged, and the downloads can be generated again.</p>
							<div class="overflow-x-auto">
								@table.Table(table.Props{Class: "cn-table-compact"}) {
									<caption class="p-2 text-left text-sm text-muted-foreground">Most recent 100 attempts. Every attempt keeps its own row, including retries and manual resolutions.</caption>
									<thead>
										<tr>
											<th>Attempt</th>
											<th>Kind</th>
											<th>Recipient</th>
											<th>State</th>
											<th>Finished</th>
											<th><span class="sr-only">Actions</span></th>
										</tr>
									</thead>
									<tbody>
										if len(data.Attempts) == 0 {
											<tr><td colspan="6">No attempts recorded yet.</td></tr>
										} else {
											for _, attempt := range data.Attempts {
												<tr>
													<td><code>{ attempt.ID }</code></td>
													<td>
														if attempt.Test {
															@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "status-warning"}) {
																{ "Test" }
															}
														} else {
															@badge.Badge(badge.Props{Variant: badge.VariantGhost, Class: "status-muted"}) {
																{ "Candidate" }
															}
														}
													</td>
													<td>{ attempt.Recipient }</td>
													<td>{ attempt.State }</td>
													<td>{ attempt.FinishedAt }</td>
													<td><a class="app-link text-primary" href={ "/campaigns/" + data.ID + "/attempts/" + attempt.ID + "/email.html" }>HTML</a></td>
												</tr>
											}
										}
									</tbody>
								}
							</div>
						}
					</section>
					<details class="disclosure">
						<summary id="history-heading">Revision history</summary>
						<div class="disclosure-body space-y-4">
							<p>Revisions are immutable. Older revisions stay for audit and have no edit controls.</p>
							if len(data.History) == 0 {
								<p class="text-muted-foreground">No revisions yet.</p>
							} else {
								<ol class="space-y-2">
									for _, entry := range data.History {
										<li class="flex flex-wrap items-center gap-2 text-sm">
											<span class="font-semibold">Revision { entry.Revision }</span>
											<code class="break-all">{ entry.ContentHash }</code>
											@revisionState(true, entry.Approved)
										</li>
									}
								</ol>
							}
						</div>
					</details>
				}
				@workspaceTabPanel("campaign", "settings", campaignInitialTab(data)) {
					<div id="campaign-settings" class="space-y-4">
						<h2 class="section-heading">Campaign settings</h2>
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="labels-heading">
							@card.Content(card.ContentProps{Class: "gap-4"}) {
								<h2 id="labels-heading" class="cn-card-title">Result column labels</h2>
								<form method="post" action={ "/campaigns/" + data.ID + "/labels#settings" } class="space-y-4">
									@label.Label(label.Props{For: "labels-input"}) {
										Labels
									}
									@input.Input(input.Props{ID: "labels-input", Name: "result_labels", Type: "text", Value: data.ResultLabels, Required: true})
									<p class="text-sm text-muted-foreground">Comma-separated labels for the downloadable result columns. Changing them never invalidates content approval.</p>
									<div class="app-card-actions">
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
											Save labels
										}
									</div>
								</form>
							}
						</section>
						<section class="cn-card danger-card border border-border bg-card shadow-sm" aria-labelledby="delete-heading">
							@card.Content(card.ContentProps{Class: "gap-4"}) {
								<h2 id="delete-heading" class="cn-card-title">Delete campaign & all history</h2>
								<p>Deleting this campaign removes its revisions and uploaded documents, tasks and retained workbooks, candidate identities, attempts, approvals, manual resolutions and generated downloads. Deleting it also removes its duplicate-prevention history, so a future campaign can send to the same recipients again. There is no automatic expiry: nothing is removed until you confirm here.</p>
								<p>Deleting live records never rewrites backups that already exist. Any backup retains its own copy until you remove that backup separately.</p>
								<p>Deletion is refused while a task is running or stopping, while a candidate is reserved or in flight, or while an attempt is queued or in flight.</p>
								<form method="post" action={ "/campaigns/" + data.ID + "/delete#settings" } class="flex flex-col gap-4" x-data={ "{ confirmed: false }" }>
									@label.Label(label.Props{Class: "cursor-pointer justify-start gap-3"}) {
										<input class="app-checkbox app-checkbox-error" type="checkbox" name="confirm" value="delete" x-model="confirmed"/>
										<span>I understand that this deletes the campaign's records, files and duplicate-prevention history.</span>
									}
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Size: button.SizeDefault, Class: "self-start", Attributes: templ.Attributes{"x-bind:disabled": "!confirmed"}}) {
										Delete campaign
									}
								</form>
							}
						</section>
					</div>
				}
			</div>
		</div>
	}
}

// Validation errors take priority over a previously selected tab.
func campaignInitialTab(data CampaignPageData) string {
	if data.LabelsError != "" || data.DeleteError != "" {
		return "settings"
	}
	return "template"
}

// previewReadyState is the Alpine scope of the sample preview form. sync keeps
// ready true only while every required sample input carries a value, which is
// what enables the render button. The gate is convenience: the server rejects
// missing required values on its own.
const previewReadyState = "{ ready: false, sync() { this.ready = Array.from(this.$el.querySelectorAll('input[required]')).every((input) => input.value.trim() !== '') } }"

// previewHasRequired reports whether any sample input is required. A fresh page
// load fills nothing, so a required variable means the render button has to
// start disabled rather than wait for Alpine to agree.
func previewHasRequired(variables []PreviewVariable) bool {
	for _, variable := range variables {
		if variable.Required {
			return true
		}
	}
	return false
}

// PreviewData is the view model for the sample preview partial. The error is
// a fixed campaign render message that names the offending variable; it is
// shown instead of a rendered email, never as a server error page.
type PreviewData struct {
	HasRevision bool
	Revision    int
	ContentHash string
	Approved    bool

	Error     string
	Recipient string
	Subject   string
	Body      string
	Values    []PreviewValue
}

// PreviewValue is one mapped sample value as it was submitted, next to the
// normalized replacement actually used.
type PreviewValue struct {
	Variable   string
	Header     string
	Raw        string
	Normalized string
}

templ PreviewResult(data PreviewData) {
	<div class="cn-card border border-border bg-card shadow-sm" x-data="{ open: true }" x-show="open">
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<div class="flex items-start justify-between gap-4">
				<h3 class="cn-card-title">Preview result</h3>
				@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"x-on:click": "open = false"}}) {
					Close
				}
			</div>
			if data.HasRevision {
				<dl class="space-y-1 text-sm">
					<div class="flex gap-2">
						<dt class="font-semibold">Revision:</dt>
						<dd>{ data.Revision }</dd>
					</div>
					<div class="flex gap-2">
						<dt class="font-semibold">Content hash:</dt>
						<dd><code class="break-all">{ data.ContentHash }</code></dd>
					</div>
					<div class="flex gap-2">
						<dt class="font-semibold">Approval:</dt>
						<dd>
							@revisionState(true, data.Approved)
						</dd>
					</div>
				</dl>
			}
			if data.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					{ data.Error }
				}
			} else {
				<div class="space-y-1">
					<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">To</p>
					<p class="font-semibold">{ data.Recipient }</p>
				</div>
				<div class="space-y-1">
					<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Subject</p>
					<p class="font-semibold">{ data.Subject }</p>
				</div>
				<div class="space-y-1">
					<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Body</p>
					<div class="email-body rounded-card border border-border p-4">
						@templ.Raw(data.Body)
					</div>
				</div>
				<div class="table-scroll">
					@table.Table(table.Props{Class: "cn-table-compact"}) {
						<thead>
							<tr>
								<th>Variable</th>
								<th>Source header</th>
								<th>Raw value</th>
								<th>Used value</th>
							</tr>
						</thead>
						<tbody>
							for _, value := range data.Values {
								<tr>
									<td>{ value.Variable }</td>
									<td><code>{ value.Header }</code></td>
									<td><code>{ value.Raw }</code></td>
									<td><code>{ value.Normalized }</code></td>
								</tr>
							}
						</tbody>
					}
				</div>
			}
		}
	</div>
}

// hintTrigger is the inline help affordance for a form field. The help text
// stays in the document and is linked with aria-describedby, so assistive
// technology announces it; the panel itself is revealed on hover and on
// keyboard focus, and its text stays selectable so it can be copied.
templ hintTrigger(id string, label string) {
	<span class="hint">
		<button class="hint-trigger" type="button" aria-describedby={ id }>
			<span aria-hidden="true">?</span>
			<span class="sr-only">{ label }</span>
		</button>
		<span class="hint-popover" id={ id } role="note">
			{ children... }
		</span>
	</span>
}

// revisionState is the shared approval badge: a missing revision is neither
// approved nor unapproved, an approval is bound to the shown content hash.
templ revisionState(hasRevision, approved bool) {
	if !hasRevision {
		@badge.Badge(badge.Props{Variant: badge.VariantGhost, Class: "status-muted"}) {
			{ "No revision" }
		}
	} else if approved {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "status-success"}) {
			{ "Approved" }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "status-warning"}) {
			{ "Not approved" }
		}
	}
}
