package views

import (
	"strings"

	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/badge"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/input"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/label"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/nativeselect"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/table"
)

// TaskListData is the safe view model for a campaign's task list. It carries
// ids and fixed status text only, never storage detail.
type TaskListData struct {
	CampaignID   string
	CampaignName string
	Tasks        []TaskListRow
}

// TaskListRow summarizes one task for the list page.
type TaskListRow struct {
	ID        string
	Status    string
	Sheet     string
	HeaderRow int
	Total     int
	Eligible  int
}

templ TaskList(data TaskListData) {
	@Layout("Tasks", true, "campaigns") {
		<header class="page-header">
			<div>
				<p class="eyebrow">Tasks</p>
				<h1>Email tasks</h1>
				<p class="page-description">Upload an Excel workbook, confirm its worksheet and header row, then review the validated snapshot for { data.CampaignName }. Nothing on this page sends email.</p>
			</div>
			<div class="action-bar">
				<a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks/new" }>Upload workbook</a>
				<a class={ button.Variants(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID }>Back to campaign</a>
			</div>
		</header>
		if len(data.Tasks) == 0 {
			<section class="cn-card border border-border bg-card shadow-sm">
				@card.Content(card.ContentProps{}) {
					<h2 class="cn-card-title">No tasks yet</h2>
					<p>Upload an XLSX workbook to create the first task for this campaign.</p>
				}
			</section>
		} else {
			<section class="cn-card border border-border bg-card shadow-sm" aria-label="Tasks">
				@card.Content(card.ContentProps{Class: "table-scroll"}) {
					@table.Table(table.Props{}) {
						<thead>
							<tr>
								<th>Status</th>
								<th>Worksheet</th>
								<th>Header row</th>
								<th>Total rows</th>
								<th>Eligible rows</th>
								<th><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, row := range data.Tasks {
								<tr>
									<td>
										@taskStatusBadge(row.Status)
									</td>
									<td><code>{ row.Sheet }</code></td>
									<td>{ row.HeaderRow }</td>
									<td>{ row.Total }</td>
									<td>{ row.Eligible }</td>
									<td><a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + row.ID }>Review task</a></td>
								</tr>
							}
						</tbody>
					}
				}
			</section>
		}
	}
}

// TaskUploadData is the view model for the workbook upload page. The limits
// are the configured byte bounds, rendered as literal numbers so the operator
// sees exactly what the server enforces.
type TaskUploadData struct {
	CampaignID        string
	CampaignName      string
	Error             string
	MaxUploadBytes    int64
	UnzipSizeLimit    int64
	UnzipXMLSizeLimit int64
}

templ TaskUpload(data TaskUploadData) {
	@Layout("New task", true, "campaigns") {
		<header class="page-header">
			<div>
				<p class="eyebrow">Step 1 · Upload</p>
				<h1>Upload a task workbook</h1>
				<p class="page-description">Uploading stores the workbook as a staging task for { data.CampaignName }. Next, confirm the worksheet and header row before validation.</p>
			</div>
			<div class="action-bar">
				<a class={ button.Variants(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks" }>Back to task list</a>
			</div>
		</header>
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
		}
		<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks" } enctype="multipart/form-data" class="cn-card border border-border bg-card shadow-sm">
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h2 class="section-heading">Choose a workbook</h2>
				<p class="section-description">Select the XLSX file to create a staging task.</p>
				@label.Label(label.Props{For: "task-workbook"}) {
					Workbook (XLSX)
				}
				@input.Input(input.Props{ID: "task-workbook", Name: "workbook", Type: "file", Accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Required: true})
				<div class="app-card-actions">
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
						Upload workbook
					}
				</div>
			}
		</form>
		<section class="subtle-panel" aria-labelledby="constraints-heading">
			<div class="space-y-2">
				<h2 id="constraints-heading" class="section-heading">Workbook requirements</h2>
				<ul class="list-inside list-disc space-y-1 text-sm text-muted-foreground">
					<li>Format: <code>.xlsx</code> only, with no password and no legacy <code>.xls</code> file; password-protected and macro containers are rejected.</li>
					<li>Upload size limit: { data.MaxUploadBytes } bytes.</li>
					<li>Expanded workbook archive limit: { data.UnzipSizeLimit } bytes, and { data.UnzipXMLSizeLimit } bytes for a single expanded XML part.</li>
					<li>Support bound of 1,000 rows carrying data per task; split larger lists across several tasks.</li>
					<li>Header labels are matched after trimming surrounding whitespace, are case sensitive, and each required label must appear exactly once in the chosen header row.</li>
					<li>A formula cell is read as its cached value; the workbook's formulas are never evaluated.</li>
					<li>Duplicate recipient addresses are held for a corrected upload; every row of a duplicate group stays out of the snapshot.</li>
				</ul>
			</div>
		</section>
	}
}

// TaskPageData is the safe view model for one task page. A staging task uses
// the selection fields; a ready task uses the review fields. Error is a fixed
// inline message from a failed selection or revalidation, ValidationError is
// the failure recorded on the staging task itself.
type TaskPageData struct {
	CampaignID   string
	CampaignName string
	TaskID       string
	Status       string

	Error           string
	ValidationError string

	Sheets       []TaskSheetOption
	DefaultSheet string
	HeaderRow    int

	Counts       TaskCounts
	ResultLabels []string
	Revision     int
	ContentHash  string
	Approved     bool
	Stale        bool
	HeldRows     []TaskHeldRow
	Rows         []TaskAdmittedRow

	ScheduleAt    string
	ScheduleState string

	// ResultsState is the generated workbook state: empty, generating, ready
	// or failed. ResultsError carries the fixed retry message.
	ResultsState string
	ResultsError string
	ResultsAsOf  string
	ResultsReady bool
}

// TaskSheetOption is one stored worksheet of the uploaded workbook.
type TaskSheetOption struct {
	Name     string
	Visible  bool
	Selected bool
}

// TaskCounts mirrors the task validation counts in plain view fields.
type TaskCounts struct {
	Total            int
	Eligible         int
	Ineligible       int
	Duplicate        int
	Invalid          int
	AlreadySubmitted int
	AlreadyScheduled int
	ReviewRequired   int
}

// TaskHeldRow is one manifest row held back from candidate storage, with the
// fixed operator-facing reason text already resolved.
type TaskHeldRow struct {
	Row    int
	Reason string
}

// TaskAdmittedRow is one admitted snapshot row for the review tables.
type TaskAdmittedRow struct {
	ID     string
	Row    int
	State  string
	Reason string
}

templ TaskPage(data TaskPageData) {
	@Layout("Task", true, "campaigns") {
		<header class="page-header">
			<div>
				<p class="eyebrow">Task · { data.Status }</p>
				<h1>Task for { data.CampaignName }</h1>
				if data.Status == "staging" {
					<p class="page-description">Choose the worksheet and header row to validate your recipient workbook.</p>
				} else {
					<p class="page-description">Review the recipient snapshot and exclusions before continuing to test and approval.</p>
				}
			</div>
			<div class="action-bar">
				<a class={ button.Variants(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks" }>Back to task list</a>
			</div>
		</header>
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
		}
		<div class="campaign-workspace" x-data="{ tab: 'review' }" x-init="const selected = location.hash.slice(1); if (Array.from($el.querySelectorAll('[role=tab]')).some(item => item.dataset.tab === selected)) tab = selected;">
			<aside class="workspace-sidebar" aria-label="Task navigation">
				if data.Status != "staging" && (data.Counts.Eligible > 0 || data.Status != "ready") {
					<a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault, Class: "workspace-task-link"}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending" }>Continue to test & approval <span aria-hidden="true">→</span></a>
				}
				<p class="workspace-nav-heading">Recipient preparation</p>
				@workspaceTabList("Task sections") {
					if data.Status == "staging" {
						@workspaceSidebarTab("task", "review", "Worksheet setup", "Choose sheet & header row", "review")
					} else {
						@workspaceSidebarTab("task", "review", "Review snapshot", "Counts, content & approval", "review")
						if len(data.Rows) > 0 {
							@workspaceSidebarTab("task", "preview", "Recipient preview", "Check a personalized email", "review")
						}
						<p class="workspace-nav-heading">Records & downloads</p>
						@workspaceSidebarTab("task", "rows", "Rows & exclusions", "Admitted rows & held reasons", "review")
						@workspaceSidebarTab("task", "results", "Results workbook", "Generate & download results", "review")
					}
				}
			</aside>
			<div class="workspace-content">
				if data.Status == "staging" {
					@workspaceTabPanel("task", "review", "review") {
						if data.ValidationError != "" {
							@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
								{ data.ValidationError }
							}
						}
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="selection-heading">
							@card.Content(card.ContentProps{Class: "gap-4"}) {
								<p class="eyebrow">Step 2 · Configure</p>
								<h2 id="selection-heading" class="section-heading">Choose the worksheet and header row</h2>
								<p class="section-description">Confirm which worksheet contains recipients and which row names its columns. Current default: <code>{ data.DefaultSheet }</code>, row { data.HeaderRow }.</p>
								<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/select" } class="field-grid">
									@label.Label(label.Props{For: "select-sheet"}) {
										Worksheet
										@nativeselect.NativeSelect(nativeselect.Props{ID: "select-sheet", Name: "sheet", Class: "w-full"}) {
											for _, sheet := range data.Sheets {
												if sheet.Selected {
													<option value={ sheet.Name } selected>
														@sheetLabel(sheet)
													</option>
												} else {
													<option value={ sheet.Name }>
														@sheetLabel(sheet)
													</option>
												}
											}
										}
									}
									@label.Label(label.Props{For: "select-header-row"}) {
										Header row
										@input.Input(input.Props{ID: "select-header-row", Type: "number", Name: "header_row", Required: true, Attributes: templ.Attributes{"min": "1", "value": data.HeaderRow}})
									}
									<div class="action-bar">
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
											Validate task
										}
									</div>
								</form>
							}
						</section>
					}
				} else {
					@workspaceTabPanel("task", "review", "review") {
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="counts-heading">
							@card.Content(card.ContentProps{Class: "gap-4"}) {
								<p class="eyebrow">Step 3 · Review</p>
								<div class="action-bar">
									<h2 id="counts-heading" class="section-heading">Validation snapshot</h2>@revisionState(true, data.Approved)
								</div>
								<dl class="metric-grid">
									<div class="metric">
										<dt class="font-semibold">Total rows:</dt>
										<dd>{ data.Counts.Total }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Eligible:</dt>
										<dd>{ data.Counts.Eligible }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Ineligible:</dt>
										<dd>{ data.Counts.Ineligible }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Duplicate:</dt>
										<dd>{ data.Counts.Duplicate }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Invalid address:</dt>
										<dd>{ data.Counts.Invalid }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Already submitted:</dt>
										<dd>{ data.Counts.AlreadySubmitted }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Already scheduled:</dt>
										<dd>{ data.Counts.AlreadyScheduled }</dd>
									</div>
									<div class="metric">
										<dt class="font-semibold">Review required:</dt>
										<dd>{ data.Counts.ReviewRequired }</dd>
									</div>
								</dl>
								if data.Counts.Eligible == 0 && data.Status == "ready" {
									<div class="status-warning" role="status">No eligible recipients. Review the held rows in Rows & exclusions, correct the workbook and upload a new task.</div>
								}
								<p class="text-sm text-muted-foreground">Candidate sending requires completed production release verification. Tests, approval, progress and recovery controls are available on the sending page.</p>
								<div class="subtle-panel">
									<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Result labels</p>
									<p>{ joinLabels(data.ResultLabels) }</p>
								</div>
								<details class="snapshot-details">
									<summary>Snapshot details · revision { data.Revision }</summary>
									<dl class="space-y-1 text-sm">
										<div class="flex gap-2">
											<dt class="font-semibold">Revision:</dt>
											<dd>{ data.Revision }</dd>
										</div>
										<div class="flex gap-2">
											<dt class="font-semibold">Content hash:</dt>
											<dd><code class="break-all">{ data.ContentHash }</code></dd>
										</div>
										<div class="flex gap-2">
											<dt class="font-semibold">Approval:</dt>
											<dd>
												@revisionState(true, data.Approved)
											</dd>
										</div>
									</dl>
								</details>
							}
						</section>
						if data.ScheduleAt != "" {
							<p class="font-semibold">Scheduled start: { data.ScheduleAt } ({ data.ScheduleState })</p>
							if data.ScheduleState == "missed" {
								<p class="text-warning">The scheduled time passed without starting. Review this task and schedule a new start.</p>
							} else if data.ScheduleState == "fired" {
								<p class="text-sm text-muted-foreground">This schedule started the task once.</p>
							}
						}
						if data.Stale {
							@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
								<div>
									<p class="font-semibold">The campaign content changed after this task was validated</p>
									<p>Revalidate this task to rebuild the snapshot against the current revision.</p>
								</div>
								<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/revalidate" }>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeSm, Class: "status-warning"}) {
										Revalidate
									}
								</form>
							}
						}
					}
					@workspaceTabPanel("task", "rows", "review") {
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="download-heading">
							@card.Content(card.ContentProps{Class: "gap-2"}) {
								<h2 id="download-heading" class="cn-card-title">Exclusion report</h2>
								<p class="text-sm text-muted-foreground">Every held row with its original columns, available even when no row is eligible.</p>
								<div class="app-card-actions">
									<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/excluded.xlsx" }>Download exclusion report</a>
								</div>
							}
						</section>
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="held-heading">
							@card.Content(card.ContentProps{}) {
								<h2 id="held-heading" class="cn-card-title">Held rows</h2>
								if len(data.HeldRows) == 0 {
									<p class="text-muted-foreground">No held rows: every candidate row was admitted.</p>
								} else {
									<div class="table-scroll">
										@table.Table(table.Props{Class: "cn-table-compact"}) {
											<thead>
												<tr>
													<th>Worksheet row</th>
													<th>Reason</th>
												</tr>
											</thead>
											<tbody>
												for _, held := range data.HeldRows {
													<tr>
														<td>{ held.Row }</td>
														<td>{ held.Reason }</td>
													</tr>
												}
											</tbody>
										}
									</div>
								}
							}
						</section>
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="rows-heading">
							@card.Content(card.ContentProps{}) {
								<h2 id="rows-heading" class="cn-card-title">Admitted rows</h2>
								if len(data.Rows) == 0 {
									<p class="text-muted-foreground">No admitted rows in this snapshot.</p>
								} else {
									<div class="table-scroll">
										@table.Table(table.Props{Class: "cn-table-compact"}) {
											<thead>
												<tr>
													<th>Worksheet row</th>
													<th>State</th>
													<th>Reason</th>
												</tr>
											</thead>
											<tbody>
												for _, row := range data.Rows {
													<tr>
														<td>{ row.Row }</td>
														<td><code>{ row.State }</code></td>
														<td>{ row.Reason }</td>
													</tr>
												}
											</tbody>
										}
									</div>
								}
							}
						</section>
					}
					if len(data.Rows) > 0 {
						@workspaceTabPanel("task", "preview", "review") {
							<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="preview-heading">
								@card.Content(card.ContentProps{Class: "gap-4"}) {
									<h2 id="preview-heading" class="cn-card-title">Row preview</h2>
									<p class="text-sm text-muted-foreground">Render one admitted row through the pinned revision. Nothing is stored and nothing is sent.</p>
									<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preview" } hx-post={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preview" } hx-target="#task-preview-result" hx-swap="innerHTML" hx-disabled-elt="this" class="space-y-4">
										@label.Label(label.Props{For: "preview-row"}) {
											Row
										}
										@nativeselect.NativeSelect(nativeselect.Props{ID: "preview-row", Name: "row", Class: "w-full"}) {
											for _, row := range data.Rows {
												<option value={ row.ID }>Worksheet row { row.Row } ({ row.State })</option>
											}
										}
										<div class="action-bar">
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
												Render preview
											}
										</div>
									</form>
									<div id="task-preview-result" role="status" aria-live="polite">
										<p class="text-muted-foreground">Submit a row to render its pinned email here.</p>
									</div>
								}
							</section>
						}
					}
					@workspaceTabPanel("task", "results", "review") {
						<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="results-heading">
							@card.Content(card.ContentProps{Class: "gap-4"}) {
								<h2 id="results-heading" class="cn-card-title">Task results workbook</h2>
								<p>The workbook keeps every original worksheet, row and cell, and adds the result columns after the source columns. It is built from retained records only; generating it never sends or retries an email.</p>
								if data.ResultsReady {
									<dl class="space-y-1 text-sm">
										<div class="flex gap-2">
											<dt class="font-semibold">As of:</dt>
											<dd>{ data.ResultsAsOf }</dd>
										</div>
									</dl>
									<div class="app-card-actions">
										<a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results.xlsx" }>Download results</a>
										<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results#results" }>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeDefault}) {
												Regenerate
											}
										</form>
										<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results/delete#results" }>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeDefault}) {
												Remove generated file
											}
										</form>
									</div>
									<p class="text-sm text-muted-foreground">Removing this file deletes only the generated workbook. Candidate eligibility, uploads and attempt history stay unchanged, and the workbook can be generated again.</p>
								} else {
									if data.ResultsState == "generating" {
										<p>Generating the workbook now. Reload this page shortly.</p>
									} else if data.ResultsState == "failed" {
										if data.ResultsError != "" {
											@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
												{ data.ResultsError }
											}
										}
										<p>The last generation did not finish, so no download is presented. Retrying rebuilds the file from retained records.</p>
									} else if data.Status == "completed" || data.Status == "stopped" || data.Status == "interrupted" {
										<p>No workbook is published yet. Generate it now, or wait for the background worker to consume the recorded marker.</p>
									} else {
										<p>A results workbook becomes available after the task completes, stops or recovers from an interruption. Current status: <code>{ data.Status }</code>.</p>
									}
									if data.Status == "completed" || data.Status == "stopped" || data.Status == "interrupted" {
										<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results#results" }>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
												Generate results workbook
											}
										</form>
									}
								}
							}
						</section>
					}
				}
			</div>
		</div>
	}
}

// TaskPreviewData is the view model for the preview partial. The error is a
// fixed operator-facing message shown instead of rendered content.
type TaskPreviewData struct {
	Error       string
	Recipient   string
	Subject     string
	Body        string
	Values      []PreviewValue
	SourceRow   int
	ContentHash string
	Approved    bool
}

templ TaskPreviewResult(data TaskPreviewData) {
	<div class="subtle-panel space-y-4">
		<h3 class="section-heading">Preview result</h3>
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
		} else {
			<dl class="space-y-1 text-sm">
				<div class="flex gap-2">
					<dt class="font-semibold">Worksheet row:</dt>
					<dd>{ data.SourceRow }</dd>
				</div>
				<div class="flex gap-2">
					<dt class="font-semibold">Content hash:</dt>
					<dd><code class="break-all">{ data.ContentHash }</code></dd>
				</div>
				<div class="flex gap-2">
					<dt class="font-semibold">Approval:</dt>
					<dd>
						@revisionState(true, data.Approved)
					</dd>
				</div>
			</dl>
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">To</p>
				<p class="font-semibold">{ data.Recipient }</p>
			</div>
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Subject</p>
				<p class="font-semibold">{ data.Subject }</p>
			</div>
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Body</p>
				<div class="email-body rounded-card border border-border p-4">
					@templ.Raw(data.Body)
				</div>
			</div>
			<div class="table-scroll">
				@table.Table(table.Props{Class: "cn-table-compact"}) {
					<thead>
						<tr>
							<th>Variable</th>
							<th>Source header</th>
							<th>Raw value</th>
							<th>Used value</th>
						</tr>
					</thead>
					<tbody>
						for _, value := range data.Values {
							<tr>
								<td>{ value.Variable }</td>
								<td><code>{ value.Header }</code></td>
								<td><code>{ value.Raw }</code></td>
								<td><code>{ value.Normalized }</code></td>
							</tr>
						}
					</tbody>
				}
			</div>
		}
	</div>
}

// joinLabels renders the task's resolved result labels as one line.
func joinLabels(labels []string) string {
	return strings.Join(labels, ", ")
}

templ taskStatusBadge(status string) {
	if status == "ready" {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "status-success"}) {
			{ "Ready" }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "status-warning"}) {
			{ "Staging" }
		}
	}
}

templ sheetLabel(sheet TaskSheetOption) {
	if sheet.Visible {
		{ sheet.Name }
	} else {
		{ sheet.Name } (hidden)
	}
}
