package views

import (
	"encoding/hex"
	"strconv"
	"strings"

	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/accordion"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alertdialog"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/badge"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/checkbox"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/collapsible"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/dialog"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/field"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/icon"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/input"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/item"
	uilabel "github.com/yash91989201/bachtel-email-automation/internal/web/ui/label"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/nativeselect"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/scrollarea"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/table"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/textarea"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/tooltip"
	"slices"
)

// Task workspace sections. Their order is the navigation order.
const (
	TaskSectionOverview   = "overview"
	TaskSectionRecipients = "recipients"
	TaskSectionTest       = "test"
	TaskSectionSending    = "sending"
	TaskSectionResults    = "results"
)

// Sending types select a first-start view; they never authorize dispatch.
const (
	TaskSendingTypeDirect    = "direct"
	TaskSendingTypeScheduled = "scheduled"
	TaskSendingTypeChoose    = "choose"
)

// TaskUploadData is the view model for the workbook upload page: campaign
// context, readable bounds and the mapped-column prerequisite.
type TaskUploadData struct {
	SendingType       string
	CampaignID        string
	CampaignName      string
	Error             string
	HasRevision       bool
	Revision          int
	MappedColumns     []string
	MaxUploadBytes    int64
	UnzipSizeLimit    int64
	UnzipXMLSizeLimit int64
}

templ TaskUpload(data TaskUploadData) {
	@Layout("New task", true, "campaigns") {
		<header class="space-y-3 pt-1 pb-2.5">
			@pageBreadcrumbs(breadcrumbEntry{Label: "Campaigns", Href: "/campaigns"}, breadcrumbEntry{Label: data.CampaignName, Href: "/campaigns/" + data.CampaignID}, breadcrumbEntry{Label: "Tasks", Href: CampaignSectionPath(data.CampaignID, CampaignSectionTasks)}, breadcrumbEntry{Label: "Upload workbook"})
			<h1>Upload a task workbook</h1>
			<p class="max-w-170 text-muted-foreground text-[.9375rem]">Uploading stores the workbook as a staging task for <strong>{ data.CampaignName }</strong>. Next, confirm the worksheet and header row before validation.</p>
			<p class="text-sm text-muted-foreground">
				if data.HasRevision {
					Template: <strong class="text-foreground">Revision { data.Revision }</strong>
				} else {
					Template: <strong class="text-foreground">No template</strong> — you can stage a workbook now; validation needs a template.
				}
			</p>
		</header>
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
		}
		if !data.HasRevision {
			@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
				@alert.Title(alert.TitleProps{}) {
					Add a template before validating this workbook
				}
				@alert.Description(alert.DescriptionProps{}) {
					<p>The upload is stored, but mapped header names and validation are only available once the campaign has a template.</p>
					<a class="app-link text-primary" href={ CampaignSectionPath(data.CampaignID, CampaignSectionTemplate) }>Add template</a>
				}
			}
		}
		<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks" } enctype="multipart/form-data">
			@card.Card(card.Props{}) {
				@card.Content(card.ContentProps{Class: "gap-4"}) {
					<h2 class="font-bold text-[1.2rem] tracking-[-.02em]">Choose a workbook</h2>
					@field.Field(field.Props{}) {
						@field.Label(field.LabelProps{For: "task-workbook"}) {
							Workbook (XLSX)
						}
						@input.Input(input.Props{ID: "task-workbook", Name: "workbook", Type: "file", Accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Required: true, Attributes: templ.Attributes{"aria-describedby": "workbook-guidance"}})
					}
					<div id="workbook-guidance" class="space-y-2 text-sm text-muted-foreground">
						<p>Format: <code>.xlsx</code> · upload size limit: { readableBytes(data.MaxUploadBytes) } · support bound: 1,000 recipient entries per task after splitting. Split larger lists across several tasks.</p>
						<p>A recipient cell may contain several addresses separated by commas, for example <code>ada@example.com, grace@example.com</code>. Each address becomes its own recipient entry with a copy of that row's other mapped values; only commas separate addresses, and spaces or semicolons alone are invalid.</p>
						<p>Every expanded entry counts toward the 1,000-entry bound, including empty, invalid and duplicate entries. An excluded entry affects only itself; valid addresses from the same row are still processed.</p>
						if data.HasRevision {
							<p>Every mapped column is mandatory in the chosen header row, including optional-value mappings: <span class="wrap-anywhere">{ joinList(data.MappedColumns) }</span>.</p>
						}
					</div>
					<div class="max-w-md">
						@field.Field(field.Props{}) {
							@field.Label(field.LabelProps{For: "task-sending-type"}) {
								Sending type
							}
							@nativeselect.NativeSelect(nativeselect.Props{ID: "task-sending-type", Name: "sending_type", Required: true, Class: "w-full", Attributes: templ.Attributes{"aria-describedby": "task-sending-type-help"}}) {
								<option value="">Choose Direct or Scheduled</option>
								<option value={ TaskSendingTypeDirect } selected?={ data.SendingType == TaskSendingTypeDirect }>Direct — send after confirmation</option>
								<option value={ TaskSendingTypeScheduled } selected?={ data.SendingType == TaskSendingTypeScheduled }>Scheduled — choose a future start</option>
							}
						}
					</div>
					<p id="task-sending-type-help" class="text-sm text-muted-foreground">You can change this before sending starts. Creating a task never sends email or authorizes a schedule.</p>
					<div class="app-card-actions">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
							Upload workbook
						}
						<a class={ button.Variants(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault}) } href={ CampaignSectionPath(data.CampaignID, CampaignSectionTasks) }>Cancel</a>
					</div>
				}
			}
		</form>
		@collapsible.Collapsible(collapsible.Props{ID: "technical-limits", Class: "p-[1.1rem] border border-border rounded-4xl bg-muted", Attributes: templ.Attributes{"data-workspace-persist": true}}) {
			<button class="cursor-pointer text-left font-semibold bg-transparent border-0 p-0" { collapsible.Trigger(ctx)... }>Technical limits</button>
			@collapsible.Content(collapsible.ContentProps{Class: "mt-3 space-y-2 text-sm text-muted-foreground"}) {
				{{ sizeLine := "Expanded workbook archive limit: " + readableBytes(data.UnzipSizeLimit) + ", and " + readableBytes(data.UnzipXMLSizeLimit) + " for a single expanded XML part." }}
				<ul class="list-inside list-disc space-y-1">
					<li>{ sizeLine }</li>
					<li>Password-protected workbooks, legacy <code>.xls</code> files and macro containers are rejected.</li>
					<li>Header labels are matched after trimming surrounding whitespace, are case sensitive, and each required label must appear exactly once in the chosen header row.</li>
					<li>A formula cell is read as its cached value; the workbook's formulas are never evaluated.</li>
				</ul>
			}
		}
	}
}

// TaskPageData is the safe view model for the one task workspace. Every fact is
// derived from the task record or an existing service answer; nothing here is
// stored UI state.
type TaskPageData struct {
	CampaignID   string
	CampaignName string
	TaskID       string

	// Section selects the rendered panel; the section path sets it, and an
	// error keeps the section its message belongs to.
	Section string
	Error   string

	Filename  string
	Reference string

	UploadedAt         string
	StoredStatus       string
	Closed             bool
	Closing            bool
	ClosedAt           string
	ClosedBy           string
	CanClose           bool
	StatusLabel        string
	StatusExplanation  string
	StatusClass        string
	NextLabel          string
	NextHref           string
	Lifecycle          []LifecycleStep
	Blockers           []TaskBlocker
	HasSavedRevision   bool
	SavedRevision      int
	HasCurrentRevision bool
	CurrentRevision    int
	Worksheet          string
	HeaderRow          int
	Sender             string
	SenderStatus       string
	Approved           bool
	Stale              bool
	RestoreReview      bool
	ScheduleAt         string
	SendingType        string
	ScheduleState      string
	ScheduleMinDate    string

	ValidationError string
	Sheets          []TaskSheetOption
	DefaultSheet    string
	// Submitted worksheet/header choice retained after a refused selection.
	SheetDraft     string
	HeaderRowDraft int
	// Submitted schedule fields retained after a refused schedule.
	ScheduleDraftDate string
	ScheduleDraftTime string

	Counts           TaskCounts
	Summary          TaskSummaryView
	Categories       []TaskCategory
	ResultLabels     []string
	HeldRows         []TaskHeldRow
	Rows             []TaskAdmittedRow
	HasRows          bool
	AlreadyScheduled int

	PreviewRowID string
	Preview      TaskPreviewData

	Hash        string
	LatestTest  string
	Recent      []TaskAttemptRow
	Resolutions []TaskResolutionRow

	Eligible        int
	Remaining       int
	Submitted       int
	Failed          int
	RetryableFailed int
	Held            int
	InFlight        int
	Reserved        int
	Invalid         int
	Duplicate       int
	Ineligible      int
	Rate            int
	Cooldown        string
	CooldownReason  string
	ActionID        string
	Controls        TaskControls

	ResultsState   string
	ResultsError   string
	ResultsAsOf    string
	ResultsReady   bool
	ResultEligible bool

	Preparation  TaskPreparationView
	Finalization TaskFinalizationView
	// DatasetFinalized reports a selected immutable final sending snapshot.
	DatasetFinalized bool
	// FinalizationRequired reports the snapshot workflow for this revision.
	FinalizationRequired bool
	RoleMapping          bool
	FinalSnapshotRef     string
}

// TaskControls is the rendered subset of the action matrix.
type TaskControls struct {
	Validate       bool
	Revalidate     bool
	Start          bool
	Schedule       bool
	SendNowInstead bool
	EditSchedule   bool
	ClearSchedule  bool
	Stop           bool
	Resume         bool
	RetryAll       bool
	RetryRow       bool
	ResendRow      bool
	ResolveRow     bool
	GenerateResult bool
	RetryResult    bool
}

// LifecycleStep is one evidence-based lifecycle entry.
type LifecycleStep struct {
	Name     string
	State    string
	Complete bool
}

// TaskBlocker is one reason an otherwise relevant action cannot proceed.
type TaskBlocker struct {
	Label   string
	Remedy  string
	Section string
	Href    string
}

// TaskSheetOption is one stored worksheet of the uploaded workbook.
type TaskSheetOption struct {
	Name     string
	Visible  bool
	Selected bool
}

// TaskCounts mirrors the task validation counts in plain view fields.
type TaskCounts struct {
	Total            int
	Eligible         int
	Ineligible       int
	Duplicate        int
	Invalid          int
	AlreadySubmitted int
	AlreadyScheduled int
	ReviewRequired   int
}

// TaskSummaryView is the validated summary line: source rows, expanded
// recipient entries, entries eligible at validation, entries excluded at
// validation and the current rechecked scope.
type TaskSummaryView struct {
	SourceRows           int
	Total                int
	Eligible             int
	ExcludedAtValidation int
	CurrentEligible      int
}

// TaskCategory is one mutually exclusive validation category.
type TaskCategory struct {
	Label string
	Count int
}

// TaskHeldRow is one manifest entry held back from candidate storage.
type TaskHeldRow struct {
	Row       int
	Position  int
	Recipient string
	Reason    string
}

// TaskAdmittedRow is one admitted snapshot entry for the review tables.
type TaskAdmittedRow struct {
	ID        string
	Row       int
	Position  int
	Recipient string
	State     string
	Reason    string
	// Prior attempt evidence for a recovery row.
	AttemptID        string
	AttemptRecipient string
	AttemptState     string
	AttemptTime      string
	AttemptReason    string
}

// TaskAttemptRow is one recorded task attempt.
type TaskAttemptRow struct {
	ID        string
	Kind      string
	Recipient string
	State     string
	Reason    string
	Time      string
	Test      bool
	HTMLHref  string
}

// TaskResolutionRow is one manual outcome resolution recorded for the task.
type TaskResolutionRow struct {
	Row   int
	Actor string
	Basis string
	Time  string
}

// TaskPreparationView is the stored AI data-preparation evidence of one task.
// It is review evidence only: nothing here authorizes sending or eligibility.
type TaskPreparationView struct {
	Available         bool
	Configured        bool
	ConnectionLabel   string
	Endpoint          string
	PromptVersion     int
	Prompt            string
	Instructions      string
	CanManage         bool
	CanPrepare        bool
	CanRetry          bool
	CanRerun          bool
	BlockedReason     string
	SelectedRunID     string
	EvidenceRunID     string
	EvidenceSelected  bool
	Runs              []TaskPreparationRun
	Counts            TaskPreparationCounts
	Corrections       []TaskPreparationNote
	CorrectionsHidden int
	Findings          []TaskPreparationNote
	FindingsHidden    int
	Held              []TaskPreparationHeld
	HeldHidden        int
}

// TaskPreparationRun is one preparation run row.
type TaskPreparationRun struct {
	ID            string
	Kind          string
	State         string
	Provider      string
	APIRoot       string
	APIFormat     string
	Model         string
	PromptVersion int
	Instructions  string
	Batches       string
	CreatedAt     string
	StartedAt     string
	FinishedAt    string
	Error         string
	Accepted      int
	Held          int
	Corrections   int
	Findings      int
	Selected      bool
	CanSelect     bool
}

// TaskPreparationCounts is the prepared dataset summary of one run.
type TaskPreparationCounts struct {
	SourceRows  int
	Entries     int
	Accepted    int
	Held        int
	Corrections int
	Findings    int
}

// TaskPreparationNote is one resolved correction or unresolved finding.
type TaskPreparationNote struct {
	Row      int
	Position int
	Field    string
	Scope    string
	Note     string
}

// TaskFinalizationView is the final-sending-dataset state of one task. Dataset
// approval is deliberately separate from test formatting approval and dispatch
// authorization.
type TaskFinalizationView struct {
	Available   bool
	RoleMapping bool
	// CanFinalize covers the lifecycle: open, validated, unstarted, no
	// enabled schedule.
	CanFinalize            bool
	BlockedReason          string
	Error                  string
	Required               bool
	PreparedReady          bool
	PreparedAccepted       int
	PreparedHref           string
	SanitizationHref       string
	PreparedReview         bool
	PreparedReviewSelected bool
	PreparedCounts         TaskFinalReviewCounts
	PreparedEntries        []TaskFinalReviewEntry
	PreparedExclusions     []TaskFinalReviewExclusion
	Selected               TaskFinalSnapshot
	HasSelected            bool
	CanApprove             bool
	CanUpload              bool
	History                []TaskFinalSnapshot
}

// TaskFinalSnapshot is one immutable accepted dataset row.
type TaskFinalSnapshot struct {
	ID         string
	Reference  string
	Kind       string
	CreatedAt  string
	Actor      string
	Accepted   int
	Excluded   int
	Digest     string
	Selected   bool
	SheetHref  string
	ReportHref string
	Counts     TaskFinalReviewCounts
	Entries    []TaskFinalReviewEntry
	Exclusions []TaskFinalReviewExclusion
}

type TaskFinalReviewCounts struct {
	SourceRows int
	Entries    int
	Accepted   int
	Excluded   int
}

type TaskFinalReviewEntry struct {
	Row       int
	Position  int
	Recipient string
}

type TaskFinalReviewExclusion struct {
	Row       int
	Position  int
	Recipient string
	Reason    string
}

// TaskPreparationHeld is one prepared entry held by an unresolved finding.
type TaskPreparationHeld struct {
	Row       int
	Position  int
	Recipient string
	Reasons   string
}

templ TaskPage(data TaskPageData) {
	@Layout("Task", true, "campaigns") {
		<header class="space-y-3 pt-1 pb-2.5">
			@pageBreadcrumbs(breadcrumbEntry{Label: "Campaigns", Href: "/campaigns"}, breadcrumbEntry{Label: data.CampaignName, Href: "/campaigns/" + data.CampaignID}, breadcrumbEntry{Label: "Tasks", Href: CampaignSectionPath(data.CampaignID, CampaignSectionTasks)}, breadcrumbEntry{Label: data.Filename})
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="min-w-0 wrap-anywhere">{ data.Filename }</h1>
				<div class="shrink-0">
					@taskStatusBadge(data.StatusLabel, data.StatusClass)
				</div>
			</div>
			if data.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "status-danger"}) {
					{ data.Error }
				}
			}
			if data.Closed {
				@alert.Alert(alert.Props{Class: "status-success"}) {
					Closed { data.ClosedAt } by the operator. This task is terminal: it cannot be prepared, finalized, scheduled, tested, resumed, retried or resent. Recorded attempts, outcomes and downloads remain available, and a new task keeps the existing recipient-history checks.
				}
			} else if data.Closing {
				@alert.Alert(alert.Props{Class: "status-warning"}) {
					Close confirmed. New launches stop and queued work is cancelled; closure becomes final once in-flight requests settle. Uncertain outcomes stay uncertain.
				}
			}
			if data.RestoreReview {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "status-danger"}) {
					Restore review is active. Sending, scheduling, retries and resends are disabled until submissions made after the restored backup are reconciled and the server is restarted without APP_RESTORE_REVIEW. Stop and manual outcome resolution stay available.
				}
			}
		</header>
		{{ section := taskInitialSection(data) }}
		<div class="grid grid-cols-[240px_minmax(0,1fr)] gap-8 items-start max-[760px]:grid-cols-1 max-[760px]:gap-5">
			<aside class="sticky top-6 max-[760px]:static">
				@workspaceNav("Task navigation", taskSections(data.CampaignID, data.TaskID), TaskSectionPath(data.CampaignID, data.TaskID, section))
			</aside>
			<div class="min-w-0" id={ "task-panel-" + section }>
				switch section {
					case TaskSectionRecipients:
						@taskRecipients(data)
					case TaskSectionTest:
						@taskTest(data)
					case TaskSectionSending:
						@TaskSendingLive(data)
					case TaskSectionResults:
						@taskResults(data)
					default:
						@taskOverview(data)
				}
			</div>
		</div>
	}
}

templ taskOverview(data TaskPageData) {
	<section class="space-y-6" aria-labelledby="overview-heading">
		<h2 id="overview-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Overview</h2>
		@taskLifecycle(data)
		@card.Card(card.Props{Attributes: templ.Attributes{"aria-labelledby": "task-details-heading"}}) {
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h3 id="task-details-heading" class="cn-card-title">Task details</h3>
				<dl class="grid grid-cols-2 gap-4 text-sm *:min-w-0 [&_dt]:text-muted-foreground [&_dd]:mt-1 [&_dd]:wrap-anywhere max-[760px]:grid-cols-1">
					<div><dt>Uploaded</dt><dd>{ data.UploadedAt }</dd></div>
					<div><dt>Campaign</dt><dd><a class="app-link text-primary" href={ CampaignSectionPath(data.CampaignID, CampaignSectionTasks) }>{ data.CampaignName }</a></dd></div>
					<div>
						<dt>Saved revision</dt>
						<dd>
							if data.HasSavedRevision {
								{ data.SavedRevision }
							} else {
								Not validated
							}
						</dd>
					</div>
					<div>
						<dt>Formatting</dt>
						<dd>
							@revisionState(data.HasSavedRevision, data.Approved)
						</dd>
					</div>
					if data.Worksheet != "" {
						<div><dt>Worksheet</dt><dd>{ data.Worksheet }</dd></div>
						<div><dt>Header row</dt><dd>{ data.HeaderRow }</dd></div>
					}
					<div><dt>Sender</dt><dd><strong data-sender-status={ data.SenderStatus }>{ data.Sender }</strong> ({ data.SenderStatus })</dd></div>
					if data.ScheduleAt != "" {
						<div><dt>Scheduled start</dt><dd>{ data.ScheduleAt } ({ data.ScheduleState })</dd></div>
					}
					if data.ClosedAt != "" {
						<div><dt>Closed</dt><dd>{ data.ClosedAt }</dd></div>
					}
				</dl>
				<details class="text-xs text-muted-foreground">
					<summary class="cursor-pointer">Technical details</summary>
					<p class="mt-1">Reference: { data.Reference }</p>
					<p class="mt-1">Task ID: <code class="break-all">{ data.TaskID }</code> · Stored status: <code>{ data.StoredStatus }</code></p>
				</details>
			}
		}
	</section>
}

templ taskLifecycle(data TaskPageData) {
	<div class="space-y-4">
		<h3 class="text-sm font-semibold text-muted-foreground">Task progress</h3>
		<ol class="grid grid-cols-5 gap-4 text-sm max-[1100px]:grid-cols-1" aria-label="Task lifecycle">
			for index, step := range data.Lifecycle {
				{{ section := taskLifecycleSection(step.Name) }}
				{{ current := section == taskLifecycleNextSection(data) }}
				{{ href := TaskSectionPath(data.CampaignID, data.TaskID, section) }}
				<li class="group relative min-w-0" data-complete={ strconv.FormatBool(step.Complete) } data-next={ strconv.FormatBool(!step.Complete && current) }>
					if index < len(data.Lifecycle)-1 {
						<span aria-hidden="true" class="absolute top-4 left-8 -right-4 h-px bg-border group-data-[complete=true]:bg-primary/40 max-[1100px]:top-8 max-[1100px]:left-4 max-[1100px]:right-auto max-[1100px]:-bottom-4 max-[1100px]:h-auto max-[1100px]:w-px"></span>
					}
					<div class="relative flex flex-col items-start gap-2 max-[1100px]:flex-row max-[1100px]:gap-3">
						<span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold text-muted-foreground group-data-[complete=true]:border-primary group-data-[complete=true]:bg-primary group-data-[complete=true]:text-primary-foreground group-data-[next=true]:border-primary group-data-[next=true]:text-primary group-data-[next=true]:ring-4 group-data-[next=true]:ring-primary/10">
							if step.Complete {
								@icon.Check(icon.Props{Size: 16})
							} else {
								{ index + 1 }
							}
						</span>
						<div class="flex min-w-0 flex-col items-start gap-2">
							<div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
								<span class={ templ.KV("text-primary", current), "font-semibold" }>{ step.Name }</span>
								@tooltip.Tooltip(tooltip.Props{ID: "task-progress-help-" + section}) {
									<button type="button" class="relative inline-flex size-4 shrink-0 items-center justify-center rounded-full border border-border text-[.6rem] font-semibold before:absolute before:-inset-1 text-muted-foreground cursor-help hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label={ "About " + step.Name } aria-describedby={ "task-progress-help-" + section } data-templ-tooltip-open-on-press { tooltip.Trigger(ctx)... }>
										<span aria-hidden="true">i</span>
									</button>
									@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom, Class: "block max-w-60! space-y-1 px-2! py-1.5! text-[.7rem]! leading-snug", Attributes: templ.Attributes{"role": "tooltip"}}) {
										if current && data.StatusExplanation != "" {
											<p>{ data.StatusExplanation }</p>
										} else {
											<p>{ taskLifecycleHelp(step.Name) }</p>
										}
										for _, blocker := range data.Blockers {
											if taskLifecycleBlockerSection(blocker) == section {
												<p><strong>{ blocker.Label }.</strong> { blocker.Remedy }</p>
											}
										}
									}
								}
							</div>
							<p class="text-xs text-muted-foreground wrap-anywhere">{ step.State }</p>
							for _, blocker := range data.Blockers {
								if taskLifecycleBlockerSection(blocker) == section {
									<p class="text-xs status-warning">{ blocker.Label }</p>
									if blocker.Href != "" && blocker.Href != href && (!current || blocker.Href != data.NextHref) {
										<a class="app-link text-xs text-primary" href={ blocker.Href }>{ blocker.Label } →</a>
									}
								}
							}
							if current && data.NextHref != "" && data.NextLabel != "" {
								@button.Button(button.Props{Href: data.NextHref, Size: button.SizeSm, Class: "h-auto! min-h-9! max-w-full whitespace-normal py-2! text-left text-xs! leading-4"}) {
									{ data.NextLabel } <span aria-hidden="true">→</span>
								}
								if data.NextHref != href {
									<a class="app-link text-xs text-primary" href={ href }>{ "Open " + step.Name }</a>
								}
							}
						</div>
					</div>
				</li>
			}
		</ol>
	</div>
}

// External prerequisites still belong to the stage they prevent.
func taskLifecycleNextSection(data TaskPageData) string {
	for _, section := range []string{TaskSectionOverview, TaskSectionRecipients, TaskSectionTest, TaskSectionSending, TaskSectionResults} {
		if strings.HasSuffix(data.NextHref, "/"+section) {
			return section
		}
	}
	if strings.HasSuffix(data.NextHref, "/template") {
		return TaskSectionRecipients
	}
	return TaskSectionSending
}

func taskLifecycleBlockerSection(blocker TaskBlocker) string {
	if blocker.Section != "" {
		return blocker.Section
	}
	return TaskSectionSending
}

func taskLifecycleHelp(name string) string {
	switch name {
	case "Upload":
		return "Original workbook saved. Upload details and its reference are below."
	case "Recipients":
		return "Validate the workbook and review recipients, previews and exclusions."
	case "Test & approve":
		return "Approve a received formatting test for this saved content and current mailbox."
	case "Sending":
		return "Choose Direct or Scheduled, then confirm sending. Manage progress and recovery here."
	case "Results":
		return "Review results and attempt history. Submitted means provider acceptance, not delivery."
	default:
		return "Open this step to review its current state."
	}
}

func taskLifecycleSection(name string) string {
	switch name {
	case "Recipients":
		return TaskSectionRecipients
	case "Test & approve":
		return TaskSectionTest
	case "Sending":
		return TaskSectionSending
	case "Results":
		return TaskSectionResults
	default:
		return TaskSectionOverview
	}
}

templ taskRecipients(data TaskPageData) {
	<section class="space-y-6" id="task-recipients-summary" aria-labelledby="recipients-heading">
		<h2 id="recipients-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Recipients</h2>
		if data.StoredStatus == "staging" {
			if data.ValidationError != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
					{ data.ValidationError }
				}
			}
			@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "selection-heading"}}) {
				@card.Content(card.ContentProps{Class: "gap-4"}) {
					<p class="text-[.68rem] tracking-[.13em] font-[750] uppercase text-primary mb-[.6rem]">Step 1 · Configure</p>
					<h3 id="selection-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Choose the worksheet and header row</h3>
					<p class="text-muted-foreground max-w-[75ch] text-[.875rem]">Confirm which worksheet contains recipients and which row names its columns. Current selection: <code>{ data.DefaultSheet }</code>, row { data.HeaderRow }.</p>
					if data.HasCurrentRevision {
						<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/select" } class="grid grid-cols-2 gap-4 *:min-w-0 max-[960px]:grid-cols-1 max-[760px]:grid-cols-1">
							@field.Field(field.Props{}) {
								@field.Label(field.LabelProps{For: "select-sheet"}) {
									Worksheet
								}
								@nativeselect.NativeSelect(nativeselect.Props{ID: "select-sheet", Name: "sheet", Class: "w-full"}) {
									for _, sheet := range data.Sheets {
										switch  {
											case data.SheetDraft != "" && sheet.Name == data.SheetDraft:
												<option value={ sheet.Name } selected>
													@sheetLabel(sheet)
												</option>
											case data.SheetDraft == "" && sheet.Selected:
												<option value={ sheet.Name } selected>
													@sheetLabel(sheet)
												</option>
											default:
												<option value={ sheet.Name }>
													@sheetLabel(sheet)
												</option>
										}
									}
								}
							}
							@field.Field(field.Props{}) {
								@field.Label(field.LabelProps{For: "select-header-row"}) {
									Header row
								}
								{{ headerRowValue := data.HeaderRow }}
								if data.HeaderRowDraft > 0 {
									{{ headerRowValue = data.HeaderRowDraft }}
								}
								@input.Input(input.Props{ID: "select-header-row", Type: "number", Name: "header_row", Required: true, Attributes: templ.Attributes{"min": "1", "value": strconv.Itoa(headerRowValue)}})
							}
							<div class="action-bar">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
									Validate workbook
								}
							</div>
						</form>
					} else {
						@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
							@alert.Title(alert.TitleProps{}) {
								Add a template before validating this workbook
							}
							@alert.Description(alert.DescriptionProps{}) {
								<p>The workbook is stored and its worksheet choices stay recorded. Validation is unavailable until the campaign has a template.</p>
								<a class="app-link text-primary" href={ CampaignSectionPath(data.CampaignID, CampaignSectionTemplate) }>Add template</a>
							}
						}
					}
				}
			}
		} else {
			if data.RoleMapping {
				@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "summary-heading"}}) {
					@card.Content(card.ContentProps{Class: "gap-4"}) {
						if data.DatasetFinalized {
							<h3 id="summary-heading" class="cn-card-title">Selected final snapshot</h3>
							<p class="text-sm">{ data.Finalization.Selected.Counts.SourceRows } source rows · { data.Finalization.Selected.Counts.Entries } recipient entries · { data.Finalization.Selected.Counts.Accepted } accepted · { data.Finalization.Selected.Counts.Excluded } excluded</p>
						} else if data.Finalization.PreparedReview {
							<h3 id="summary-heading" class="cn-card-title">Prepared review ready</h3>
							<p class="text-sm">Review the accepted recipients and held entries in the final review below, then approve the prepared data or upload an edited sheet.</p>
						} else {
							<h3 id="summary-heading" class="cn-card-title">Workbook received</h3>
							<p class="text-sm">{ strconv.Itoa(data.Summary.SourceRows) } source rows are ready for data preparation.</p>
							<p class="text-sm text-muted-foreground">Entry counts, accepted recipients and exclusions appear after a preparation run completes and backend validation finishes.</p>
						}
						@taskRevalidateNotice(data)
					}
				}
			} else {
				@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "summary-heading"}}) {
					@card.Content(card.ContentProps{Class: "gap-4"}) {
						<h3 id="summary-heading" class="cn-card-title">Validation summary</h3>
						<p class="text-sm">
							{ strconv.Itoa(data.Summary.SourceRows) } source rows · { strconv.Itoa(data.Summary.Total) } recipient entries · { strconv.Itoa(data.Summary.Eligible) } eligible at validation · { strconv.Itoa(data.Summary.ExcludedAtValidation) } excluded at validation
						</p>
						<p class="text-sm text-muted-foreground">Current eligible/safe remaining: <strong>{ data.Summary.CurrentEligible }</strong>. Rechecked before sending.</p>
						@taskRevalidateNotice(data)
						@collapsible.Collapsible(collapsible.Props{ID: "validation-breakdown", Attributes: templ.Attributes{"data-workspace-persist": true}}) {
							<button class="cursor-pointer text-sm font-semibold text-muted-foreground bg-transparent border-0 p-0" { collapsible.Trigger(ctx)... }>Validation breakdown</button>
							@collapsible.Content(collapsible.ContentProps{Class: "mt-2"}) {
								<div class="table-scroll">
									@table.Table(table.Props{Class: "cn-table-compact", Attributes: templ.Attributes{"aria-label": "Validation categories"}}) {
										<thead><tr><th>Category</th><th>Rows</th></tr></thead>
										<tbody>
											for _, category := range data.Categories {
												<tr><td>{ category.Label }</td><td>{ category.Count }</td></tr>
											}
										</tbody>
									}
								</div>
							}
						}
						if data.Counts.AlreadyScheduled > 0 {
							<p class="text-sm text-muted-foreground">“Already scheduled” means another task claimed the recipient. That is separate from this task's future scheduled start.</p>
						}
						<div class="app-card-actions">
							<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/excluded.xlsx" }>Download exclusion report</a>
						</div>
					}
				}
			}
			@taskPreparation(data)
			@taskFinalization(data)
			if !data.RoleMapping {
				@taskPreview(data)
				@taskRowReasons(data)
			}
		}
	</section>
}

templ taskFinalization(data TaskPageData) {
	<section class="space-y-4" id="task-finalization" aria-labelledby="finalization-heading">
		@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "finalization-heading"}}) {
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<p class="text-[.68rem] tracking-[.13em] font-[750] uppercase text-primary mb-[.6rem]">Step 2 · Final sending data</p>
				<h3 id="finalization-heading" class="cn-card-title">Approve the exact data used for sending</h3>
				<p class="text-sm text-muted-foreground max-w-[75ch]">Dataset approval freezes the accepted recipient values. A new final upload always replaces the selection and needs a fresh test and received-format approval, even when its values look identical.</p>
				if data.Finalization.BlockedReason != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
						<p>{ data.Finalization.BlockedReason }</p>
					}
				}
				if data.Finalization.Error != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						<p>{ data.Finalization.Error }</p>
					}
				}
				if data.Finalization.HasSelected {
					<div class="space-y-2 rounded-md border border-border p-3">
						<p class="text-sm"><strong>Selected final snapshot</strong> <code>{ data.Finalization.Selected.Reference }</code> · { data.Finalization.Selected.Kind } · { data.Finalization.Selected.CreatedAt }</p>
						<p class="text-sm">{ data.Finalization.Selected.Accepted } accepted · { data.Finalization.Selected.Excluded } excluded</p>
						<p class="text-xs text-muted-foreground wrap-anywhere">Digest <code>{ data.Finalization.Selected.Digest }</code> · finalized by { data.Finalization.Selected.Actor }</p>
						<div class="app-card-actions">
							<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ data.Finalization.Selected.SheetHref }>Download accepted final sheet</a>
						</div>
						if data.Finalization.Selected.Accepted == 0 {
							@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
								<p>This final snapshot has no accepted recipients, so no test, start or schedule can use it. Correct the data and upload it again.</p>
							}
						}
					</div>
				} else if data.Finalization.Required {
					<p class="text-sm text-muted-foreground">No final snapshot is selected yet. Sending controls stay unavailable until one is accepted.</p>
				}
				if data.RoleMapping && !data.Finalization.HasSelected && !data.Finalization.PreparedReview {
					<p class="text-sm text-muted-foreground">Validation is pending. Run data preparation to review accepted entries and held exclusions.</p>
				}
				if data.Finalization.PreparedReview && !data.Finalization.HasSelected {
					<div class="space-y-3 rounded-md border border-border p-3" id="prepared-review">
						<h4 class="font-semibold">
							if data.Finalization.PreparedReviewSelected {
								Selected prepared data · backend validation
							} else {
								Prepared data review · select this run to finalize
							}
						</h4>
						<p class="text-sm">{ data.Finalization.PreparedCounts.SourceRows } source rows · { data.Finalization.PreparedCounts.Entries } recipient entries · { data.Finalization.PreparedCounts.Accepted } accepted · { data.Finalization.PreparedCounts.Excluded } held</p>
						if data.Finalization.PreparedCounts.Excluded > 0 {
							<p class="text-sm text-muted-foreground">Held entries stay out of the final sending data. Correct them in the source workbook or in an edited sheet; approval uses the accepted entries only.</p>
							@taskEvidenceDisclosure("finalization-held", "Held entries", data.Finalization.PreparedCounts.Excluded, true) {
								@taskHeldEntries("Prepared held entries", data.Finalization.PreparedExclusions)
								@taskTruncation(len(data.Finalization.PreparedExclusions), data.Finalization.PreparedCounts.Excluded, "held entries", "The review reports below contain the complete list.")
							}
						} else {
							<p class="text-sm text-muted-foreground">No entries are held in this review.</p>
						}
						if data.Finalization.PreparedCounts.Accepted > 0 {
							@taskEvidenceDisclosure("finalization-accepted", "Accepted recipients", data.Finalization.PreparedCounts.Accepted, false) {
								@taskAcceptedEntries(data.Finalization.PreparedEntries)
								@taskTruncation(len(data.Finalization.PreparedEntries), data.Finalization.PreparedCounts.Accepted, "accepted recipients", "The review reports below contain the complete list.")
							}
						} else {
							<p class="text-sm text-muted-foreground">No entries are accepted in this review. Correct the data and upload an edited final sheet.</p>
						}
					</div>
				}
				if data.Finalization.HasSelected {
					if data.Finalization.Selected.Excluded > 0 {
						@taskEvidenceDisclosure("finalization-excluded", "Held entries", data.Finalization.Selected.Excluded, true) {
							@taskHeldEntries("Final exclusions", data.Finalization.Selected.Exclusions)
							@taskTruncation(len(data.Finalization.Selected.Exclusions), data.Finalization.Selected.Excluded, "excluded entries", "The exclusion report below contains the complete list.")
						}
					}
				}
				{{ reportCount := finalReviewReportCount(data) }}
				if reportCount > 0 {
					@taskEvidenceDisclosure("finalization-reports", "Download review reports", reportCount, false) {
						<p class="text-sm text-muted-foreground">Complete audit downloads for the displayed dataset; every link stays owner-scoped.</p>
						if !data.Finalization.HasSelected && data.Finalization.PreparedReview && data.Finalization.SanitizationHref != "" {
							<div class="app-card-actions">
								<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ data.Finalization.SanitizationHref }>Download sanitization report</a>
								<span class="text-sm text-muted-foreground">One row per prepared recipient entry: outcome, corrections, findings, exclusion reasons and original and prepared values.</span>
							</div>
						}
						if !data.Finalization.HasSelected && data.Finalization.PreparedReview && data.Finalization.PreparedReviewSelected && len(data.Finalization.PreparedExclusions) > 0 {
							<div class="app-card-actions">
								<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/excluded.xlsx" }>Download prepared exclusions</a>
								<span class="text-sm text-muted-foreground">Backend-held prepared entries with every exclusion reason.</span>
							</div>
						}
						if data.Finalization.HasSelected && data.Finalization.Selected.Excluded > 0 {
							<div class="app-card-actions">
								<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ data.Finalization.Selected.ReportHref }>Download final exclusions</a>
								<span class="text-sm text-muted-foreground">Entries excluded from the selected final snapshot with every reason.</span>
							</div>
						}
					}
				}
				if data.Finalization.CanApprove {
					<div class="space-y-2 rounded-md border border-border p-3" id="finalize-primary">
						<h4 class="font-semibold">Use prepared data</h4>
						<p class="text-sm text-muted-foreground">It does not send a test, approve received formatting, or authorize candidate sending or scheduling.</p>
						<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/finalization/approve" } class="space-y-2">
							<input type="hidden" name="action_id" value={ data.ActionID + "finalize" }/>
							@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
								@checkbox.Checkbox(checkbox.Props{ID: "finalize-approve", Name: "confirm_approve", Value: "yes", Required: true})
								I reviewed the selected prepared values and accept them as this task's final sending data.
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault}) {
								Approve prepared data as-is
							}
						</form>
					</div>
				}
				if !data.Finalization.HasSelected && !data.Finalization.CanApprove && data.Finalization.Required {
					<p class="text-sm text-muted-foreground">Approve as-is becomes available after a completed preparation run and its backend review. You can still upload an edited final sheet.</p>
				}
				{{ editLabel := "Edit data before approval" }}
				if data.Finalization.HasSelected {
					{{ editLabel = "Edit and upload a replacement" }}
				}
				if data.Finalization.PreparedHref != "" || data.Finalization.CanUpload {
					@taskEvidenceDisclosure("finalization-edit", editLabel, -1, finalEditOpen(data)) {
						<ol class="list-inside list-decimal space-y-2 text-sm">
							<li>
								if data.Finalization.PreparedHref != "" {
									<a class={ button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) } href={ data.Finalization.PreparedHref }>Download prepared sending sheet</a>
								} else {
									<span class="text-muted-foreground">The prepared sending sheet is unavailable; correct the source workbook and upload a full final sheet instead.</span>
								}
							</li>
							<li>Edit recipients and mapped values in Excel. Keep the header row.</li>
							<li>Upload and validate the edited final sheet below.</li>
						</ol>
						<p class="text-sm text-muted-foreground">Validation is deterministic: no AI runs and populated values are preserved apart from recipient trim/lowercase and optional fallbacks. Commas are the only email-list separator. Added, removed, reordered and restored entries are allowed.</p>
						if data.Finalization.CanUpload {
							<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/finalization/upload" } enctype="multipart/form-data" class="space-y-3">
								<input type="hidden" name="action_id" value={ data.ActionID + "finalupload" }/>
								@field.Field(field.Props{}) {
									@field.Label(field.LabelProps{For: "final-workbook"}) {
										Edited final sheet (XLSX)
									}
									@input.Input(input.Props{ID: "final-workbook", Name: "workbook", Type: "file", Accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Required: true, Attributes: templ.Attributes{"aria-describedby": "final-workbook-hint"}})
									<p id="final-workbook-hint" class="text-xs text-muted-foreground">Deterministic validation only: no AI, no recasing and no list normalization. A new upload always needs a fresh test and received-format approval.</p>
								}
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
									Upload and validate final sheet
								}
							</form>
						}
					}
				}
				if len(data.Finalization.History) > 1 {
					<details class="text-sm">
						<summary class="cursor-pointer text-muted-foreground">Final snapshot history</summary>
						<div class="table-scroll mt-2">
							@table.Table(table.Props{Class: "cn-table-compact", Attributes: templ.Attributes{"aria-label": "Final snapshot history"}}) {
								<thead><tr><th>Snapshot</th><th>Source</th><th>Created</th><th>Accepted</th><th>Excluded</th><th>Actions</th></tr></thead>
								<tbody>
									for _, snapshot := range data.Finalization.History {
										<tr>
											<td><code>{ snapshot.Reference }</code></td>
											<td>{ snapshot.Kind }</td>
											<td>{ snapshot.CreatedAt }</td>
											<td>{ snapshot.Accepted }</td>
											<td>{ snapshot.Excluded }</td>
											<td><a class="app-link text-primary" href={ snapshot.SheetHref }>Sheet</a></td>
										</tr>
									}
								</tbody>
							}
						</div>
					</details>
				}
			}
		}
	</section>
}

templ taskPreview(data TaskPageData) {
	<section class="space-y-4" id="task-preview" aria-labelledby="preview-heading">
		@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "preview-heading"}}) {
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h3 id="preview-heading" class="cn-card-title">Recipient preview</h3>
				if len(data.Rows) > 0 {
					<p class="text-sm text-muted-foreground">Select an admitted row to render its saved revision. Nothing is stored and nothing is sent.</p>
					<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preview" } hx-post={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preview" } hx-target="#task-preview-result" hx-swap="innerHTML" hx-trigger="change, submit" hx-indicator="#task-preview-loading" class="space-y-3">
						@field.Field(field.Props{}) {
							@field.Label(field.LabelProps{For: "preview-row"}) {
								Row
							}
							@nativeselect.NativeSelect(nativeselect.Props{ID: "preview-row", Name: "row", Class: "w-full"}) {
								for _, row := range data.Rows {
									if row.ID == data.PreviewRowID {
										<option value={ row.ID } selected>{ previewRowLabel(row) }</option>
									} else {
										<option value={ row.ID }>{ previewRowLabel(row) }</option>
									}
								}
							}
						}
						<div class="app-card-actions items-center">
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
								Refresh preview
							}
							<span id="task-preview-loading" class="htmx-indicator text-sm text-muted-foreground" role="status">Rendering preview…</span>
						</div>
					</form>
				} else {
					<p class="text-muted-foreground">No admitted row is previewable. Review the row reasons and the exclusion report.</p>
				}
				<div id="task-preview-result" role="status" aria-live="polite">
					@TaskPreviewResult(data.Preview)
				</div>
			}
		}
	</section>
}

// previewRowLabel names an entry recognizably: worksheet row, its position
// inside the recipient cell and its individual address or state.
func previewRowLabel(row TaskAdmittedRow) string {
	label := "Worksheet row " + strconv.Itoa(row.Row)
	if row.Position > 0 {
		label += " · recipient " + strconv.Itoa(row.Position)
	}
	if row.Recipient != "" {
		label += " · " + row.Recipient
	}
	if row.State != "" && row.State != "eligible" {
		label += " (" + row.State + ")"
	}
	return label
}

// attentionRows keeps admitted rows that carry a blocker worth acting on.
// Eligible rows without a reason and already submitted rows are settled.
func attentionRows(rows []TaskAdmittedRow) []TaskAdmittedRow {
	kept := make([]TaskAdmittedRow, 0, len(rows))
	for _, row := range rows {
		if row.State == "submitted" || (row.State == "eligible" && row.Reason == "") {
			continue
		}
		kept = append(kept, row)
	}
	return kept
}

templ taskRowReasons(data TaskPageData) {
	<section class="space-y-6" id="task-row-reasons">
		@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "held-heading"}}) {
			@card.Content(card.ContentProps{}) {
				<h3 id="held-heading" class="cn-card-title">Rows needing attention</h3>
				{{ rows := attentionRows(data.Rows) }}
				if len(data.HeldRows) == 0 && len(rows) == 0 {
					<p class="text-muted-foreground">No candidate rows in this snapshot.</p>
				} else {
					<div class="table-scroll">
						@table.Table(table.Props{Class: "cn-table-compact", Attributes: templ.Attributes{"aria-label": "Row reasons"}}) {
							<thead>
								<tr><th>Worksheet row</th><th>Position</th><th>Recipient</th><th>State</th><th>Reason</th></tr>
							</thead>
							<tbody>
								for _, held := range data.HeldRows {
									<tr>
										<td>{ held.Row }</td>
										<td>{ held.Position }</td>
										<td>{ held.Recipient }</td>
										<td>Excluded at validation</td>
										<td>{ held.Reason }</td>
									</tr>
								}
								for _, row := range rows {
									<tr>
										<td>{ row.Row }</td>
										<td>{ row.Position }</td>
										<td>{ row.Recipient }</td>
										<td><code>{ row.State }</code></td>
										<td>{ row.Reason }</td>
									</tr>
								}
							</tbody>
						}
					</div>
				}
				if data.RoleMapping {
					<p class="text-sm text-muted-foreground">Review and correct the selected prepared data, then upload an edited final sheet or prepare a new version.</p>
				} else {
					<p class="text-sm text-muted-foreground">Corrected data is uploaded as a new task; this saved snapshot is never edited in place.</p>
				}
			}
		}
	</section>
}

// taskRevalidateNotice states the saved/current revision difference for any
// task whose pinned revision no longer matches the campaign's current content.
// Recipients owns the remedy: navigation alone never rebuilds the snapshot.
templ taskRevalidateNotice(data TaskPageData) {
	if data.Stale {
		@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
			@alert.Title(alert.TitleProps{}) {
				The campaign content changed after this task was validated
			}
			@alert.Description(alert.DescriptionProps{}) {
				if data.ScheduleState == "scheduled" {
					<p>Clear the scheduled start first, then revalidate against Revision { data.CurrentRevision }. The old schedule must not authorize revised content.</p>
				} else {
					<p>Revalidate this task to rebuild the snapshot against Revision { data.CurrentRevision }.</p>
				}
				<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/revalidate" }>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeSm, Disabled: data.ScheduleState == "scheduled"}) {
						Revalidate with current template
					}
				</form>
			}
		}
	}
}

// taskHeldEntries is the canonical actionable list of held entries with every
// recorded reason.
templ taskHeldEntries(label string, rows []TaskFinalReviewExclusion) {
	@taskReviewList(label) {
		@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": label}}) {
			<thead><tr><th>Source row</th><th>Position</th><th>Recipient</th><th>Reason</th></tr></thead>
			<tbody>
				for _, row := range rows {
					<tr><td>{ row.Row }</td><td>{ row.Position }</td><td>{ row.Recipient }</td><td>{ row.Reason }</td></tr>
				}
			</tbody>
		}
	}
}

// taskAcceptedEntries is the routine accepted list behind its disclosure.
templ taskAcceptedEntries(rows []TaskFinalReviewEntry) {
	@taskReviewList("Accepted recipients") {
		@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": "Accepted recipients"}}) {
			<thead><tr><th>Source row</th><th>Position</th><th>Accepted recipient</th></tr></thead>
			<tbody>
				for _, entry := range rows {
					<tr><td>{ entry.Row }</td><td>{ entry.Position }</td><td>{ entry.Recipient }</td></tr>
				}
			</tbody>
		}
	}
}

templ taskTest(data TaskPageData) {
	<section class="space-y-6" id="task-test" aria-labelledby="test-heading">
		<h2 id="test-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Test & approve</h2>
		if data.StoredStatus == "staging" {
			<p class="text-muted-foreground">Validate the workbook in <a class="app-link text-primary" href={ TaskSectionPath(data.CampaignID, data.TaskID, TaskSectionRecipients) }>Recipients</a> first. Candidate tests and approval are unavailable until the workbook has a validation snapshot.</p>
		} else if !data.DatasetFinalized && data.FinalizationRequired {
			@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
				<p>Finalize the sending data before sending a test for approval. A pre-finalization diagnostic cannot approve a final snapshot or authorize sending.</p>
				<a class="app-link text-primary" href={ TaskSectionPath(data.CampaignID, data.TaskID, TaskSectionRecipients) }>Review and finalize data</a>
			}
		} else {
			@taskApprovalSummary(data)
			if len(data.Rows) > 0 {
				if data.Approved {
					<details id="formatting-review" class="space-y-6" open?={ data.Error != "" }>
						<summary class={ "list-none cursor-pointer [&::-webkit-details-marker]:hidden", button.Variants(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) }>Change formatting</summary>
						<div class="space-y-6">
							<p class="text-sm text-muted-foreground">Your current approval stays valid while you review. To change the content, <a class="app-link text-primary" href={ CampaignSectionPath(data.CampaignID, CampaignSectionTemplate) }>create a template revision</a>, then revalidate an unstarted task and test the new configuration. Tasks that have started keep their saved revision.</p>
							@taskDiagnostics(data)
							@taskApprovalForm(data)
						</div>
					</details>
				} else {
					@taskDiagnostics(data)
					@taskApprovalForm(data)
				}
			}
		}
	</section>
}

templ taskApprovalSummary(data TaskPageData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "approval-summary-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-3"}) {
			<h3 id="approval-summary-heading" class="cn-card-title">Approval summary</h3>
			<p>Sending mailbox: <strong>{ data.Sender }</strong> ({ data.SenderStatus }) · Saved revision: { data.SavedRevision }</p>
			if data.DatasetFinalized {
				<p class="text-sm">Final snapshot <strong>{ data.FinalSnapshotRef }</strong> is accepted. Dataset approval does not approve formatting or authorize sending.</p>
			}
			if !data.DatasetFinalized {
				<p class="text-sm">Final snapshot: <strong>Not finalized</strong>.</p>
			}
			if data.Approved {
				<p class="text-success">Formatting approved for this exact final snapshot, saved revision and current mailbox generation.</p>
			}
			if !data.Approved {
				<p class="status-warning">Formatting is not approved for this exact final snapshot and current mailbox. A snapshot-specific test is required before candidate sending.</p>
				<p class="text-sm text-muted-foreground">A replacement final upload, a new campaign revision or a mailbox replacement invalidates approval; rotating settings on the same verified mailbox does not.</p>
			}
			<p>Recorded evidence: submitted test { data.LatestTest }. This task and snapshot only.</p>
			<details class="text-sm">
				<summary class="cursor-pointer text-muted-foreground">Content hash</summary>
				<p class="mt-2"><code class="break-all">{ data.Hash }</code></p>
			</details>
		}
	}
}

templ taskDiagnostics(data TaskPageData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "sending-test-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<h3 id="sending-test-heading" class="cn-card-title">Send formatting test</h3>
			<p class="text-muted-foreground max-w-[75ch] text-[.875rem]">Choose a valid sample row and enter the test address. Tests use a separate attempt and never submit a candidate or resume work.</p>
			<form id="sending-diagnostic-test" hx-preserve method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending/test" } class="space-y-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "test" }/>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-sample-row"}) {
						Sample row
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-sample-row", Name: "member_id", Required: true, Class: "w-full"}) {
						for _, row := range data.Rows {
							if row.State == "eligible" {
								@nativeselect.Option(nativeselect.OptionProps{Value: row.ID}) {
									Worksheet row { row.Row }
								}
							}
						}
					}
				}
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-test-address"}) {
						Test recipient
					}
					@input.Input(input.Props{ID: "sending-test-address", Type: "email", Name: "test_address", Required: true})
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ "Send formatting test" }
					}
				</div>
			</form>
		}
	}
}

templ taskApprovalForm(data TaskPageData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "sending-approval-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<h3 id="sending-approval-heading" class="cn-card-title">Approve received formatting</h3>
			<p>Select the qualifying submitted test, then confirm you received and checked its formatting.</p>
			<form id={ approvalFormID(data) } hx-preserve method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending/approve" } class="space-y-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "approve" }/>
				<input type="hidden" name="content_hash" value={ data.Hash }/>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-approval-attempt"}) {
						Successful diagnostic test
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-approval-attempt", Name: "attempt_id", Required: true, Class: "w-full"}) {
						<option value="">Choose a submitted test for this configuration</option>
						if data.LatestTest != "" {
							<option value={ data.LatestTest }>Latest successful test: { data.LatestTest }</option>
						}
						for _, outcome := range data.Recent {
							if outcome.Test && outcome.State == "submitted" && outcome.ID != data.LatestTest {
								<option value={ outcome.ID }>{ outcome.Recipient } · { outcome.Time } · { outcome.ID }</option>
							}
						}
					}
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-approve-received", Name: "received_checked", Value: "yes", Required: true})
					I received this test and checked its subject, personalized values and HTML formatting.
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ "Approve received formatting" }
					}
				</div>
			</form>
		}
	}
}

templ TaskSendingLive(data TaskPageData) {
	<div id="sending-live" class="space-y-6" { taskSendingPollAttributes(data)... }>
		<section class="space-y-4" aria-labelledby="sending-heading">
			<h2 id="sending-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Sending</h2>
			<div class="rounded-card border border-border bg-muted/50 p-4" aria-live="polite">
				<p class="font-semibold">{ data.StatusLabel }</p>
				<p class="text-sm text-muted-foreground">{ data.StatusExplanation }</p>
				<dl class="mt-3 grid grid-cols-3 gap-3 text-sm max-[760px]:grid-cols-2">
					<div><dt class="text-muted-foreground">Safe remaining</dt><dd class="text-xl font-bold">{ data.Remaining }</dd></div>
					<div><dt class="text-muted-foreground">Submitted</dt><dd class="text-xl font-bold">{ data.Submitted }</dd></div>
					<div><dt class="text-muted-foreground">Definite failures</dt><dd class="text-xl font-bold">{ data.RetryableFailed }</dd></div>
					<div><dt class="text-muted-foreground">Uncertain</dt><dd class="text-xl font-bold">{ data.Held }</dd></div>
					<div><dt class="text-muted-foreground">In flight</dt><dd class="text-xl font-bold">{ data.InFlight }</dd></div>
					<div><dt class="text-muted-foreground">Reserved</dt><dd class="text-xl font-bold">{ data.Reserved }</dd></div>
				</dl>
				<p class="mt-2 text-xs text-muted-foreground">Exclusions: invalid { data.Invalid }, duplicate { data.Duplicate }, ineligible { data.Ineligible }. Counts refresh before each action; changed exclusions require another confirmation.</p>
			</div>
			if data.StoredStatus == "staging" {
				<p class="text-muted-foreground">Validate the workbook in <a class="app-link text-primary" href={ TaskSectionPath(data.CampaignID, data.TaskID, TaskSectionRecipients) }>Recipients</a> first. Candidate actions and scheduling are unavailable until then.</p>
			} else {
				@taskSendingControls(data)
				@taskRecovery(data)
				@taskPacing(data)
			}
		</section>
	</div>
}

func taskSendingPollAttributes(data TaskPageData) templ.Attributes {
	if data.Closed {
		return nil
	}
	active := data.StoredStatus == "running" || data.StoredStatus == "waiting" || data.StoredStatus == "stopping"
	if !active && data.ScheduleState != "scheduled" && data.InFlight == 0 {
		return nil
	}
	return templ.Attributes{
		"hx-get":     sendingBase(data) + "/progress" + sendingChooserQuery(data.SendingType),
		"hx-trigger": "every 2s",
		"hx-swap":    "outerHTML",
	}
}

templ taskSendingControls(data TaskPageData) {
	{{ mode := taskSendingType(data) }}
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "controls-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h3 id="controls-heading" class="cn-card-title">
					switch  {
						case mode == TaskSendingTypeDirect:
							Direct sending
						case mode == TaskSendingTypeScheduled:
							Scheduled sending
						case taskCanChooseSendingType(data):
							Choose a sending type
						default:
							Sending controls
					}
				</h3>
				if taskCanChooseSendingType(data) && mode != "" {
					<a class="app-link text-primary text-sm" href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending?sending_type=choose" }>Change sending type</a>
				}
			</div>
			switch  {
				case taskCanChooseSendingType(data) && mode == "":
					<p class="text-sm text-muted-foreground">How should this task send? Your choice is saved for this task across the app. Changing it resets unsaved sending inputs; it does not send email or authorize a schedule.</p>
					if data.ScheduleState == "scheduled" || data.ScheduleState == "missed" {
						<p class="text-sm status-warning">Stored scheduled start: { data.ScheduleAt }. Clear this schedule before choosing Direct sending.</p>
					}
					<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending-type" } class="grid grid-cols-2 gap-4 max-[760px]:grid-cols-1">
						<button type="submit" name="sending_type" value={ TaskSendingTypeDirect } class="rounded-xl border border-border p-5 text-left space-y-2 cursor-pointer hover:border-primary hover:bg-accent/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							<span class="block font-semibold">Direct sending</span>
							<span class="block text-sm text-muted-foreground">Send when you confirm the current recipient count.</span>
							<span class="block text-sm font-semibold text-primary">Choose Direct →</span>
						</button>
						<button type="submit" name="sending_type" value={ TaskSendingTypeScheduled } class="rounded-xl border border-border p-5 text-left space-y-2 cursor-pointer hover:border-primary hover:bg-accent/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							<span class="block font-semibold">Scheduled sending</span>
							<span class="block text-sm text-muted-foreground">Choose a future date and time, then confirm the schedule.</span>
							<span class="block text-sm font-semibold text-primary">Choose Scheduled →</span>
						</button>
					</form>
					if data.Controls.ClearSchedule {
						@taskClearSchedule(data)
					}
				case mode == TaskSendingTypeScheduled:
					@taskSchedule(data)
				default:
					if !taskCanChooseSendingType(data) && data.StoredStatus != "ready" {
						<p class="text-sm text-muted-foreground">The initial sending type cannot be changed after this task has started or paused after a missed start. Use the available stop, resume or recovery controls.</p>
					}
					@taskSendingActions(data)
					if data.Controls.ClearSchedule {
						@taskClearSchedule(data)
					}
			}
		}
	}
}

templ taskSendingActions(data TaskPageData) {
	<p class="text-muted-foreground max-w-[75ch] text-[.875rem]">Sending requires approval of the saved content for the current mailbox and explicit confirmation of the fresh count. A validated task never starts by itself.</p>
	if data.ScheduleState == "missed" {
		@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
			@alert.Title(alert.TitleProps{}) {
				Missed scheduled start
			}
			@alert.Description(alert.DescriptionProps{}) {
				if data.StoredStatus == "ready" {
					<p>Stored start: { data.ScheduleAt }. This start did not run. Send now after fresh checks, or clear the schedule and choose a new one after resolving any blocker.</p>
				} else {
					<p>Stored start: { data.ScheduleAt }. This start was missed during downtime and the task is paused. Resume its safe remainder after fresh checks. Clearing the missed schedule leaves the task paused; a new first-start schedule is unavailable.</p>
				}
			}
		}
	}
	if data.ScheduleState == "scheduled" {
		<p class="text-sm">Scheduled start: <strong>{ data.ScheduleAt }</strong>. It remains active until you confirm Send now instead or cancel it below. Choosing a type alone does not change the schedule.</p>
	}
	<div class="flex flex-wrap gap-4 items-start [&>form]:min-w-0 [&_label]:text-sm">
		if data.Controls.Start && data.StoredStatus == "ready" {
			@sendingAction(data, "start", "Send now", data.Remaining)
		}
		if data.Controls.Resume {
			@sendingAction(data, "resume", "Resume safe remainder", data.Remaining)
		}
		if data.Controls.SendNowInstead && data.StoredStatus == "ready" {
			@sendingAction(data, "start", "Send now instead", data.Remaining)
		}
		if data.Controls.RetryAll {
			@sendingAction(data, "retry_all", "Retry failed recipients", data.RetryableFailed)
		}
		if data.Controls.Stop {
			<form id={ "sending-stop-" + data.StoredStatus + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/stop" }>
				<input type="hidden" name="action_id" value={ data.ActionID + "stop" }/>
				<input type="hidden" name="expected_count" value="0"/>
				<input type="hidden" name="confirmed" value="yes"/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "status-warning"}) {
					{ "Stop sending" }
				}
				if data.StoredStatus == "paused" || data.StoredStatus == "interrupted" {
					<p class="text-xs text-muted-foreground">Settles the task without launching more work; results become available after it stops.</p>
				}
			</form>
		}
	</div>
	if data.Controls.Revalidate {
		<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/revalidate" } class="space-y-2">
			<p class="text-sm status-warning">The saved snapshot differs from the current template.</p>
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Disabled: data.ScheduleState == "scheduled"}) {
				Revalidate with current template
			}
		</form>
	}
	if data.Controls.Start || data.Controls.Resume || data.Controls.SendNowInstead || data.Controls.RetryAll || data.Controls.Stop || data.Controls.Revalidate || data.Controls.Schedule || data.Controls.EditSchedule || data.Controls.ClearSchedule {
		if data.Remaining == 0 && data.RetryableFailed == 0 && data.Held == 0 && (data.Controls.Start || data.Controls.Resume) {
			<p class="text-sm status-warning">No currently eligible recipients remain. Review the exclusions and row reasons before any further action.</p>
		}
	} else if data.StoredStatus == "stopping" {
		<p>Stopping: no new sends while active requests settle.</p>
	} else if data.StoredStatus == "running" || data.StoredStatus == "waiting" {
		<p>Current progress is shown above with its wait reason when known.</p>
	} else {
		<p class="text-sm text-muted-foreground">No candidate action is applicable in this state.</p>
	}
	if data.CanClose {
		<form id={ "task-close-form-" + data.TaskID } method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/close" } class="pt-2">
			<input type="hidden" name="action_id" value={ data.ActionID + "close" }/>
			<input type="hidden" name="confirm_close" value="yes"/>
			@alertdialog.AlertDialog(alertdialog.Props{ID: "task-close-dialog"}) {
				@button.Button(button.Props{Variant: button.VariantDestructive, Attributes: alertdialog.Trigger(ctx)}) {
					Close task
				}
				@alertdialog.Content(alertdialog.ContentProps{}) {
					@alertdialog.Header(alertdialog.HeaderProps{}) {
						@alertdialog.Title(alertdialog.TitleProps{}) {
							Close this task permanently?
						}
						@alertdialog.Description(alertdialog.DescriptionProps{}) {
							<p>Closing is terminal. A closed task cannot be prepared, finalized, scheduled, tested, resumed, retried or resent. Queued work and enabled schedules are cancelled; in-flight requests settle first, and uncertain submissions stay uncertain.</p>
							<p class="mt-2">Attempts, approvals, resolutions, history and downloads stay available. Future processing requires a new task, and existing recipient-history checks still apply.</p>
						}
					}
					@alertdialog.Footer(alertdialog.FooterProps{}) {
						@alertdialog.Cancel(alertdialog.CancelProps{}) {
							Cancel
						}
						@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Attributes: templ.Attributes{"form": "task-close-form-" + data.TaskID}}) {
							Yes, close task
						}
					}
				}
			}
		</form>
	}
}

templ sendingAction(data TaskPageData, kind string, label string, count int) {
	<form id={ "sending-action-" + kind + "-" + strconv.Itoa(count) + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/" + kind } class="space-y-2">
		<input type="hidden" name="action_id" value={ data.ActionID + kind }/>
		<input type="hidden" name="expected_count" value={ strconv.Itoa(count) }/>
		<label class="block">
			@checkbox.Checkbox(checkbox.Props{ID: "sending-confirm-" + kind, Name: "confirmed", Value: "yes", Required: true})
			Confirm { count } recipients
		</label>
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !data.Approved || count == 0}) {
			{ label }
		}
	</form>
}

templ taskSchedule(data TaskPageData) {
	<div class="space-y-4">
		if data.ScheduleAt != "" {
			<p class="text-sm">Stored scheduled start: <strong>{ data.ScheduleAt }</strong> ({ data.ScheduleState }).</p>
		}
		<p class="text-sm text-muted-foreground">India time (+05:30) · At least 30 minutes from now. Saving authorizes a one-time start at your chosen time.</p>
		<details id="schedule-help" hx-preserve class="text-sm text-muted-foreground">
			<summary class="cursor-pointer text-primary">How scheduling works</summary>
			<div class="mt-2 max-w-[75ch] space-y-2">
				<p>The saved schedule starts without another confirmation. Only recipients still eligible at that time are included.</p>
				<p>If the scheduled time passes while the server is offline, the task pauses for review instead of sending automatically when it restarts.</p>
				<p>Changing sending type resets unsaved input. A saved schedule stays active until you explicitly clear or replace it.</p>
			</div>
		</details>
		if data.Stale {
			<p class="text-sm status-warning">Clear the existing schedule before revalidating against the current template.</p>
		}
		if data.ScheduleState == "missed" {
			<p class="text-sm status-warning">This scheduled start was missed. Clear it before choosing a new schedule or switching to Direct sending.</p>
		}
		if data.Controls.Schedule || data.Controls.EditSchedule {
			<form id={ "sending-schedule-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/schedule" } x-data={ "{ confirmed: false, eligible: " + strconv.FormatBool(data.Approved && data.Remaining > 0) + " }" } x-on:change="if ($event.target.matches('input[name=confirmed]')) confirmed = $event.target.checked" class="space-y-4">
				<input type="hidden" name="action_id" value={ data.ActionID + "schedule" }/>
				<input type="hidden" name="expected_count" value={ strconv.Itoa(data.Remaining) }/>
				<div class="flex flex-wrap items-start gap-4">
					@field.Field(field.Props{Class: "w-full max-w-56"}) {
						@field.Label(field.LabelProps{For: "sending-schedule-time"}) {
							Start time (India time)
						}
						@input.Input(input.Props{ID: "sending-schedule-time", Type: "time", Name: "schedule_time", Required: true, Value: data.ScheduleDraftTime, Attributes: templ.Attributes{"step": "60"}})
					}
					@field.Field(field.Props{Class: "w-full max-w-56"}) {
						@field.Label(field.LabelProps{For: "sending-schedule-date"}) {
							Start date
						}
						@input.Input(input.Props{ID: "sending-schedule-date", Type: "date", Name: "schedule_date", Required: true, Value: data.ScheduleDraftDate, Attributes: templ.Attributes{"min": data.ScheduleMinDate}})
					}
				</div>
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-schedule-confirm", Name: "confirmed", Value: "yes", Required: true})
					I confirm the fresh counts for this scheduled start.
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit, Disabled: true, Attributes: templ.Attributes{"name": "schedule_action", "value": "enable", "x-bind:disabled": "!confirmed || !eligible"}}) {
						{ "Schedule start" }
					}
				</div>
			</form>
		}
		if data.Controls.ClearSchedule {
			@taskClearSchedule(data)
		}
	</div>
}

templ taskClearSchedule(data TaskPageData) {
	<form id={ "sending-schedule-clear-" + data.ScheduleState + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/schedule" } class="space-y-2 border-t border-border pt-4">
		<input type="hidden" name="action_id" value={ data.ActionID + "scheduleclear" }/>
		@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Attributes: templ.Attributes{"name": "schedule_action", "value": "clear"}}) {
			if taskCanChooseSendingType(data) && taskSendingType(data) == TaskSendingTypeDirect {
				Cancel schedule and use direct sending
			} else {
				Clear schedule
			}
		}
		<p class="text-xs text-muted-foreground">Cancels only the scheduled start; no email is sent. Clearing a missed schedule never resumes sending or erases a recorded pause reason.</p>
	</form>
}

templ taskRecovery(data TaskPageData) {
	if sendingHasRecovery(data.Rows) || data.Held > 0 {
		<section class="space-y-4" id="task-recovery" aria-labelledby="recovery-heading" x-data="{ retry: [], review: [] }">
			<h3 id="recovery-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Recovery</h3>
			@card.Card(card.Props{}) {
				@card.Content(card.ContentProps{Class: "gap-4"}) {
					<p class="text-sm text-muted-foreground">Definite failures can be retried; uncertain outcomes need review. Manual resolution records external verification and never submits email.</p>
					@taskRecoveryBulk(data)
					<div class="table-scroll">
						@table.Table(table.Props{Class: "cn-table-compact", Attributes: templ.Attributes{"aria-label": "Recovery rows"}}) {
							@table.Header(table.HeaderProps{}) {
								@table.Row(table.RowProps{}) {
									@table.Head(table.HeadProps{Class: "w-8"}) {
										<span class="sr-only">Select</span>
									}
									@table.Head(table.HeadProps{}) {
										{ "Recipient" }
									}
									@table.Head(table.HeadProps{}) {
										{ "State" }
									}
									@table.Head(table.HeadProps{}) {
										{ "Reason" }
									}
									@table.Head(table.HeadProps{}) {
										{ "Prior attempt" }
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										{ "Action" }
									}
								}
							}
							@table.Body(table.BodyProps{}) {
								for _, row := range data.Rows {
									if taskRowNeedsRecovery(row) {
										@taskRecoveryRow(data, row)
									}
								}
							}
						}
					</div>
				}
			}
		</section>
	}
}

// taskRecoveryBulk renders the selection-scoped actions. Alpine keeps the
// selected member ids; the forms stay native posts so a submission is one
// atomic request against the confirmed count.
templ taskRecoveryBulk(data TaskPageData) {
	<div hidden x-bind:hidden="retry.length === 0 && review.length === 0" class="space-y-4 rounded-card border border-border bg-muted/50 p-4">
		<div class="flex flex-wrap items-baseline gap-2">
			<p class="font-semibold">Bulk actions</p>
			<p class="text-sm text-muted-foreground"><span x-text="retry.length + review.length">0</span> selected. Counts refresh before each action; a changed selection is refused.</p>
		</div>
		if data.Controls.RetryRow {
			<form id={ "sending-retry-selected-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/retry" } x-bind:hidden="retry.length === 0" class="space-y-3 border-t border-border pt-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "retryselected" }/>
				<input type="hidden" name="expected_count" x-bind:value="retry.length"/>
				<template x-for="id in retry" x-bind:key="id">
					<input type="hidden" name="member_id" x-bind:value="id"/>
				</template>
				<p class="text-sm">Retry <span class="font-semibold" x-text="retry.length">0</span> definite failures using their unchanged snapshots.</p>
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-retry-selected-confirm", Name: "confirmed", Value: "yes", Required: true})
					Retry every selected definite failure.
				}
				@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: !data.Approved, Size: button.SizeSm}) {
					{ "Retry selected" }
				}
			</form>
		}
		if data.Controls.ResendRow {
			<form id={ "sending-resend-selected-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/resend" } x-bind:hidden="review.length === 0" class="space-y-3 border-t border-border pt-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "resendselected" }/>
				<input type="hidden" name="expected_count" x-bind:value="review.length"/>
				<template x-for="id in review" x-bind:key="id">
					<input type="hidden" name="member_id" x-bind:value="id"/>
				</template>
				<p class="text-sm">Send <span class="font-semibold" x-text="review.length">0</span> selected uncertain recipients again. Each earlier request may have been accepted, so this can create duplicates.</p>
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-selected-duplicate", Name: "duplicate_risk", Value: "yes", Required: true})
					The earlier requests may have been accepted. Sending again can create duplicates.
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-selected-confirm", Name: "confirmed", Value: "yes", Required: true})
					Confirm sending these recipients again.
				}
				@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: !data.Approved, Size: button.SizeSm, Class: "status-warning"}) {
					{ "Send again selected" }
				}
			</form>
		}
		if data.Controls.ResolveRow {
			<form id={ "sending-resolve-selected-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/resolve" } x-bind:hidden="review.length === 0" class="space-y-3 border-t border-border pt-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "resolvesselected" }/>
				<input type="hidden" name="expected_count" x-bind:value="review.length"/>
				<template x-for="id in review" x-bind:key="id">
					<input type="hidden" name="member_id" x-bind:value="id"/>
				</template>
				<p class="text-sm">Mark <span class="font-semibold" x-text="review.length">0</span> selected uncertain recipients as already submitted after external verification. This records no provider acceptance timestamp and never submits email.</p>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-resolution-basis-selected"}) {
						Basis for resolution
					}
					@input.Input(input.Props{ID: "sending-resolution-basis-selected", Name: "basis", Required: true, Attributes: templ.Attributes{"maxlength": "500"}})
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resolve-selected-confirm", Name: "confirmed", Value: "yes", Required: true})
					I verified these recipients were already submitted.
				}
				@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ "Mark selected already submitted" }
				}
			</form>
		}
	</div>
}

templ taskRecoveryRow(data TaskPageData, row TaskAdmittedRow) {
	@table.Row(table.RowProps{}) {
		@table.Cell(table.CellProps{}) {
			if recoveryCanRetry(row, data.Controls) {
				@checkbox.Checkbox(checkbox.Props{ID: "recovery-select-" + row.ID, Value: row.ID, Class: "align-middle", Attributes: templ.Attributes{"aria-label": recoverySelectLabel(row)}, InputAttributes: templ.Attributes{"x-model": "retry"}})
			} else if recoveryCanReview(row, data.Controls) {
				@checkbox.Checkbox(checkbox.Props{ID: "recovery-select-" + row.ID, Value: row.ID, Class: "align-middle", Attributes: templ.Attributes{"aria-label": recoverySelectLabel(row)}, InputAttributes: templ.Attributes{"x-model": "review"}})
			}
		}
		@table.Cell(table.CellProps{Class: "w-[18rem] max-w-[18rem] whitespace-normal!"}) {
			<div class="space-y-0.5">
				if row.Recipient != "" {
					<p class="font-medium wrap-anywhere">{ row.Recipient }</p>
				}
				<p class="text-xs text-muted-foreground">Worksheet row { row.Row } · recipient { row.Position }</p>
			</div>
		}
		@table.Cell(table.CellProps{Class: "whitespace-nowrap!"}) {
			@badge.Badge(recoveryStateBadge(row.State)) {
				{ recoveryStateLabel(row.State) }
			}
		}
		@table.Cell(table.CellProps{Class: "max-w-[18rem] whitespace-normal!"}) {
			<p class="text-sm wrap-anywhere">{ row.Reason }</p>
		}
		@table.Cell(table.CellProps{Class: "max-w-[16rem] whitespace-normal!"}) {
			if row.AttemptID != "" {
				<div class="space-y-0.5 text-xs text-muted-foreground">
					<p class="wrap-anywhere"><code>{ row.AttemptID }</code></p>
					<p>{ row.AttemptState } · { row.AttemptTime }</p>
					if row.AttemptReason != "" {
						<p class="wrap-anywhere">{ row.AttemptReason }</p>
					}
				</div>
			} else {
				<p class="text-xs text-muted-foreground">No recorded attempt</p>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right align-top!"}) {
			@taskRecoveryRowActions(data, row)
		}
	}
}

templ taskRecoveryRowActions(data TaskPageData, row TaskAdmittedRow) {
	<div class="flex flex-col items-end gap-2">
		if recoveryCanRetry(row, data.Controls) {
			@recoveryRetryDialog(data, row)
		}
		if recoveryCanReview(row, data.Controls) {
			if data.Controls.ResendRow {
				@recoveryResendDialog(data, row)
			}
			if data.Controls.ResolveRow {
				@recoveryResolveDialog(data, row)
			}
		}
		if hint := recoveryActionHint(data, row); hint != "" {
			<p class="text-xs text-muted-foreground">{ hint }</p>
		}
	</div>
}

templ recoveryRetryDialog(data TaskPageData, row TaskAdmittedRow) {
	@dialog.Dialog(dialog.Props{ID: "recovery-retry-" + row.ID}) {
		@button.Button(button.Props{Variant: button.VariantSecondary, Size: button.SizeSm, Attributes: dialog.Trigger(ctx)}) {
			{ "Retry" }
		}
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					{ "Retry worksheet row " + strconv.Itoa(row.Row) }
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ "A new attempt uses the unchanged snapshot and this mailbox's pacing. The earlier attempt stays in history." }
				}
			}
			@recoveryPriorAttempt(row)
			<form id={ "sending-retry-" + row.ID + "-" + row.State + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/retry" } class="space-y-3">
				@sendingRowFields(data, row)
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-retry-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
					Retry this 1 definite failure using its unchanged snapshot.
				}
				@dialog.Footer(dialog.FooterProps{}) {
					@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: !data.Approved}) {
						{ "Retry" }
					}
				}
			</form>
		}
	}
}

templ recoveryResendDialog(data TaskPageData, row TaskAdmittedRow) {
	@dialog.Dialog(dialog.Props{ID: "recovery-resend-" + row.ID}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "status-warning", Attributes: dialog.Trigger(ctx)}) {
			{ "Send again" }
		}
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					{ "Send worksheet row " + strconv.Itoa(row.Row) + " again" }
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ "The earlier request may have been accepted. Sending again can create a duplicate; the uncertain attempt is kept." }
				}
			}
			@recoveryPriorAttempt(row)
			<form id={ "sending-resend-" + row.ID + "-" + row.State + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/resend" } class="space-y-3">
				@sendingRowFields(data, row)
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-duplicate-" + row.ID, Name: "duplicate_risk", Value: "yes", Required: true})
					The earlier request may have been accepted. Sending again can create a duplicate.
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
					Confirm sending this 1 recipient again.
				}
				@dialog.Footer(dialog.FooterProps{}) {
					@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: !data.Approved, Class: "status-warning"}) {
						{ "Send again — duplicate risk" }
					}
				}
			</form>
		}
	}
}

templ recoveryResolveDialog(data TaskPageData, row TaskAdmittedRow) {
	@dialog.Dialog(dialog.Props{ID: "recovery-resolve-" + row.ID}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: dialog.Trigger(ctx)}) {
			{ "Mark already submitted" }
		}
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header(dialog.HeaderProps{}) {
				@dialog.Title(dialog.TitleProps{}) {
					{ "Resolve worksheet row " + strconv.Itoa(row.Row) }
				}
				@dialog.Description(dialog.DescriptionProps{}) {
					{ "Records the operator, basis and resolution time after external verification. It does not invent a Microsoft acceptance timestamp." }
				}
			}
			@recoveryPriorAttempt(row)
			<form id={ "sending-resolve-" + row.ID + "-" + row.State + "-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/resolve" } class="space-y-3">
				@sendingRowFields(data, row)
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-resolution-basis-" + row.ID}) {
						Basis for resolution
					}
					@input.Input(input.Props{ID: "sending-resolution-basis-" + row.ID, Name: "basis", Required: true, Attributes: templ.Attributes{"maxlength": "500"}})
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-resolve-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
					I verified this recipient was already submitted.
				}
				@dialog.Footer(dialog.FooterProps{}) {
					@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit}) {
						{ "Mark already submitted" }
					}
				}
			</form>
		}
	}
}

templ recoveryPriorAttempt(row TaskAdmittedRow) {
	if row.AttemptID != "" {
		<div class="space-y-1 rounded-2xl bg-muted p-3 text-xs text-muted-foreground">
			<p class="font-medium text-foreground">Prior attempt</p>
			<p class="wrap-anywhere"><code>{ row.AttemptID }</code></p>
			<p class="wrap-anywhere">{ row.AttemptRecipient } · { row.AttemptState } · { row.AttemptTime }</p>
			if row.AttemptReason != "" {
				<p class="wrap-anywhere">{ row.AttemptReason }</p>
			}
		</div>
	}
}

templ sendingRowFields(data TaskPageData, row TaskAdmittedRow) {
	<input type="hidden" name="action_id" value={ data.ActionID + "row" + row.ID }/>
	<input type="hidden" name="member_id" value={ row.ID }/>
	<input type="hidden" name="expected_count" value="1"/>
}

templ taskPacing(data TaskPageData) {
	@accordion.Accordion(accordion.Props{ID: "sending-settings", Class: "rounded-4xl", Attributes: templ.Attributes{"data-workspace-persist": true}}) {
		@accordion.Item(accordion.ItemProps{ID: "sending-settings-item", Value: "pacing", Class: "data-open:bg-transparent"}) {
			@accordion.Trigger(accordion.TriggerProps{Class: "p-5 font-semibold hover:no-underline"}) {
				Sending settings
			}
			@accordion.Content(accordion.ContentProps{Class: "space-y-5 px-1 pb-5"}) {
				<p class="text-sm text-muted-foreground">Control how quickly this mailbox starts emails across all tasks, formatting tests and retries.</p>
				<dl class="grid grid-cols-3 gap-3 max-[760px]:grid-cols-1">
					<div class="rounded-2xl bg-muted p-4">
						<dt class="text-xs text-muted-foreground">Current pacing</dt>
						<dd class="mt-1 font-semibold"><span id="sending-current-rate">{ data.Rate }</span> <span class="text-sm font-normal text-muted-foreground">starts / minute</span></dd>
					</div>
					<div class="rounded-2xl bg-muted p-4">
						<dt class="text-xs text-muted-foreground">Concurrent submissions</dt>
						<dd class="mt-1 font-semibold">Up to 4 <span class="text-sm font-normal text-muted-foreground">in flight</span></dd>
					</div>
					<div class="rounded-2xl bg-muted p-4">
						<dt class="text-xs text-muted-foreground">Mailbox cooldown</dt>
						<dd class="mt-1 text-sm font-semibold wrap-break-word">
							if data.Cooldown != "" {
								Until { data.Cooldown }
							} else {
								No active cooldown
							}
						</dd>
						if data.CooldownReason != "" {
							<p class="mt-2 text-xs text-muted-foreground">{ data.CooldownReason }</p>
						}
					</div>
				</dl>
				<form id={ "sending-rate-" + sendingControlKey(data) } hx-preserve method="post" action={ sendingBase(data) + "/rate" } class="flex flex-col items-start gap-3">
					<input type="hidden" name="action_id" value={ data.ActionID + "rate" }/>
					<div class="min-w-0 w-full max-w-sm space-y-2">
						@field.Field(field.Props{}) {
							@field.Label(field.LabelProps{For: "sending-rate"}) {
								Starts per minute
							}
							<p id="sending-rate-help" class="text-xs text-muted-foreground">Choose 1–30. Default: 25. Applies to this mailbox.</p>
							@input.Input(input.Props{ID: "sending-rate", Name: "rate", Type: "number", Class: "w-full", Value: strconv.Itoa(data.Rate), Required: true, Attributes: templ.Attributes{"min": "1", "max": "30", "step": "1", "aria-describedby": "sending-rate-help"}})
						}
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "shrink-0"}) {
						Update pacing
					}
				</form>
				<p class="text-xs text-muted-foreground">Pacing and cooldown are shared by this mailbox only. Other mail clients also consume provider capacity, which this app cannot track.</p>
				<div class="grid grid-cols-2 gap-4 border-t border-border pt-4 text-xs text-muted-foreground max-[760px]:grid-cols-1">
					<p><strong class="font-medium text-foreground">Delivery status:</strong> Submitted means the provider accepted the request; it does not confirm delivery.</p>
					<p><strong class="font-medium text-foreground">Background sending:</strong> Closing the browser does not stop server work.</p>
				</div>
			}
		}
	}
}

templ taskResults(data TaskPageData) {
	<section class="space-y-6" id="task-results" aria-labelledby="results-heading">
		<h2 id="results-heading" class="font-bold text-[1.2rem] tracking-[-.02em]">Results</h2>
		@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "results-workbook-heading"}}) {
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h3 id="results-workbook-heading" class="cn-card-title">Results workbook</h3>
				if len(data.ResultLabels) > 0 {
					<p class="text-sm text-muted-foreground">Result columns: { joinLabels(data.ResultLabels) }</p>
				}
				if data.ResultsReady {
					<p>The workbook keeps every original worksheet, row, formula and value, and adds a separate “Recipient results” sheet. That sheet copies the source columns and adds the source worksheet, original row, position in the recipient cell, the individual recipient and the result columns, one row per expanded entry.</p>
					<p class="text-sm">As of { data.ResultsAsOf }. This is a saved snapshot; sending resumed after it would need a refreshed workbook.</p>
					<div class="app-card-actions">
						<a class={ button.Variants(button.Props{Variant: button.VariantDefault, Size: button.SizeDefault}) } href={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results.xlsx" }>Download results workbook</a>
						if data.ResultEligible {
							<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeDefault}) {
									Regenerate results
								}
							</form>
						}
						<form id="task-results-delete-form" method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results/delete" }>
							@alertdialog.AlertDialog(alertdialog.Props{ID: "task-results-delete"}) {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeDefault, Attributes: alertdialog.Trigger(ctx)}) {
									Remove generated file
								}
								@alertdialog.Content(alertdialog.ContentProps{}) {
									@alertdialog.Header(alertdialog.HeaderProps{}) {
										@alertdialog.Title(alertdialog.TitleProps{}) {
											Remove this generated workbook?
										}
										@alertdialog.Description(alertdialog.DescriptionProps{}) {
											This deletes only the generated file. The original workbook, attempt history and candidate eligibility stay intact, and results can be generated again.
										}
									}
									@uilabel.Label(uilabel.Props{Class: "cursor-pointer justify-start gap-3"}) {
										@checkbox.Checkbox(checkbox.Props{ID: "task-results-delete-confirm", Name: "confirm", Value: "delete", Required: true, Form: "task-results-delete-form"})
										<span>I understand only the generated workbook is removed.</span>
									}
									@alertdialog.Footer(alertdialog.FooterProps{}) {
										@alertdialog.Cancel(alertdialog.CancelProps{}) {
											Cancel
										}
										@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Attributes: templ.Attributes{"form": "task-results-delete-form"}}) {
											Remove generated workbook
										}
									}
								}
							}
						</form>
					</div>
				} else if data.ResultsState == "pending" || data.ResultsState == "generating" {
					<p>Preparing results. The background worker builds the file; no incomplete download is offered.</p>
				} else if data.ResultsState == "failed" {
					if data.ResultsError != "" {
						@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
							{ data.ResultsError }
						}
					}
					<p>The last generation did not finish. Retrying rebuilds the file from retained records and never sends or retries email.</p>
					if data.Controls.RetryResult {
						<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results" }>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
								Retry result generation
							}
						</form>
					}
				} else if data.ResultEligible {
					<p>No workbook is published yet. Generate it from retained records; this never sends or retries email.</p>
					if data.Controls.GenerateResult {
						<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/results" }>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault, Size: button.SizeDefault}) {
								Generate results workbook
							}
						</form>
					}
				} else {
					<p>Results are not available yet. Automatic generation follows completion, a settled stop or a recovered interruption.</p>
					if data.StoredStatus == "stopping" {
						<p class="text-sm text-muted-foreground">Stopping: active outcomes must settle before the workbook is built.</p>
					}
					<p class="text-sm text-muted-foreground">Current status: { data.StatusLabel }. Any recorded attempts are listed below.</p>
				}
			}
		}
		@taskAttemptHistory(data)
	</section>
}

templ taskAttemptHistory(data TaskPageData) {
	<section aria-labelledby="task-history-trigger">
		@accordion.Accordion(accordion.Props{ID: "task-results-history", Class: "rounded-4xl", Attributes: templ.Attributes{"data-workspace-persist": true}}) {
			@accordion.Item(accordion.ItemProps{ID: "task-history", Value: "history", Class: "data-open:bg-transparent"}) {
				@accordion.Trigger(accordion.TriggerProps{Class: "p-5 font-semibold hover:no-underline"}) {
					Task history
				}
				@accordion.Content(accordion.ContentProps{Class: "space-y-3 pb-5"}) {
					<p class="text-sm text-muted-foreground">Times use India time (+05:30). “Submitted” means the provider accepted the request; it does not confirm delivery. Tests are kept separate from candidate totals.</p>
					@scrollarea.ScrollArea(scrollarea.Props{Class: "[&_[data-slot=scroll-area-viewport]]:h-auto [&_[data-slot=scroll-area-viewport]]:max-h-[min(28rem,60vh)]"}) {
						@item.Group(item.GroupProps{Class: "p-1 pr-3"}) {
							if len(data.Recent) == 0 && len(data.Resolutions) == 0 {
								@item.Item(item.Props{}) {
									@item.Content(item.ContentProps{}) {
										@item.Description(item.DescriptionProps{}) {
											No attempts recorded for this task yet.
										}
									}
								}
							}
							for _, outcome := range data.Recent {
								@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
									@item.Content(item.ContentProps{}) {
										@item.Title(item.TitleProps{}) {
											{ outcome.Time } · { outcome.Kind } · { outcome.Recipient }
										}
										@item.Description(item.DescriptionProps{}) {
											{ outcome.State } · { outcome.Reason }
										}
									}
								}
							}
							for _, resolution := range data.Resolutions {
								@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
									@item.Content(item.ContentProps{}) {
										@item.Title(item.TitleProps{}) {
											{ resolution.Time } · Worksheet row { resolution.Row } marked already submitted
										}
										@item.Description(item.DescriptionProps{}) {
											Basis: { resolution.Basis } · Recorded by { resolution.Actor }
										}
									}
								}
							}
						}
					}
				}
			}
		}
	</section>
}

// TaskPreviewData is the view model for the preview partial. The error is a
// fixed operator-facing message shown instead of rendered content.
type TaskPreviewData struct {
	Error             string
	Recipient         string
	Subject           string
	Body              string
	Values            []PreviewValue
	SourceRow         int
	RecipientPosition int
	OriginalRecipient string
	ContentHash       string
	Approved          bool
	// DatasetFinalized distinguishes an accepted final snapshot preview from
	// prepared values that cannot approve or authorize sending.
	DatasetFinalized bool
	Loading          bool
}

templ TaskPreviewResult(data TaskPreviewData) {
	<div class="p-[1.1rem] border border-border rounded-4xl bg-muted space-y-4">
		if data.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.Error }
			}
			<p class="text-sm">Choose another row, or review the row reasons above.</p>
		} else if data.SourceRow == 0 {
			<p class="text-muted-foreground">No previewable row is selected.</p>
		} else {
			if data.DatasetFinalized {
				<p class="text-sm text-success">Accepted final snapshot · this is the email content used for a selected-row test and candidate sending.</p>
			} else {
				<p class="text-sm status-warning">Prepared values · not a final email preview. Finalize the dataset before using these values for a test or sending.</p>
			}
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">To</p>
				<p class="font-semibold">{ data.Recipient }</p>
			</div>
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Subject</p>
				<p class="font-semibold">{ data.Subject }</p>
			</div>
			<div class="space-y-1">
				<p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Body</p>
				<div class="rounded-card border border-border p-4 leading-[1.65] wrap-anywhere [&_p+p]:mt-[1em] [&_h1]:mt-[1em] [&_h1]:mb-[.5em] [&_h1]:text-[1.75rem]! [&_h2]:mt-[1em] [&_h2]:mb-[.5em] [&_h2]:text-[1.4rem]! [&_h2]:font-bold [&_h3]:mt-[1em] [&_h3]:mb-[.5em] [&_h3]:text-[1.15rem]! [&_h3]:font-bold [&_ul]:list-disc [&_ul]:pl-[1.5em] [&_ol]:list-decimal [&_ol]:pl-[1.5em] [&_a]:text-primary [&_a]:underline">
					@templ.Raw(data.Body)
				</div>
			</div>
			<details class="text-sm">
				<summary class="cursor-pointer text-muted-foreground">Preview details</summary>
				<dl class="mt-2 space-y-1">
					<div class="flex gap-2"><dt class="font-semibold">Worksheet row:</dt><dd>{ data.SourceRow }</dd></div>
					<div class="flex gap-2"><dt class="font-semibold">Position in recipient cell:</dt><dd>{ data.RecipientPosition }</dd></div>
					<div class="flex gap-2"><dt class="font-semibold">Original recipient cell:</dt><dd><code class="break-all">{ data.OriginalRecipient }</code></dd></div>
					<div class="flex gap-2"><dt class="font-semibold">Content hash:</dt><dd><code class="break-all">{ data.ContentHash }</code></dd></div>
					if data.DatasetFinalized {
						<div class="flex gap-2">
							<dt class="font-semibold">Formatting approval:</dt>
							<dd>
								@revisionState(true, data.Approved)
							</dd>
						</div>
					}
				</dl>
				<div class="table-scroll mt-2">
					@table.Table(table.Props{Class: "cn-table-compact"}) {
						<thead><tr><th>Variable</th><th>Source header</th><th>Raw value</th><th>Used value</th></tr></thead>
						<tbody>
							for _, value := range data.Values {
								<tr><td>{ value.Variable }</td><td><code>{ value.Header }</code></td><td><code>{ value.Raw }</code></td><td><code>{ value.Normalized }</code></td></tr>
							}
						</tbody>
					}
				</div>
			</details>
		}
	</div>
}

// taskInitialSection selects the rendered panel. An error keeps its own
// section so the message can never be hidden behind another one.
func taskInitialSection(data TaskPageData) string {
	switch {
	case data.Error != "" || data.ValidationError != "":
		if data.Section != "" {
			return data.Section
		}
		return TaskSectionRecipients
	case data.Section != "":
		return data.Section
	default:
		return TaskSectionOverview
	}
}

// taskCanChooseSendingType limits the chooser to existing first-start controls.
func taskCanChooseSendingType(data TaskPageData) bool {
	return data.StoredStatus == "ready" && (data.Controls.Start || data.Controls.Schedule || data.Controls.EditSchedule || data.Controls.SendNowInstead || data.Controls.ClearSchedule)
}

func taskSendingType(data TaskPageData) string {
	if !taskCanChooseSendingType(data) {
		return ""
	}
	switch data.SendingType {
	case TaskSendingTypeDirect, TaskSendingTypeScheduled:
		return data.SendingType
	case "":
		if data.ScheduleState == "scheduled" || data.ScheduleState == "missed" {
			return TaskSendingTypeScheduled
		}
	}
	return ""
}

// Only the transient editor is URL state; the selected type is stored on task.
func sendingChooserQuery(value string) string {
	if value == TaskSendingTypeChoose {
		return "?sending_type=choose"
	}
	return ""
}

// sendingBase is the existing mutation base for this task.
func sendingBase(data TaskPageData) string {
	return "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/sending"
}

// sendingControlKey changes whenever a fact relevant to a confirmation changes,
// so a stale checkbox is discarded even when the numeric count is unchanged.
func sendingControlKey(data TaskPageData) string {
	key := data.StoredStatus + "-" + strconv.FormatBool(data.Approved) + "-" + strconv.Itoa(data.Remaining) + "-" + strconv.Itoa(data.Submitted) + "-" + strconv.Itoa(data.Failed) + "-" + strconv.Itoa(data.Held) + "-" + strconv.Itoa(data.InFlight) + "-" + strconv.Itoa(data.Reserved) + "-" + strconv.Itoa(data.Invalid) + "-" + strconv.Itoa(data.Duplicate) + "-" + strconv.Itoa(data.Ineligible) + "-" + data.ScheduleState + "-" + data.Hash + "-" + data.Sender + "-" + data.SenderStatus + "-" + data.SendingType
	// htmx restores hx-preserve elements using CSS ID selectors. Encoding keeps
	// mailbox/hash punctuation safe without discarding changes to their values.
	return hex.EncodeToString([]byte(key))
}

// approvalFormID names the approval form by the content hash, the latest test
// and the approval state, so a changed configuration or a fresh test discards a
// stale confirmation. Only selector-safe characters are kept.
func approvalFormID(data TaskPageData) string {
	raw := "sending-approval-" + data.Hash + "-" + data.LatestTest + "-" + strconv.FormatBool(data.Approved) + "-" + data.Sender
	safe := make([]byte, 0, len(raw))
	for i := 0; i < len(raw); i++ {
		switch r := raw[i]; {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
			safe = append(safe, r)
		}
	}
	return string(safe)
}

// taskRowNeedsRecovery reports whether one membership row belongs in the
// recovery groups.
func taskRowNeedsRecovery(row TaskAdmittedRow) bool {
	switch row.State {
	case "definite_failure", "failed", "auth_failure", "correction_required", "manually_submitted", "review_required":
		return true
	default:
		return false
	}
}

// recoveryCanRetry mirrors the store's retry eligibility: definite failures
// only, and only when the task offers the per-row retry control.
func recoveryCanRetry(row TaskAdmittedRow, controls TaskControls) bool {
	switch row.State {
	case "manually_submitted", "correction_required", "review_required":
		return false
	}
	return controls.RetryRow
}

// recoveryCanReview reports whether a row offers the uncertain-outcome
// controls. Both bulk actions share the same selection because one uncertain
// row is resolved or resent, never both.
func recoveryCanReview(row TaskAdmittedRow, controls TaskControls) bool {
	return row.State == "review_required" && (controls.ResendRow || controls.ResolveRow)
}

// recoveryActionHint explains an action cell that has no control, so a gated
// recovery row never renders blank. An empty result means an action is shown.
func recoveryActionHint(data TaskPageData, row TaskAdmittedRow) string {
	switch row.State {
	case "correction_required":
		return "Upload a corrected task to send this row."
	case "manually_submitted":
		return "Marked already submitted after external verification."
	}
	if recoveryCanRetry(row, data.Controls) || recoveryCanReview(row, data.Controls) {
		return ""
	}
	if data.RestoreReview {
		return "Restore review is active; reconcile recorded submissions before acting on this row."
	}
	if !taskStatusSettled(data.StoredStatus) {
		return "Available after the active sending work settles."
	}
	if row.State == "review_required" {
		return "Send again and Mark already submitted are unavailable for this task."
	}
	return "This row is no longer retryable; reload the task."
}

// taskStatusSettled mirrors presentation's settled states: retry and resend are
// withheld until active work stops launching.
func taskStatusSettled(status string) bool {
	switch status {
	case "paused", "interrupted", "stopped", "completed":
		return true
	default:
		return false
	}
}

// recoverySelectLabel names one selection checkbox for assistive technology.
func recoverySelectLabel(row TaskAdmittedRow) string {
	return "Select worksheet row " + strconv.Itoa(row.Row) + " recipient " + strconv.Itoa(row.Position)
}

// recoveryStateLabel renders a stored state code as operator words.
func recoveryStateLabel(state string) string {
	return strings.ReplaceAll(state, "_", " ")
}

// recoveryStateBadge maps one recovery state to its badge variant.
func recoveryStateBadge(state string) badge.Props {
	switch state {
	case "definite_failure", "failed", "auth_failure":
		return badge.Props{Variant: badge.VariantDestructive, Class: "whitespace-nowrap!"}
	case "review_required":
		return badge.Props{Variant: badge.VariantDefault, Class: "status-warning whitespace-nowrap!"}
	case "manually_submitted":
		return badge.Props{Variant: badge.VariantOutline, Class: "whitespace-nowrap!"}
	default:
		return badge.Props{Variant: badge.VariantSecondary, Class: "whitespace-nowrap!"}
	}
}

// sendingHasRecovery reports whether any row or recorded outcome needs a
// recovery action or detail.
func sendingHasRecovery(rows []TaskAdmittedRow) bool {
	return slices.ContainsFunc(rows, taskRowNeedsRecovery)
}

// taskStatusBadge renders the derived main status, with a non-color text label.
templ taskStatusBadge(label, class string) {
	@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: class}) {
		{ label }
	}
}

templ sheetLabel(sheet TaskSheetOption) {
	switch sheet.Visible {
		case true:
			{ sheet.Name }
		default:
			{ sheet.Name } (hidden)
	}
}

// readableBytes renders a byte bound in readable units for operator guidance.
func readableBytes(value int64) string {
	switch {
	case value <= 0:
		return "not configured"
	case value >= 1<<20:
		return strconv.FormatFloat(float64(value)/(1<<20), 'f', 1, 64) + " MiB"
	case value >= 1<<10:
		return strconv.FormatFloat(float64(value)/(1<<10), 'f', 1, 64) + " KiB"
	default:
		return strconv.FormatInt(value, 10) + " bytes"
	}
}

// joinList renders names as one readable line.
func joinList(items []string) string {
	return strings.Join(items, ", ")
}

templ taskPreparation(data TaskPageData) {
	<section class="space-y-4" id="task-preparation" aria-labelledby="preparation-heading">
		@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "preparation-heading"}}) {
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<p class="text-[.68rem] tracking-[.13em] font-[750] uppercase text-primary mb-[.6rem]">AI data preparation</p>
				<h3 id="preparation-heading" class="cn-card-title">Prepare mapped field values</h3>
				<p class="text-sm text-muted-foreground max-w-[75ch]">Only campaign-mapped values are sent to the confirmed AI connection, and only this operator can read the runs. Prepared output is review evidence: it does not send email, make a recipient eligible or replace the validated task snapshot.</p>
				if data.Preparation.BlockedReason != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault, Class: "status-warning"}) {
						<p>{ data.Preparation.BlockedReason }</p>
					}
				}
				if data.Preparation.Configured {
					<div class="space-y-1 text-sm">
						<p><strong>{ data.Preparation.ConnectionLabel }</strong></p>
						<p class="text-muted-foreground wrap-anywhere">Mapped values are sent to <code>{ data.Preparation.Endpoint }</code> under this account's confirmed connection. Account settings describes the provider's data handling.</p>
					</div>
				} else {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
						<p>No AI connection is confirmed for this account. <a class="app-link text-primary" href="/account/ai">Set up the AI connection</a> before preparing data.</p>
					}
				}
				if len(data.Preparation.Runs) > 0 {
					{{ latest := data.Preparation.Runs[0] }}
					if latest.State != "completed" {
						<div class="rounded-md border border-border p-3 text-sm" id="preparation-latest-run">
							<p>Latest run <code>{ latest.State }</code> · { latest.Kind } · { latest.CreatedAt }</p>
							if latest.Error != "" {
								<p class="text-sm status-danger wrap-anywhere">{ latest.Error }</p>
							}
						</div>
					}
				}
				if data.Preparation.CanPrepare || data.Preparation.CanRetry || data.Preparation.CanRerun {
					<div class="app-card-actions items-center">
						if data.Preparation.CanPrepare {
							<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preparation/prepare" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault}) {
									Prepare mapped data
								}
							</form>
						}
						if data.Preparation.CanRetry {
							<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preparation/retry" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault}) {
									Retry failed preparation
								}
							</form>
						}
						if data.Preparation.CanRerun {
							<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preparation/rerun" }>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
									Run preparation again
								}
							</form>
						}
					</div>
				}
				if data.Preparation.EvidenceRunID != "" {
					<div class="space-y-2" id="preparation-evidence">
						<h4 class="text-sm font-semibold">
							Prepared dataset evidence
							if data.Preparation.EvidenceSelected {
								<span class="text-xs text-primary">(selected)</span>
							}
						</h4>
						if data.RoleMapping && data.DatasetFinalized {
							<p class="text-sm"><strong>Preparation history</strong> · { strconv.Itoa(data.Preparation.Counts.Corrections) } corrections · { strconv.Itoa(data.Preparation.Counts.Findings) } AI findings. The selected final snapshot supplies accepted and excluded rows.</p>
						} else if data.RoleMapping && data.Finalization.PreparedReview {
							<p class="text-sm">
								if data.Preparation.EvidenceSelected {
									Selected run
								} else {
									Prepared run
								}
								· { strconv.Itoa(data.Preparation.Counts.Corrections) } corrections · { strconv.Itoa(data.Preparation.Counts.Findings) } unresolved AI findings
							</p>
							<p class="text-sm text-muted-foreground">Backend acceptance and held counts appear once in the final review below.</p>
						} else if data.RoleMapping {
							<p class="text-sm">{ strconv.Itoa(data.Preparation.Counts.SourceRows) } source rows · { strconv.Itoa(data.Preparation.Counts.Entries) } prepared entries · { strconv.Itoa(data.Preparation.Counts.Corrections) } corrections · { strconv.Itoa(data.Preparation.Counts.Findings) } AI findings</p>
							<p class="text-sm text-muted-foreground">Backend validation is pending. Accepted and held recipient counts appear once the backend review of the prepared run completes.</p>
						} else {
							<p class="text-sm">{ strconv.Itoa(data.Preparation.Counts.SourceRows) } source rows · { strconv.Itoa(data.Preparation.Counts.Entries) } prepared entries · { strconv.Itoa(data.Preparation.Counts.Accepted) } provisionally accepted · { strconv.Itoa(data.Preparation.Counts.Held) } held by findings · { strconv.Itoa(data.Preparation.Counts.Corrections) } corrections · { strconv.Itoa(data.Preparation.Counts.Findings) } AI findings</p>
							<p class="text-sm text-muted-foreground">Held entries are preparation evidence only. Required/optional, address and duplicate checks still run in the backend when this evidence is finalized.</p>
						}
						{{ provisionalHeld := len(data.Preparation.Held) > 0 && !data.Finalization.PreparedReview }}
						if provisionalHeld {
							@taskEvidenceDisclosure("preparation-held", "Prepared entries held by findings", data.Preparation.Counts.Held, true) {
								@taskReviewList("Prepared entries held by findings") {
									@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": "Prepared entries held by findings"}}) {
										<thead><tr><th>Row</th><th>Position</th><th>Recipient</th><th>Reason</th></tr></thead>
										<tbody>
											for _, held := range data.Preparation.Held {
												<tr><td>{ held.Row }</td><td>{ held.Position }</td><td>{ held.Recipient }</td><td>{ held.Reasons }</td></tr>
											}
										</tbody>
									}
								}
								@taskTruncation(len(data.Preparation.Held), data.Preparation.Counts.Held, "held entries", "The complete evidence is in the selected run's sanitization report.")
							}
						} else if !data.Finalization.PreparedReview {
							<p class="text-sm text-muted-foreground">No entries are held by preparation findings.</p>
						}
						if data.Preparation.Counts.Findings > 0 {
							@taskEvidenceDisclosure("preparation-findings", "Unresolved AI findings", data.Preparation.Counts.Findings, false) {
								@taskReviewList("Unresolved AI findings") {
									@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": "Unresolved preparation findings"}}) {
										<thead><tr><th>Row</th><th>Position</th><th>Field</th><th>Scope</th><th>Finding</th></tr></thead>
										<tbody>
											for _, finding := range data.Preparation.Findings {
												<tr>
													<td>{ finding.Row }</td>
													<td>
														if finding.Position > 0 {
															{ finding.Position }
														} else {
															—
														}
													</td>
													<td>{ finding.Field }</td>
													<td><code>{ finding.Scope }</code></td>
													<td>{ finding.Note }</td>
												</tr>
											}
										</tbody>
									}
								}
								@taskTruncation(len(data.Preparation.Findings), data.Preparation.Counts.Findings, "findings", "The complete evidence is in the selected run's sanitization report.")
							}
						} else {
							<p class="text-sm text-muted-foreground">No unresolved AI findings in this run.</p>
						}
						if data.Preparation.Counts.Corrections > 0 {
							@taskEvidenceDisclosure("preparation-corrections", "Resolved corrections", data.Preparation.Counts.Corrections, false) {
								@taskReviewList("Resolved corrections") {
									@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": "Resolved preparation corrections"}}) {
										<thead><tr><th>Row</th><th>Field</th><th>Correction</th></tr></thead>
										<tbody>
											for _, correction := range data.Preparation.Corrections {
												<tr><td>{ correction.Row }</td><td>{ correction.Field }</td><td>{ correction.Note }</td></tr>
											}
										</tbody>
									}
								}
								@taskTruncation(len(data.Preparation.Corrections), data.Preparation.Counts.Corrections, "corrections", "The complete evidence is in the selected run's sanitization report.")
							}
						} else {
							<p class="text-sm text-muted-foreground">No resolved corrections in this run. Corrections alone never hold an entry.</p>
						}
					</div>
				}
				if data.Preparation.EvidenceRunID == "" {
					@taskPreparationSettings(data)
				} else {
					@taskEvidenceDisclosure("preparation-settings", "Preparation settings and run history", len(data.Preparation.Runs), false) {
						@taskPreparationSettings(data)
					}
				}
			}
		}
	</section>
}

// taskPreparationSettings is the secondary configuration and run history of the
// preparation card. It stays inline until a run completes, because the
// instruction editor and the connection remedy are the first-run guidance.
templ taskPreparationSettings(data TaskPageData) {
	<div class="space-y-3">
		<details class="text-sm">
			<summary class="cursor-pointer">Application base prompt · version { data.Preparation.PromptVersion }</summary>
			<pre class="mt-2 max-h-96 overflow-auto rounded-md border border-border bg-muted/40 p-3 text-xs wrap-anywhere whitespace-pre-wrap">{ data.Preparation.Prompt }</pre>
		</details>
		<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preparation/instructions" } class="space-y-3">
			@field.Field(field.Props{}) {
				@field.Label(field.LabelProps{For: "preparation-instructions"}) {
					Task instructions (optional)
				}
				@textarea.Textarea(textarea.Props{ID: "preparation-instructions", Name: "instructions", Rows: 6, Value: data.Preparation.Instructions, Disabled: !data.Preparation.CanManage, Attributes: templ.Attributes{"aria-describedby": "preparation-instructions-hint"}})
				<p id="preparation-instructions-hint" class="text-xs text-muted-foreground">Instructions extend or override the cleanup defaults for this task only. They never bypass output validation, recipient integrity or sending authorization. Editing them does not change a completed run; only an explicit new run captures the new text.</p>
			}
			<div class="app-card-actions">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Disabled: !data.Preparation.CanManage}) {
					Save instructions
				}
			</div>
		</form>
		if len(data.Preparation.Runs) > 0 {
			@taskReviewList("Preparation runs") {
				@table.Table(table.Props{Class: "cn-table-compact cn-table-sticky", Attributes: templ.Attributes{"aria-label": "Preparation runs"}}) {
					<thead>
						<tr><th>Created</th><th>Run</th><th>State</th><th>Model</th><th>Batches</th><th>Result</th><th>Action</th></tr>
					</thead>
					<tbody>
						for _, run := range data.Preparation.Runs {
							<tr>
								<td>{ run.CreatedAt }</td>
								<td>
									<code>{ run.Kind }</code>
									if run.Selected {
										<span class="ml-1 text-xs text-primary">selected</span>
									}
									if run.Error != "" {
										<p class="text-xs status-danger wrap-anywhere">{ run.Error }</p>
									}
								</td>
								<td><code>{ run.State }</code></td>
								<td class="wrap-anywhere">{ run.Provider } · { run.APIFormat } · { run.Model }</td>
								<td>{ run.Batches }</td>
								<td>{ run.Accepted } accepted · { run.Held } held · { run.Corrections } corrections · { run.Findings } findings</td>
								<td>
									if run.CanSelect {
										<form method="post" action={ "/campaigns/" + data.CampaignID + "/tasks/" + data.TaskID + "/preparation/select" }>
											<input type="hidden" name="run" value={ run.ID }/>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
												Select this run
											}
										</form>
									} else {
										<span class="text-sm text-muted-foreground">—</span>
									}
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	</div>
}

// taskEvidenceDisclosure is a count-bearing, keyboard-operable disclosure for
// one evidence list. Counts and guidance stay outside the bounded viewport.
templ taskEvidenceDisclosure(id, label string, count int, open bool) {
	{{ values := []string{id} }}
	if !open {
		{{ values = nil }}
	}
	@accordion.Accordion(accordion.Props{ID: id, DefaultValue: values}) {
		@accordion.Item(accordion.ItemProps{ID: id + "-item", Value: id}) {
			@accordion.Trigger(accordion.TriggerProps{ID: id + "-trigger"}) {
				<span>
					{ label }
					if count >= 0 {
						<span>· { strconv.Itoa(count) }</span>
					}
				</span>
			}
			@accordion.Content(accordion.ContentProps{Class: "space-y-2"}) {
				{ children... }
			}
		}
	}
}

// taskReviewList bounds one review list: the scrollarea viewport keeps the
// content height up to min(20rem, 60vh), sticky headings stay visible, wide
// tables scroll horizontally and the named viewport is what becomes focusable
// when there is overflow.
templ taskReviewList(label string) {
	@scrollarea.ScrollArea(scrollarea.Props{
		Horizontal: true,
		Class:      "[&_[data-slot=scroll-area-viewport]]:h-auto [&_[data-slot=scroll-area-viewport]]:max-h-[min(20rem,60vh)]",
		ViewportAttributes: templ.Attributes{
			"role":       "region",
			"aria-label": label,
		},
	}) {
		<div class="p-1 pr-3 pb-2">
			{ children... }
		</div>
	}
}

// taskTruncation states what a preview omits; scrolling never fetches more.
templ taskTruncation(shown, total int, noun, hint string) {
	if total > shown {
		<p class="text-xs text-muted-foreground" data-slot="truncation-note">Showing { strconv.Itoa(shown) } of { strconv.Itoa(total) } { noun }. { hint }</p>
	}
}

// finalReviewReportCount counts the report links the displayed dataset offers.
func finalReviewReportCount(data TaskPageData) int {
	finalization := data.Finalization
	count := 0
	if !finalization.HasSelected && finalization.PreparedReview {
		if finalization.SanitizationHref != "" {
			count++
		}
		if finalization.PreparedReviewSelected && len(finalization.PreparedExclusions) > 0 {
			count++
		}
	}
	if finalization.HasSelected && finalization.Selected.Excluded > 0 {
		count++
	}
	return count
}

// finalEditOpen reports when the secondary edit path starts expanded: a refused
// upload, the available remedy before review, or a review with no accepted rows.
func finalEditOpen(data TaskPageData) bool {
	finalization := data.Finalization
	if finalization.Error != "" {
		return true
	}
	if finalization.HasSelected {
		return finalization.Selected.Accepted == 0
	}
	return finalization.Required && (!finalization.CanApprove || finalization.PreparedAccepted == 0)
}
