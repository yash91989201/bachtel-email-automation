package views

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/checkbox"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/collapsible"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/field"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/input"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/item"
	uilabel "github.com/yash91989201/bachtel-email-automation/internal/web/ui/label"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/nativeselect"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/tabs"
)

type SendingData struct {
	Base, TaskURL, Sender, Hash, Status, Reason, ActionID, Error, LatestTest, Cooldown               string
	ScheduleAt, ScheduleState, ScheduleMinDate                                                       string
	Approved, Enabled, ArtifactNeeded, RestoreReview, ResultsReady                                   bool
	ResultsState                                                                                     string
	Rate                                                                                             int
	RetryableFailed                                                                                  int
	Eligible, Remaining, Submitted, Failed, Held, InFlight, Reserved, Invalid, Duplicate, Ineligible int
	Rows                                                                                             []SendingRow
	Recent                                                                                           []SendingOutcome
}
type SendingRow struct {
	ResolutionActor, ResolutionBasis, ResolvedAt string
	SampleEligible                               bool
	ID, State, Reason, ActionID                  string
	Number                                       int
	Attempt                                      SendingOutcome
}
type SendingOutcome struct{ ID, Kind, Recipient, State, Reason, Time string }

// A changed control identity discards stale confirmations during polling.
func sendingControlKey(data SendingData) string {
	return fmt.Sprintf("%s-%t-%t-%d-%d-%d-%d-%d-%d-%d-%d-%d-%s", data.Status, data.Enabled, data.Approved, data.Remaining, data.Submitted, data.Failed, data.Held, data.InFlight, data.Reserved, data.Invalid, data.Duplicate, data.Ineligible, data.ScheduleState)
}

// approvalFormID names the approval form by the content hash, the latest test
// and the approval state, so a changed configuration or a fresh test discards
// a stale confirmation. htmx restores a preserved element with a selector
// built from its id, so the id keeps only selector-safe characters: the
// content hash carries a "sha256:" prefix.
func approvalFormID(data SendingData) string {
	raw := "sending-approval-" + data.Hash + "-" + data.LatestTest + "-" + strconv.FormatBool(data.Approved)
	var safe strings.Builder
	safe.Grow(len(raw))
	for _, r := range raw {
		switch {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
			safe.WriteRune(r)
		}
	}
	return safe.String()
}

func sendingNeedsRecovery(row SendingRow) bool {
	return row.State == "definite_failure" || row.State == "failed" || row.State == "auth_failure" || row.State == "correction_required" || row.State == "manually_submitted" || row.State == "review_required"
}

func sendingHasRecovery(rows []SendingRow) bool {
	for _, row := range rows {
		if sendingNeedsRecovery(row) {
			return true
		}
	}
	return false
}

templ SendingPage(data SendingData) {
	@Layout("Sending", true, "campaigns") {
		<header class="page-header">
			<div>
				<p class="eyebrow">Task workflow · Step 4</p>
				<h1>Test, approve and manage sending</h1>
				<p class="page-description">Test your email, approve the received formatting, then send or schedule recipients.</p>
				<p class="text-sm text-muted-foreground">Fixed sender: <strong>{ data.Sender }</strong></p>
			</div>
			<div class="action-bar"><a class={ button.Variants(button.Props{Variant: button.VariantGhost}) } href={ data.TaskURL }>Back to task snapshot and exclusions</a></div>
		</header>
		if !data.Enabled {
			@alert.Alert(alert.Props{Class: "status-warning"}) {
				Candidate sending is disabled until production release verification is complete. Diagnostic test emails remain available.
			}
		}
		if data.RestoreReview {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "status-danger"}) {
				Restore review is active. Sending, scheduling, retries and resends are disabled until submissions made after the restored backup are reconciled and the server is restarted without APP_RESTORE_REVIEW.
			}
		}
		if data.Error!="" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "status-danger"}) {
				{ data.Error }
			}
		}
		@tabs.Tabs(tabs.Props{ID: "sending", Class: "campaign-workspace", Orientation: tabs.OrientationVertical, DefaultValue: "test", Attributes: templ.Attributes{"data-workspace-tabs": true}}) {
			<aside class="workspace-sidebar" aria-label="Sending navigation">
				@tabs.List(tabs.ListProps{Attributes: templ.Attributes{"aria-label": "Sending workflow"}}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "test"}) {
						<span>Test & approval</span><small>Check received formatting</small>
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "send"}) {
						<span>Send & schedule</span><small>Start, stop & schedule</small>
					}
					<div class="workspace-group-separator" aria-hidden="true"></div>
					@tabs.Trigger(tabs.TriggerProps{Value: "recovery"}) {
						<span>Recovery</span><small>Review failures & uncertainty</small>
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "recent"}) {
						<span>Recent outcomes</span><small>Submission attempt history</small>
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "results"}) {
						<span>Results workbook</span><small>Generate & download results</small>
					}
					<div class="workspace-group-separator" aria-hidden="true"></div>
					@tabs.Trigger(tabs.TriggerProps{Value: "pacing"}) {
						<span>Mailbox pacing</span><small>Shared mailbox rate</small>
					}
				}
			</aside>
			<div class="workspace-content">
				@SendingProgress(data)
				@tabs.Content(tabs.ContentProps{Value: "results", Class: "space-y-6"}) {
					@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "artifacts-heading"}}) {
						@card.Content(card.ContentProps{Class: "gap-4"}) {
							<h2 class="section-heading" id="artifacts-heading">Result workbook</h2>
							<form method="post" action={ data.Base + "/artifacts#results" }>
								<input type="hidden" name="action_id" value={ data.ActionID + "artifacts" }/>
								<input type="hidden" name="expected_count" value="0"/>
								<input type="hidden" name="confirmed" value="yes"/>
								@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit}) {
									{ "Generate results workbook" }
								}
							</form>
							<p class="section-description">Generate the workbook from retained records. This never submits or retries email, and a generation failure never changes eligibility.</p>
							if data.ResultsReady {
								<a class={ button.Variants(button.Props{}) } href={ data.TaskURL + "/results.xlsx" }>Download results workbook</a>
							} else if data.ResultsState == "generating" {
								<p>Generating the results workbook now.</p>
							} else if data.ResultsState == "failed" {
								<p class="text-destructive">The last generation failed; request generation again to retry. No incomplete file is offered.</p>
							}
						}
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "pacing", Class: "space-y-6"}) {
					@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "pacing-heading"}}) {
						@card.Content(card.ContentProps{Class: "gap-4"}) {
							<h2 class="section-heading" id="pacing-heading">Mailbox pacing</h2>
							<p class="section-description">Default 25 starts per minute; maximum 30 and four in flight across candidates, tests and retries. Microsoft throttling may reduce throughput. Other Outlook clients consume mailbox capacity outside this app's observations.</p>
							<form method="post" action={ data.Base + "/rate#pacing" } class="field-grid">
								<input type="hidden" name="action_id" value={ data.ActionID + "rate" }/>
								@field.Field(field.Props{}) {
									@field.Label(field.LabelProps{For: "sending-rate"}) {
										Starts per minute
									}
									@input.Input(input.Props{ID: "sending-rate", Name: "rate", Type: "number", Class: "pacing-input", Value: strconv.Itoa(data.Rate), Required: true, Attributes: templ.Attributes{"min": "1", "max": "30", "step": "1"}})
								}
								<div class="action-bar">
									@button.Button(button.Props{Type: button.TypeSubmit}) {
										{ "Update pacing" }
									}
								</div>
							</form>
						}
					}
				}
			</div>
		}
	}
}

templ SendingDiagnostics(data SendingData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "sending-test-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<p class="eyebrow">Step 1 · Test</p>
			<h2 class="section-heading" id="sending-test-heading">Send a formatting test</h2>
			<p class="section-description">Choose a valid sample row and enter the test address. Tests use a separate attempt and never submit a candidate.</p>
			<form id="sending-diagnostic-test" hx-preserve method="post" action={ data.Base + "/test#test" } class="space-y-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "test" }/>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-sample-row"}) {
						Sample row
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-sample-row", Name: "member_id", Required: true, Class: "w-full"}) {
						for _,row:=range data.Rows {
							if row.SampleEligible {
								@nativeselect.Option(nativeselect.OptionProps{Value: row.ID}) {
									Worksheet row { row.Number }
								}
							}
						}
					}
				}
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-test-address"}) {
						Test recipient
					}
					@input.Input(input.Props{ID: "sending-test-address", Type: "email", Name: "test_address", Required: true})
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ "Send diagnostic test" }
					}
				</div>
			</form>
		}
	}
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "sending-approval-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<p class="eyebrow">Step 2 · Approve</p>
			<h2 class="section-heading" id="sending-approval-heading">Approve the received formatting</h2>
			<p>Exact configuration content hash: <code class="break-all">{ data.Hash }</code></p>
			if data.Approved {
				<p class="text-success">Received formatting approved for this hash.</p>
			}
			<form id={ approvalFormID(data) } hx-preserve method="post" action={ data.Base + "/approve#test" } class="space-y-3">
				<input type="hidden" name="action_id" value={ data.ActionID + "approve" }/>
				<input type="hidden" name="content_hash" value={ data.Hash }/>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-approval-attempt"}) {
						Successful diagnostic test
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-approval-attempt", Name: "attempt_id", Required: true, Class: "w-full"}) {
						<option value="">Choose a submitted test for this configuration</option>
						if data.LatestTest!="" {
							<option value={ data.LatestTest }>Latest successful test for this exact content: { data.LatestTest }</option>
						}
						for _,outcome:=range data.Recent {
							if outcome.Kind=="test" && outcome.State=="submitted" {
								<option value={ outcome.ID }>{ outcome.Recipient } · { outcome.Time } · { outcome.ID }</option>
							}
						}
					}
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-approve-received", Name: "received_checked", Value: "yes", Required: true})
					I received this test and checked its subject, personalized values and HTML formatting.
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ "Approve this exact content" }
					}
				</div>
			</form>
		}
	}
}

templ SendingProgress(data SendingData) {
	{{ ctx = tabs.Panels(ctx, "sending", tabs.OrientationVertical) }}
	<section id="sending-progress" class="space-y-4" hx-get={ data.Base + "/progress" } hx-trigger="every 2s" hx-swap="outerHTML">
		<div class="subtle-panel" aria-live="polite">
			<h2 class="section-heading">Progress · { data.Status }</h2>
			if data.Reason!="" {
				@alert.Alert(alert.Props{Class: "status-warning"}) {
					{ data.Reason }
				}
			}
			<dl class="metric-grid">
				<div class="metric"><dt>Safe remaining</dt><dd>{ data.Remaining }</dd></div>
				<div class="metric"><dt>Submitted</dt><dd>{ data.Submitted }</dd></div>
				<div class="metric"><dt>Definite failures</dt><dd>{ data.Failed }</dd></div>
				<div class="metric"><dt>Held for review</dt><dd>{ data.Held }</dd></div>
				<div class="metric"><dt>In flight</dt><dd>{ data.InFlight }</dd></div>
				<div class="metric"><dt>Reserved</dt><dd>{ data.Reserved }</dd></div>
			</dl>
			@collapsible.Collapsible(collapsible.Props{ID: "sending-guidance", Class: "snapshot-details", Attributes: templ.Attributes{"data-workspace-persist": true}}) {
				<button class="snapshot-details-summary" { collapsible.Trigger(ctx)... }>Exclusions, mailbox status & sending guidance</button>
				@collapsible.Content(collapsible.ContentProps{Class: "space-y-2 text-sm text-muted-foreground"}) {
					<p>Exclusions: invalid { data.Invalid }, duplicate { data.Duplicate }, ineligible { data.Ineligible }. Counts refresh before each action; changed exclusions require another confirmation.</p>
					if data.ArtifactNeeded {
						<p>Result generation requested. The background worker builds the workbook; artifact failures never requeue email.</p>
					}
					<p>Current pacing: { data.Rate } starts per minute. Mailbox cooldown: { data.Cooldown }</p>
					<p>SUBMITTED means Microsoft accepted the request; it does not confirm delivery. Closing the browser or logging out does not stop server work. Reconnecting Microsoft or sending a diagnostic test never resumes candidates.</p>
					<p><a class="app-link" href={ data.Base } data-workspace-hash-link>Refresh successful test choices and all action counts</a></p>
				}
			}
		</div>
		@tabs.Content(tabs.ContentProps{Value: "test", Class: "space-y-6"}) {
			@SendingDiagnostics(data)
		}
		@tabs.Content(tabs.ContentProps{Value: "send", Class: "space-y-6"}) {
			@SendingControls(data)
			@sendingSchedule(data)
		}
		@tabs.Content(tabs.ContentProps{Value: "recovery", Class: "space-y-6"}) {
			@SendingRecovery(data)
		}
		@tabs.Content(tabs.ContentProps{Value: "recent", Class: "space-y-6"}) {
			<section class="subtle-panel" aria-labelledby="recent-outcomes-heading">
				<h3 class="section-heading" id="recent-outcomes-heading">Recent outcomes · +05:30</h3>
				@item.Group(item.GroupProps{}) {
					if len(data.Recent) == 0 {
						@item.Item(item.Props{}) {
							@item.Content(item.ContentProps{}) {
								@item.Description(item.DescriptionProps{}) {
									No submission attempts yet.
								}
							}
						}
					}
					for _,outcome:=range data.Recent {
						@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
							@item.Content(item.ContentProps{}) {
								@item.Title(item.TitleProps{}) {
									{ outcome.Time } · { outcome.Kind } · { outcome.Recipient }
								}
								@item.Description(item.DescriptionProps{}) {
									{ outcome.State } · { outcome.Reason }
								}
							}
						}
					}
				}
			</section>
		}
	</section>
}

templ sendingAction(data SendingData, kind string, label string, count int) {
	<form id={ "sending-action-" + kind + "-" + strconv.Itoa(count) + "-" + sendingControlKey(data) } hx-preserve method="post" action={ data.Base + "/" + kind + "#send" } class="space-y-2">
		<input type="hidden" name="action_id" value={ data.ActionID + kind }/>
		<input type="hidden" name="expected_count" value={ strconv.Itoa(count) }/>
		<label class="block">
			@checkbox.Checkbox(checkbox.Props{ID: "sending-confirm-" + kind, Name: "confirmed", Value: "yes", Required: true})
			Confirm { count } recipients
		</label>
		@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !data.Enabled || !data.Approved || count == 0}) {
			{ label }
		}
	</form>
}

templ sendingSchedule(data SendingData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "schedule-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<h3 class="section-heading" id="schedule-heading">Scheduled start</h3>
			if data.ScheduleAt != "" {
				<p>Stored start: { data.ScheduleAt } · state { data.ScheduleState }.</p>
			} else {
				<p>No stored start · state { data.ScheduleState }.</p>
			}
			<p class="section-description">Enabling is this task's explicit start authorization. Only candidates free at that moment start, and a time that passed while the server was down pauses for review.</p>
			<form id={ "sending-schedule-" + sendingControlKey(data) } hx-preserve method="post" action={ data.Base + "/schedule#send" } class="field-grid">
				<input type="hidden" name="action_id" value={ data.ActionID + "schedule" }/>
				<input type="hidden" name="expected_count" value={ strconv.Itoa(data.Remaining) }/>
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-schedule-date"}) {
						Start date
					}
					@input.Input(input.Props{ID: "sending-schedule-date", Type: "date", Name: "schedule_date", Required: true, Attributes: templ.Attributes{"min": data.ScheduleMinDate}})
				}
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-schedule-hour"}) {
						Hour
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-schedule-hour", Name: "schedule_hour", Required: true, Class: "w-full"}) {
						<option value="">Hour</option>
						for hour := 1; hour <= 12; hour++ {
							<option value={ strconv.Itoa(hour) }>{ strconv.Itoa(hour) }</option>
						}
					}
				}
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-schedule-minute"}) {
						Minute
					}
					@input.Input(input.Props{ID: "sending-schedule-minute", Type: "number", Name: "schedule_minute", Required: true, Attributes: templ.Attributes{"min": "0", "max": "59", "step": "1"}})
				}
				@field.Field(field.Props{}) {
					@field.Label(field.LabelProps{For: "sending-schedule-meridiem"}) {
						AM or PM
					}
					@nativeselect.NativeSelect(nativeselect.Props{ID: "sending-schedule-meridiem", Name: "schedule_meridiem", Required: true, Class: "w-full"}) {
						<option value="AM">AM</option>
						<option value="PM">PM</option>
					}
				}
				@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
					@checkbox.Checkbox(checkbox.Props{ID: "sending-schedule-confirm", Name: "confirmed", Value: "yes", Required: true})
					I confirm the fresh counts for this scheduled start.
				}
				<div class="action-bar">
					@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !data.Enabled || !data.Approved || data.Remaining == 0, Attributes: templ.Attributes{"name": "schedule_action", "value": "enable"}}) {
						{ "Schedule start" }
					}
				</div>
			</form>
			<form id={ "sending-schedule-clear-" + data.ScheduleState } hx-preserve method="post" action={ data.Base + "/schedule#send" }>
				<input type="hidden" name="action_id" value={ data.ActionID + "scheduleclear" }/>
				@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: data.ScheduleState != "scheduled" && data.ScheduleState != "missed", Attributes: templ.Attributes{"name": "schedule_action", "value": "clear"}}) {
					{ "Clear scheduled start" }
				}
			</form>
		}
	}
}

templ sendingRowFields(row SendingRow) {
	<input type="hidden" name="action_id" value={ row.ActionID }/>
	<input type="hidden" name="member_id" value={ row.ID }/>
	<input type="hidden" name="expected_count" value="1"/>
}

templ SendingControls(data SendingData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "controls-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<p class="eyebrow">Step 3 · Start or recover</p>
			<h2 class="section-heading" id="controls-heading">Candidate actions</h2>
			<p class="section-description">Confirm the fresh counts for each action. If progress changes them before submission, reload and confirm again.</p>
			<div class="sending-actions">
				@sendingAction(data, "start", "Start", data.Remaining)
				@sendingAction(data, "resume", "Resume safe remainder", data.Remaining)
				@sendingAction(data, "retry_all", "Retry all definite failures", data.RetryableFailed)
				<form id={ "sending-stop-" + data.Status } hx-preserve method="post" action={ data.Base + "/stop#send" }>
					<input type="hidden" name="action_id" value={ data.ActionID + "stop" }/>
					<input type="hidden" name="expected_count" value="0"/>
					<input type="hidden" name="confirmed" value="yes"/>
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "status-warning"}) {
						{ "Stop sending" }
					}
				</form>
			</div>
		}
	}
}

templ SendingRecovery(data SendingData) {
	@card.Card(card.Props{Attributes: templ.Attributes{"role": "region", "aria-labelledby": "recovery-heading"}}) {
		@card.Content(card.ContentProps{Class: "gap-4"}) {
			<h2 class="section-heading" id="recovery-heading">Individual recovery</h2>
			if !sendingHasRecovery(data.Rows) {
				<p>No rows currently need individual recovery.</p>
			}
			for _,row:=range data.Rows {
				if sendingNeedsRecovery(row) {
					<div class="subtle-panel space-y-2">
						<h3 class="font-semibold">Recovery · worksheet row { row.Number }</h3>
						<p>{ row.State } · { row.Reason }</p>
						if row.Attempt.ID!="" {
							<p>Prior attempt { row.Attempt.ID }: { row.Attempt.Recipient } · { row.Attempt.State } · { row.Attempt.Time } · { row.Attempt.Reason }</p>
						}
						if row.State=="manually_submitted" {
							<p>Marked already submitted by { row.ResolutionActor } at { row.ResolvedAt }. Basis: { row.ResolutionBasis }</p>
							<p>This operator resolution does not establish a Microsoft acceptance timestamp.</p>
						} else if row.State=="correction_required" {
							<p>Correct the recipient or required values in the source workbook and upload a corrected task. This unchanged snapshot cannot be retried.</p>
						} else if row.State=="review_required" {
							<form id={ "sending-resend-" + row.ID + "-" + row.State + "-" + row.Attempt.ID + "-" + strconv.FormatBool(data.Enabled) } hx-preserve method="post" action={ data.Base + "/resend#recovery" } class="space-y-2">
								@sendingRowFields(row)
								@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
									@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-duplicate-" + row.ID, Name: "duplicate_risk", Value: "yes", Required: true})
									The earlier request may have been accepted. Sending again can create a duplicate.
								}
								@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
									@checkbox.Checkbox(checkbox.Props{ID: "sending-resend-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
									Confirm sending this 1 recipient again.
								}
								@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !data.Enabled, Class: "status-warning"}) {
									{ "Send again — duplicate risk" }
								}
							</form>
							<form id={ "sending-resolve-" + row.ID + "-" + row.State + "-" + row.Attempt.ID + "-" + strconv.FormatBool(data.Enabled) } hx-preserve method="post" action={ data.Base + "/resolve#recovery" } class="space-y-2">
								@sendingRowFields(row)
								@field.Field(field.Props{}) {
									@field.Label(field.LabelProps{For: "sending-resolution-basis-" + row.ID}) {
										Basis for resolution
									}
									@input.Input(input.Props{ID: "sending-resolution-basis-" + row.ID, Name: "basis", Required: true, Attributes: templ.Attributes{"maxlength": "2000"}})
								}
								@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
									@checkbox.Checkbox(checkbox.Props{ID: "sending-resolve-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
									I verified this recipient was already submitted.
								}
								@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit}) {
									{ "Mark as already submitted" }
								}
								<p>Records the operator, basis and resolution time. Does not invent a Microsoft acceptance timestamp.</p>
							</form>
						} else {
							<form id={ "sending-retry-" + row.ID + "-" + row.State + "-" + row.Attempt.ID + "-" + strconv.FormatBool(data.Enabled) } hx-preserve method="post" action={ data.Base + "/retry#recovery" }>
								@sendingRowFields(row)
								@uilabel.Label(uilabel.Props{Class: "cn-label"}) {
									@checkbox.Checkbox(checkbox.Props{ID: "sending-retry-confirm-" + row.ID, Name: "confirmed", Value: "yes", Required: true})
									Retry this 1 definite failure using its unchanged snapshot.
								}
								@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Disabled: !data.Enabled}) {
									{ "Retry" }
								}
							</form>
						}
					</div>
				}
			}
		}
	}
}
