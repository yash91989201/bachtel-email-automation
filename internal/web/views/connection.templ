package views

import (
	"github.com/yash91989201/bachtel-email-automation/internal/microsoft"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/badge"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
)

// ConnectionData is the safe view model for the connection page. It never
// carries tokens, ciphertext, verifiers, or the client secret.
type ConnectionData struct {
	Status              string
	AccountEmail        string
	SenderAddress       string
	ConnectedAt         string
	CredentialExpiresAt string
	LastError           string
	Notice              string
	MissingSettings     []string
}

templ ConnectionPage(data ConnectionData) {
	@Layout("Microsoft connection", true, "mailbox") {
		<div class="page-header">
			<div>
				<p class="text-sm font-medium uppercase tracking-widest text-primary">Microsoft 365</p>
				<h1 class="text-4xl font-bold tracking-tight">Mailbox connection</h1>
				<p class="page-description">Connect the HR mailbox used for all outgoing email. Check the sender and connection status here.</p>
			</div>
		</div>
		if len(data.MissingSettings) > 0 {
			@alert.Alert(alert.Props{Class: "status-warning"}) {
				<div>
					<p class="font-semibold">The Microsoft connection is not configured.</p>
					<p>Set these settings and restart the server:</p>
					<ul class="list-inside list-disc">
						for _, name := range data.MissingSettings {
							<li><code>{ name }</code></li>
						}
					</ul>
				</div>
			}
		}
		if data.Notice != "" {
			@alert.Alert(alert.Props{Class: "status-info"}) {
				{ data.Notice }
			}
		}
		if data.LastError != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				{ data.LastError }
			}
		}
		<section class="cn-card border border-border bg-card shadow-sm" aria-labelledby="status-heading">
			@card.Content(card.ContentProps{Class: "gap-4"}) {
				<h2 id="status-heading" class="cn-card-title">Sending mailbox</h2>
				<div class="flex items-center gap-3">
					@statusBadge(data.Status)
				</div>
				<dl class="connection-details text-sm">
					if data.AccountEmail != "" {
						<div class="flex gap-2">
							<dt class="font-semibold">Account:</dt>
							<dd>{ data.AccountEmail }</dd>
						</div>
					}
					<div class="flex gap-2">
						<dt class="font-semibold">Sender address:</dt>
						<dd>{ data.SenderAddress }</dd>
					</div>
					if data.ConnectedAt != "" {
						<div class="flex gap-2">
							<dt class="font-semibold">Connected:</dt>
							<dd><time datetime={ data.ConnectedAt }>{ data.ConnectedAt }</time></dd>
						</div>
					}
					if data.CredentialExpiresAt != "" {
						<div class="flex gap-2">
							<dt class="font-semibold">Credential expires:</dt>
							<dd><time datetime={ data.CredentialExpiresAt }>{ data.CredentialExpiresAt }</time></dd>
						</div>
					}
				</dl>
				<div class="app-card-actions flex-wrap">
					if data.Status != string(microsoft.StatusConnected) {
						<form method="post" action="/connection/connect">
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								if data.Status == string(microsoft.StatusReconnectRequired) {
									Reconnect
								} else {
									Connect
								}
							}
						</form>
					}
					if data.Status != string(microsoft.StatusDisconnected) {
						<form method="post" action="/connection/disconnect" class="flex flex-wrap items-center gap-2" x-data="{ confirm: false }">
							@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"x-on:click": "confirm = true", "x-bind:aria-expanded": "confirm", "aria-expanded": "false", "x-show": "!confirm"}}) {
								Disconnect
							}
							<div class="flex flex-wrap items-center gap-2" x-show="confirm" x-cloak>
								<span class="text-sm">Disconnect the mailbox?</span>
								@button.Button(button.Props{Variant: button.VariantDestructive, Size: button.SizeSm, Type: button.TypeSubmit}) {
									Yes, disconnect
								}
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"x-on:click": "confirm = false"}}) {
									Cancel
								}
							</div>
						</form>
					}
				</div>
			}
		</section>
	}
}

templ statusBadge(status string) {
	if status == string(microsoft.StatusConnected) {
		@badge.Badge(badge.Props{Class: "status-success", Attributes: templ.Attributes{"data-status": status}}) {
			Connected
		}
	} else if status == string(microsoft.StatusReconnectRequired) {
		@badge.Badge(badge.Props{Class: "status-warning", Attributes: templ.Attributes{"data-status": status}}) {
			Reconnect required
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantGhost, Attributes: templ.Attributes{"data-status": status}}) {
			Disconnected
		}
	}
}
