package views

templ LoginPage(errorMessage string) {
	@Layout("Sign in", false, "") {
		<div class="login-layout space-y-6">
			<div class="space-y-2 text-center">
				<p class="eyebrow">Welcome back</p>
				<h1>Sign in to your workspace</h1>
				<p class="text-base-content/70">Manage campaigns and email operations securely.</p>
			</div>
			if errorMessage != "" {
				<div class="alert alert-error" role="alert">{ errorMessage }</div>
			}
			<form method="post" action="/login" class="card border border-base-300 bg-base-100 shadow-sm">
				<div class="card-body gap-4">
					<label class="label" for="email">Email</label>
					<input class="input w-full" id="email" type="email" name="email" autocomplete="username" required/>
					<label class="label" for="password">Password</label>
					<input class="input w-full" id="password" type="password" name="password" autocomplete="current-password" required/>
					<button class="btn btn-primary" type="submit">Sign in</button>
				</div>
			</form>
		</div>
	}
}
