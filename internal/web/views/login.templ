package views

import (
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/alert"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/card"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/input"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/label"
)

templ LoginPage(errorMessage string) {
	@Layout("Sign in", false, "") {
		<div class="login-layout space-y-6">
			<div class="space-y-2 text-center">
				<p class="eyebrow">Welcome back</p>
				<h1>Sign in to your workspace</h1>
				<p class="text-muted-foreground">Manage campaigns and email operations securely.</p>
			</div>
			if errorMessage != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					{ errorMessage }
				}
			}
			<form method="post" action="/login" class="cn-card border border-border bg-card shadow-sm">
				@card.Content(card.ContentProps{Class: "gap-4"}) {
					@label.Label(label.Props{For: "email"}) {
						Email
					}
					@input.Input(input.Props{ID: "email", Type: "email", Name: "email", Required: true, Attributes: templ.Attributes{"autocomplete": "username"}})
					@label.Label(label.Props{For: "password"}) {
						Password
					}
					@input.Input(input.Props{ID: "password", Type: "password", Name: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Sign in
					}
				}
			</form>
		</div>
	}
}
