package views

templ Home() {
	@Layout("Bachtel Email Automation", true, "overview") {
		<div class="page-header">
			<div><p class="eyebrow">Your workspace</p><h1>Email operations, organized.</h1><p class="page-description">Prepare personalized campaigns, review your recipients and manage every submission in one place.</p></div>
			<a class="btn btn-primary" href="/campaigns/new">New campaign <span aria-hidden="true">+</span></a>
		</div>
		<section class="overview-hero" aria-labelledby="start-heading">
			<div><p class="eyebrow">From template to submission</p><h2 id="start-heading">Ready for your next campaign?</h2><p>Open a campaign to manage its template, upload a recipient workbook or continue an existing email task.</p><a class="btn btn-primary" href="/campaigns">Open campaigns <span aria-hidden="true">→</span></a></div>
			<div class="hero-note"><span class="hero-note-mark" aria-hidden="true">✓</span><h3>Review before you send</h3><p>Preview personalized content, send a formatting test and approve the revision before starting candidate emails.</p></div>
		</section>
		<section aria-labelledby="workflow-heading" class="space-y-4">
			<div><p class="eyebrow">How it works</p><h2 id="workflow-heading" class="section-heading">A clear path for every email</h2></div>
			<ol class="workflow-steps">
				<li><span class="step-number">01</span><h3>Prepare a campaign</h3><p>Add the subject and Word template. Map worksheet columns to your email variables and recipient address.</p></li>
				<li><span class="step-number">02</span><h3>Review and approve</h3><p>Upload an Excel workbook, resolve exclusions and check the preview. Receive a test email and approve its formatting.</p></li>
				<li><span class="step-number">03</span><h3>Send and track</h3><p>Start or schedule eligible recipients. Follow progress, review uncertain outcomes and download the results.</p></li>
			</ol>
		</section>
		<div class="workflow-grid">
			<section class="card" aria-labelledby="connection-heading"><div class="card-body"><p class="eyebrow">Microsoft 365</p><h2 id="connection-heading" class="card-title">Connect your sender</h2><p class="section-description">Manage the HR mailbox connection used for diagnostic tests and candidate submissions.</p><div class="card-actions"><a class="btn btn-outline" href="/connection">Manage mailbox <span aria-hidden="true">→</span></a></div></div></section>
			<section class="card" aria-labelledby="database-heading"><div class="card-body"><p class="eyebrow">Workspace health</p><h2 id="database-heading" class="card-title">Database status</h2><p class="section-description">Check that this workspace can reach its database.</p><div id="database-status" role="status" aria-live="polite"><p class="text-sm text-base-content/60">No check run yet.</p></div><div class="card-actions"><a class="btn btn-outline" href="/status" hx-get="/status" hx-target="#database-status" hx-swap="innerHTML" hx-disabled-elt="this">Check database</a></div></div></section>
		</div>
	}
}

templ DatabaseStatus(checkedAt string) {
	<div class="alert alert-success"><span>Database connected. Checked at <time datetime={ checkedAt }>{ checkedAt }</time>.</span></div>
}
