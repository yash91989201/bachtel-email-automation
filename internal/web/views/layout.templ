package views

import "github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"

templ Layout(title string, signedIn bool, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false,"includeIndicatorStyles":false}'/>
			<title>{ title } · Bachtel</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/alpine.min.js"></script>
		</head>
		<body class="app-body style-luma">
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="app-header">
				<a class="brand" href="/" aria-label="Bachtel home"><span class="brand-mark" aria-hidden="true">b.</span><span>Bachtel<span class="brand-caption">Email workspace</span></span></a>
				if signedIn {
					<nav class="app-nav" aria-label="Main navigation">
						@navLink("/", "Overview", active == "overview")
						@navLink("/campaigns", "Campaigns", active == "campaigns")
						@navLink("/connection", "Mailbox", active == "mailbox")
					</nav>
					<form method="post" action="/logout" class="signout-form">
						@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Type: button.TypeSubmit}) {
							Sign out <span aria-hidden="true">↗</span>
						}
					</form>
				} else {
					<span class="operator-label">Operator workspace</span>
				}
			</header>
			<main id="main-content" class="app-main" tabindex="-1">
				{ children... }
			</main>
			<footer class="app-footer"><span>Bachtel Corporation</span><span>Email operations workspace</span></footer>
		</body>
	</html>
}

templ navLink(url string, label string, current bool) {
	if current {
		<a href={ templ.SafeURL(url) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(url) }>{ label }</a>
	}
}
