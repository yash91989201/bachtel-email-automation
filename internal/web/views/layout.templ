package views

templ Layout(title string, signedIn bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false,"includeIndicatorStyles":false}'/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/alpine.min.js"></script>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			<header class="border-b border-base-300 bg-base-100">
				<div class="navbar mx-auto max-w-4xl px-6">
					<a class="text-lg font-semibold" href="/">Bachtel</a>
					<span class="badge badge-outline ml-3">Email automation</span>
					if signedIn {
						<nav class="ml-auto flex items-center gap-4">
							<a class="link" href="/">Dashboard</a>
							<a class="link" href="/campaigns">Campaigns</a>
							<a class="link" href="/connection">Connection</a>
							<form method="post" action="/logout">
								<button class="btn btn-sm btn-outline" type="submit">Sign out</button>
							</form>
						</nav>
					}
				</div>
			</header>
			<main class="mx-auto max-w-4xl space-y-6 px-6 py-12">
				{ children... }
			</main>
		</body>
	</html>
}
