package views

import (
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui"
	"github.com/yash91989201/bachtel-email-automation/internal/web/ui/button"
)

templ Layout(title string, signedIn bool, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false,"includeIndicatorStyles":false}'/>
			<title>{ title } · Bachtel</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/ai-setup.js"></script>
			<script defer src="/static/alpine.min.js"></script>
			@ui.Scripts()
			<script defer src="/static/workspace.js"></script>
		</head>
		<body class="min-h-screen bg-background text-foreground text-[.9375rem] leading-[1.6] style-luma">
			<a class="absolute left-4 -top-25 focus:top-2 bg-card px-4 py-2 z-100" href="#main-content">Skip to content</a>
			<header class="flex items-center gap-12 bg-card border-b border-border px-[max(2rem,calc((100vw-1240px)/2))] min-h-22 max-[760px]:px-5 max-[760px]:pt-4 max-[760px]:flex-wrap max-[760px]:gap-4">
				<a class="flex items-center gap-3 font-[750] text-[1.3rem] tracking-[-.04em] leading-tight max-[760px]:text-[1.1rem]" href="/" aria-label="Bachtel home"><span class="grid place-items-center w-10.5 h-10.5 bg-primary text-primary-foreground rounded-[12px] text-[1.65rem]" aria-hidden="true">b.</span><span>Bachtel<span class="block text-muted-foreground text-[.65rem] font-[550] tracking-[.07em] uppercase mt-1">Email workspace</span></span></a>
				if signedIn {
					<nav class="flex items-center gap-2 self-stretch [&_a[aria-current]]:underline [&_a[aria-current]]:underline-offset-[3px]! [&_a[aria-current]]:decoration-2 max-[760px]:order-3 max-[760px]:w-full max-[760px]:border-t max-[760px]:border-muted max-[760px]:py-[.65rem] max-[760px]:justify-between max-[760px]:gap-1 max-[760px]:[&_a]:flex-1 max-[760px]:[&_a]:text-center max-[760px]:[&_a]:p-2" aria-label="Main navigation">
						@button.Button(button.Props{Variant: button.VariantLink, Href: "/", Attributes: ariaCurrent(active == "overview")}) {
							Overview
						}
						@button.Button(button.Props{Variant: button.VariantLink, Href: "/campaigns", Attributes: ariaCurrent(active == "campaigns")}) {
							Campaigns
						}
						@button.Button(button.Props{Variant: button.VariantLink, Href: "/account", Attributes: ariaCurrent(active == "account")}) {
							Account
						}
					</nav>
					<form method="post" action="/logout" class="ml-auto">
						@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Type: button.TypeSubmit}) {
							Sign out <span aria-hidden="true">↗</span>
						}
					</form>
				} else {
					<span class="ml-auto text-muted-foreground text-[.8rem]">Operator workspace</span>
				}
			</header>
			<main id="main-content" tabindex="-1" class="max-w-310 mx-auto px-8 pt-10 pb-16 min-h-[calc(100vh-160px)] [&>*+*]:mt-6 *:min-w-0 [&_.cn-card]:py-0! [&_.cn-card]:overflow-visible! max-[760px]:px-4.5 max-[760px]:pt-7 max-[760px]:pb-11">
				{ children... }
			</main>
			<footer class="max-w-294 mx-auto py-5 border-t border-border text-muted-foreground text-xs flex justify-between gap-4 max-[760px]:mx-4.5 max-[760px]:flex-wrap"><span>Bachtel Corporation</span><span>Email operations workspace</span></footer>
		</body>
	</html>
}

func ariaCurrent(current bool) templ.Attributes {
	if current {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}
