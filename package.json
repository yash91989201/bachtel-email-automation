{
  "name": "bachtel-email-automation-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:tailwind": "node scripts/lint-tailwind.mjs",
    "fix:tailwind": "node scripts/lint-tailwind.mjs --fix",
    "test:tailwind": "node --test scripts/lint-tailwind.test.mjs",
    "build": "node scripts/copy-assets.mjs && npm run build:css",
    "build:css": "tailwindcss -i web/css/app.css -o internal/web/static/app.css --minify",
    "watch:css": "tailwindcss -i web/css/app.css -o internal/web/static/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/language-server": "0.16.0",
    "alpinejs": "3.17.4",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.3",
    "vscode-jsonrpc": "8.2.0"
  }
}
