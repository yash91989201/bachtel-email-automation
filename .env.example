# Docker Compose interpolation and local `make dev` — compose.yaml maps these
# into the container, and make dev sources this file into the server process.
# A plain `go run` uses the process environment only.
# Copy to .env. Placeholder values only; never put real secrets here.

# Published host and port for the Compose port mapping.
APP_HOST=127.0.0.1
APP_PORT=8090

# Public origin of this deployment, no trailing slash. Drives cookie security,
# trusted-origin checks, and the default Microsoft callback URL
# (APP_ORIGIN + /connection/callback). Local Compose access is plain http on
# loopback; a server deployment must use its https origin here.
APP_ORIGIN=http://127.0.0.1:8090
# APP_ORIGIN=https://mail.example.com

# SECRET. Base64 encoding of exactly 32 random bytes; encrypts stored
# Microsoft credentials at rest. Generate with: openssl rand -base64 32
# Back up separately from the database: losing it leaves the ciphertext
# intact but requires reconnecting the mailbox. It is NOT PocketBase's
# --encryptionEnv key and NOT the Microsoft client secret.
APP_ENCRYPTION_KEY=

# Microsoft Entra tenant (directory) id.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) id from the Entra app registration.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# SECRET. Client secret from the Entra app registration.
MS_CLIENT_SECRET=

# Redirect URI sent to Microsoft. Defaults to APP_ORIGIN + /connection/callback
# when empty. Must exactly match the URI registered on the app registration,
# including scheme, host, port and path.
MS_REDIRECT_URL=

# Mailbox allowed to connect. Defaults to hr@bachtelcorporation.com.
MS_SENDER_ADDRESS=hr@bachtelcorporation.com

# Advanced overrides for simulated authorization/Graph servers. Leave unset
# in production; empty values fall back to the public Microsoft endpoints.
# MS_AUTHORITY_URL=
# MS_GRAPH_BASE_URL=

# Task workbook intake limits, in bytes. Defaults shown; raising
# INTAKE_MAX_UPLOAD_BYTES above the supported ceiling is a startup error.
# INTAKE_MAX_UPLOAD_BYTES=10485760
# INTAKE_UNZIP_SIZE_LIMIT=67108864
# INTAKE_UNZIP_XML_SIZE_LIMIT=16777216
